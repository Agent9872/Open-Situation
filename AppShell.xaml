<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Lock.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:Lock.Pages"
    xmlns:admin="clr-namespace:Lock.Pages.Admin"
    xmlns:profile="clr-namespace:Lock.Pages.Profile"
    xmlns:post="clr-namespace:Lock.Pages.Post"
    xmlns:chat="clr-namespace:Lock.Pages.Chat"
    Shell.FlyoutBehavior="Flyout"
    Title="OS"
    Shell.FlyoutHeaderBehavior="Fixed"
    Shell.FlyoutWidth="300">

    <!-- ALL SHELL PAGES — visibility is now controlled by custom flyout below -->
    <FlyoutItem x:Name="LoginMenuItem"    Title="Sign In"  Route="login"         FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate pages:LoginPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="RegisterMenuItem" Title="Register" Route="register"      FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate pages:RegisterPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="HomeMenuItem"     Title="Home"     Route="post"          FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate post:PostPage}" />
    </FlyoutItem>
    <FlyoutItem x:Name="ChatMenuItem"     Title="Chat"     Route="conversations" FlyoutItemIsVisible="False">
        <ShellContent ContentTemplate="{DataTemplate chat:ConversationsPage}" />
    </FlyoutItem>

    <!-- FULLY CUSTOM FLYOUT — we own every pixel, no Shell rendering bugs -->
    <Shell.FlyoutContent>
        <ScrollView BackgroundColor="#0A0A1A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Header -->
                    <RowDefinition Height="Auto" />
                    <!-- Menu items -->
                    <RowDefinition Height="*"    />
                    <!-- Spacer -->
                    <RowDefinition Height="Auto" />
                    <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- ── HEADER ── -->
                <Grid Grid.Row="0" BackgroundColor="#0A0A1A">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2" />
                    </Grid.RowDefinitions>

                    <BoxView Grid.Row="0" Color="#00C9C9" HeightRequest="3" HorizontalOptions="Fill" />

                    <Grid Grid.Row="1" Padding="20,20,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Grid Grid.Column="0" WidthRequest="58" HeightRequest="58" Margin="0,0,14,0">
                            <Border WidthRequest="58" HeightRequest="58"
                                    BackgroundColor="Transparent"
                                    Stroke="#00C9C9" StrokeThickness="2"
                                    StrokeShape="RoundRectangle 29"
                                    HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border WidthRequest="50" HeightRequest="50"
                                    BackgroundColor="#1A1A30"
                                    Stroke="Transparent"
                                    StrokeShape="RoundRectangle 25"
                                    HorizontalOptions="Center" VerticalOptions="Center"
                                    Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProfileHeaderTapped" />
                                </Border.GestureRecognizers>
                                <Grid WidthRequest="50" HeightRequest="50">
                                    <Path x:Name="FlyoutAvatarPlaceholder"
                                          Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"
                                          Fill="#3A3A5A" WidthRequest="26" HeightRequest="26"
                                          Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Image x:Name="FlyoutProfileImage"
                                           Aspect="AspectFill"
                                           HorizontalOptions="Fill" VerticalOptions="Fill"
                                           IsVisible="False" />
                                </Grid>
                            </Border>
                            <Ellipse WidthRequest="12" HeightRequest="12"
                                     Fill="#00E676" Stroke="#0A0A1A" StrokeThickness="2"
                                     HorizontalOptions="End" VerticalOptions="End" Margin="0,0,2,2" />
                        </Grid>

                        <!-- Name + Phone -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnProfileHeaderTapped" />
                            </VerticalStackLayout.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label x:Name="FlyoutUserName" Text="Guest"
                                       FontSize="16" FontAttributes="Bold" TextColor="#F0F0FF"
                                       VerticalOptions="Center" />
                                <Border x:Name="FlyoutVerificationBadge"
                                        BackgroundColor="#00C9C918" Stroke="#00C9C950"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                        Padding="4,2" VerticalOptions="Center" IsVisible="False">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnVerificationBadgeTapped" />
                                    </Border.GestureRecognizers>
                                    <Path Data="m366-126-64-108-122-26 12-126-82-94 82-94-12-126 122-26 64-108 114 48 114-48 64 108 122 26-12 126 82 94-82 94 12 126-122 26-64 108-114-48-114 48Zm12-36 102-42 102 42 58-96 110-24-10-114 74-84-74-84 10-114-110-24-58-96-102 42-102-42-58 96-110 24 10 114-74 84 74 84-10 114-110 24-58 96Zm102-318Zm-42 106 190-190-20-20-170 170-86-86-20 20 106 106Z"
                                          Fill="#00C9C9" WidthRequest="12" HeightRequest="12"
                                          Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </HorizontalStackLayout>
                            <Label x:Name="FlyoutUserPhone" Text="Not signed in"
                                   FontSize="11" TextColor="#6B7280" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Teal divider -->
                    <Grid Grid.Row="2" Padding="20,0" HeightRequest="2">
                        <BoxView Color="#1A1A30" HeightRequest="1" HorizontalOptions="Fill" VerticalOptions="Center" />
                        <BoxView Color="#00C9C9" WidthRequest="36" HeightRequest="2"
                                 HorizontalOptions="Start" VerticalOptions="Center" CornerRadius="1" />
                    </Grid>
                </Grid>

                <!-- ── MENU ITEMS ── -->
                <VerticalStackLayout Grid.Row="1" Padding="0,8,0,0">

                    <!-- Sign In (guests only) -->
                    <Grid x:Name="MenuSignIn" HeightRequest="48" Padding="16,0"
                          BackgroundColor="Transparent" IsVisible="True">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginMenuTapped" />
                        </Grid.GestureRecognizers>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M234-276q-27 0-46.5-19.5T168-342v-444q0-27 19.5-46.5T234-852h252v72H234v444h252v72H234Zm402-168-51-51 75-75H438v-72h222l-75-75 51-51 162 162-162 162Z"
                              Fill="#4A9EFF" WidthRequest="20" HeightRequest="20"
                              Aspect="Uniform" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Sign In"
                               TextColor="#4A9EFF" FontSize="15" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Register (guests only) -->
                    <Grid x:Name="MenuRegister" HeightRequest="48" Padding="16,0"
                          BackgroundColor="Transparent" IsVisible="True">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterMenuTapped" />
                        </Grid.GestureRecognizers>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M720-400v-120H600v-80h120v-120h80v120h120v80H800v120h-80Zm-360-80q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM40-160v-112q0-34 17.5-62.5T104-378q62-31 126-46.5T360-440q66 0 130 15.5T616-378q29 15 46.5 43.5T680-272v112H40Zm80-80h480v-32q0-11-5.5-20T580-306q-54-27-109-40.5T360-360q-56 0-111 13.5T140-306q-9 5-14.5 14t-5.5 20v32Zm240-320q33 0 56.5-23.5T440-640q0-33-23.5-56.5T360-720q-33 0-56.5 23.5T280-640q0 33 23.5 56.5T360-560Zm0-80Zm0 400Z"
                              Fill="#4A9EFF" WidthRequest="20" HeightRequest="20"
                              Aspect="Uniform" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Register"
                               TextColor="#4A9EFF" FontSize="15" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Home (logged-in only) -->
                    <Grid x:Name="MenuHome" HeightRequest="48" Padding="16,0"
                          BackgroundColor="Transparent" IsVisible="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnHomeMenuTapped" />
                        </Grid.GestureRecognizers>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M240-200h156v-234h168v234h156v-360L480-742 240-560v360Zm-80 80v-480l320-242 320 242v480H544v-234H416v234H160Zm320-350Z"
                              Fill="#00C9C9" WidthRequest="20" HeightRequest="20"
                              Aspect="Uniform" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Home"
                               TextColor="#00C9C9" FontSize="15" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Chat (logged-in only) -->
                    <Grid x:Name="MenuChat" HeightRequest="48" Padding="16,0"
                          BackgroundColor="Transparent" IsVisible="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConversationsTapped" />
                        </Grid.GestureRecognizers>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0"
                              Data="M880-80 720-240H160q-33 0-56.5-23.5T80-320v-480q0-33 23.5-56.5T160-880h640q33 0 56.5 23.5T880-800v720ZM160-320h594l46 46v-526H160v480Zm0 0v-480 480Z"
                              Fill="#00C9C9" WidthRequest="20" HeightRequest="20"
                              Aspect="Uniform" VerticalOptions="Center" Margin="0,0,12,0" />
                        <Label Grid.Column="1" Text="Chat"
                               TextColor="#00C9C9" FontSize="15" FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>

                </VerticalStackLayout>

                <!-- ── SPACER ── -->
                <BoxView Grid.Row="2" Color="Transparent" />

                <!-- ── FOOTER ── -->
                <Grid Grid.Row="3" BackgroundColor="#0A0A1A" Padding="16,10,16,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <BoxView Grid.Row="0" Color="#1E1E35" HeightRequest="1"
                             HorizontalOptions="Fill" Margin="0,0,0,12" />

                    <!-- Admin Panel -->
                    <Border x:Name="AdminButton" Grid.Row="1"
                            BackgroundColor="#0D2845" Stroke="#1A4A80"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12"
                            IsVisible="False" Padding="0" Margin="0,0,0,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAdminButtonClicked" />
                        </Border.GestureRecognizers>
                        <Grid HeightRequest="48" Padding="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"
                                  Fill="#4A9EFF" WidthRequest="20" HeightRequest="20"
                                  Aspect="Uniform" VerticalOptions="Center" Margin="0,0,12,0" />
                            <Label Grid.Column="1" Text="Admin Panel"
                                   TextColor="#4A9EFF" FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Sign Out -->
                    <Border x:Name="SignOutFooterButton" Grid.Row="2"
                            BackgroundColor="#1A0D0D" Stroke="#3A1515"
                            StrokeThickness="1" StrokeShape="RoundRectangle 12"
                            IsVisible="False" Padding="0" Margin="0,0,0,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSignOutTapped" />
                        </Border.GestureRecognizers>
                        <Grid HeightRequest="48" Padding="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0"
                                  Data="M232-172q-26 0-43-17t-17-43v-496q0-26 17-43t43-17h249v28H232q-12 0-22 10t-10 22v496q0 12 10 22t22 10h249v28H232Zm432-184-20-20 90-90H370v-28h364l-90-90 20-20 124 124-124 124Z"
                                  Fill="#FF6B6B" WidthRequest="20" HeightRequest="20"
                                  Aspect="Uniform" VerticalOptions="Center" Margin="0,0,12,0" />
                            <Label Grid.Column="1" Text="Sign Out"
                                   TextColor="#FF6B6B" FontSize="15" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <!-- Theme Toggle -->
                    <Border Grid.Row="3" BackgroundColor="#0D0D1E" Stroke="#1A1A2E"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14" Padding="5">
                        <sf:SfSegmentedControl x:Name="ThemeSegmentedControl"
                                               VerticalOptions="Center" HorizontalOptions="Fill"
                                               SelectionChanged="SfSegmentedControl_SelectionChanged"
                                               SegmentWidth="120" SegmentHeight="34">
                            <sf:SfSegmentedControl.ItemsSource>
                                <x:Array Type="{x:Type sf:SfSegmentItem}">
                                    <sf:SfSegmentItem Text="☀  Light" />
                                    <sf:SfSegmentItem Text="☾  Dark" />
                                </x:Array>
                            </sf:SfSegmentedControl.ItemsSource>
                        </sf:SfSegmentedControl>
                    </Border>
                </Grid>

            </Grid>
        </ScrollView>
    </Shell.FlyoutContent>

</Shell>