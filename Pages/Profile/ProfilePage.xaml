                                </VerticalStackLayout>
                            </VerticalStackLayout>
                            <!-- ========== STATS TAB ========== -->
                            <VerticalStackLayout x:Name="ProfileStatsPanel" IsVisible="False" Spacing="0">
                                <Border Padding="16,14" Margin="20,0,20,12"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161614}"
                        Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#252320}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="👁️" FontSize="16" />
                                            <Label Text="PROFILE VIEWS" FontSize="9" CharacterSpacing="2" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#888880, Dark=#666660}" />
                                        </HorizontalStackLayout>
                                        <Label x:Name="TotalProfileViewsLabel" Text="0"
                               FontSize="28" FontAttributes="Bold" TextColor="#008080" />
                                        <Label Text="total views" FontSize="11"
                               TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#555550}" />
                                        <Label Text="Recent viewers" FontSize="11" FontAttributes="Bold"
                               Margin="0,8,0,0"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                        <ScrollView Orientation="Horizontal" HeightRequest="50">
                                            <HorizontalStackLayout x:Name="RecentViewersLayout" Spacing="8" />
                                        </ScrollView>
                                    </VerticalStackLayout>
                                </Border>

                                <HorizontalStackLayout Spacing="6" Padding="20,24,20,16">
                                    <BoxView WidthRequest="3" HeightRequest="18" Color="#008080"
                             VerticalOptions="Center" CornerRadius="2" />
                                    <Label Text="PROFILE STATS" FontSize="10" CharacterSpacing="2.5" FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                </HorizontalStackLayout>

                                <Grid Padding="20,0,20,16" ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="12">
                                    <Border Grid.Row="0" Grid.Column="0" Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161614}"
                            Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#252320}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                        <VerticalStackLayout Spacing="4">
                                            <Label x:Name="ProfileViewsCount" Text="0"
                                   FontSize="28" FontAttributes="Bold" TextColor="#008080" />
                                            <Label Text="PROFILE VIEWS" FontSize="8" CharacterSpacing="1.5"
                                   TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="0" Grid.Column="1" Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161614}"
                            Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#252320}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                        <VerticalStackLayout Spacing="4">
                                            <Label x:Name="MatchesCount" Text="0"
                                   FontSize="28" FontAttributes="Bold" TextColor="#008080" />
                                            <Label Text="MATCHES" FontSize="8" CharacterSpacing="1.5"
                                   TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="0" Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161614}"
                            Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#252320}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                        <VerticalStackLayout Spacing="4">
                                            <Label x:Name="ResponseRateLabel" Text="0%"
                                   FontSize="28" FontAttributes="Bold" TextColor="#008080" />
                                            <Label Text="RESPONSE RATE" FontSize="8" CharacterSpacing="1.5"
                                   TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                        </VerticalStackLayout>
                                    </Border>
                                    <Border Grid.Row="1" Grid.Column="1" Padding="16,14"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161614}"
                            Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#252320}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                        <VerticalStackLayout Spacing="4">
                                            <Label x:Name="JoinDateLabel" Text="2024"
                                   FontSize="24" FontAttributes="Bold" TextColor="#008080" />
                                            <Label Text="MEMBER SINCE" FontSize="8" CharacterSpacing="1.5"
                                   TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                        </VerticalStackLayout>
                                    </Border>
                                </Grid>

                                <Border Padding="16,14" Margin="20,0,20,32"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161614}"
                        Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#252320}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="MOOD HISTORY" FontSize="9" CharacterSpacing="2" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                        <Label x:Name="MoodHistoryLabel" Text="No mood changes recorded yet"
                               FontSize="13" TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>

                            <!-- ========== GALLERY TAB ========== -->
                            <VerticalStackLayout x:Name="ProfileMediaPanel" IsVisible="False" Spacing="0">
                                <HorizontalStackLayout Spacing="6" Padding="20,24,20,4">
                                    <BoxView WidthRequest="3" HeightRequest="18" Color="#008080"
                             VerticalOptions="Center" CornerRadius="2" />
                                    <Label Text="GALLERY" FontSize="10" CharacterSpacing="2.5" FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                </HorizontalStackLayout>

                                <Label Text="Add 3–6 photos · First photo is your primary"
                       FontSize="11" Margin="20,0,20,14"
                       TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#555550}" />

                                <Border Padding="4" Margin="20,0,20,14"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161614}"
                        Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#252320}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                    <Picker x:Name="MediaCategoryPicker" Title="Filter by category" FontSize="13"
                            TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}"
                            TitleColor="{AppThemeBinding Light=#C0BCB5, Dark=#4A4844}"
                            BackgroundColor="Transparent"
                            SelectedIndexChanged="MediaCategoryPicker_SelectedIndexChanged" />
                                </Border>

                                <ScrollView Orientation="Horizontal" HeightRequest="140"
                            HorizontalScrollBarVisibility="Never"
                            VerticalScrollBarVisibility="Never"
                            Margin="20,0,0,0">
                                    <HorizontalStackLayout Spacing="10" x:Name="PhotosLayout" Padding="0,0,20,0" />
                                </ScrollView>

                                <Label x:Name="NoMediaLabel" Text="No photos in this category yet."
                       FontSize="12" Margin="20,12,20,32"
                       TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#555550}"
                       IsVisible="False" />
                            </VerticalStackLayout>

                            <!-- ========== FRIENDS SAY TAB ========== -->
                            <VerticalStackLayout x:Name="ProfileEndorsementsPanel" IsVisible="False" Spacing="0">
                                <HorizontalStackLayout Spacing="6" Padding="20,24,20,16">
                                    <BoxView WidthRequest="3" HeightRequest="18" Color="#008080"
                 VerticalOptions="Center" CornerRadius="2" />
                                    <Label Text="FRIENDS SAY" FontSize="10" CharacterSpacing="2.5" FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                </HorizontalStackLayout>

                                <Label Text="What your friends say about you"
           FontSize="11" Margin="20,0,20,12"
           TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#555550}" />

                                <!-- ADD ENDORSEMENT BUTTON - ONLY FOR PROFILE OWNER -->
                                <Border x:Name="AddEndorsementButton"
            Padding="16,12" Margin="20,0,20,16"
            BackgroundColor="#008080" StrokeThickness="0" StrokeShape="RoundRectangle 14"
            HorizontalOptions="Fill"
            IsVisible="{Binding IsOwner, Source={x:Reference ProfilePageRoot}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="AddEndorsementButton_Clicked" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                                        <Label Text="+ Ask a friend to endorse you" FontSize="14" FontAttributes="Bold"
                   TextColor="White" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- PENDING REQUESTS SECTION - ONLY FOR PROFILE OWNER -->
                                <VerticalStackLayout x:Name="PendingEndorsementsSection" IsVisible="False">
                                    <HorizontalStackLayout Spacing="6" Margin="20,0,20,8">
                                        <Label Text="⏳" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="PENDING REQUESTS" FontSize="10" FontAttributes="Bold"
                   TextColor="#F59E0B" VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <CollectionView x:Name="PendingEndorsementsCollectionView"
                        ItemsLayout="VerticalList"
                        SelectionMode="None"
                        HeightRequest="300">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="16,14" Margin="20,0,20,12"
                            BackgroundColor="{AppThemeBinding Light=#FFFBF0, Dark=#2A2418}"
                            Stroke="#F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                                    <VerticalStackLayout Spacing="8">
                                                        <!-- Header with Profile Image and Name -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <HorizontalStackLayout Grid.Column="0" Spacing="12">
                                                                <!-- Profile Image Circle -->
                                                                <Border WidthRequest="44" HeightRequest="44"
                                            BackgroundColor="{AppThemeBinding Light=#F0EDE8, Dark=#1E1C1A}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 22"
                                            Padding="0">
                                                                    <Grid>
                                                                        <Image Source="{Binding FriendProfileImage}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="44" WidthRequest="44">
                                                                            <Image.Clip>
                                                                                <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                                                                            </Image.Clip>
                                                                        </Image>
                                                                        <Label Text="{Binding FriendName, StringFormat='{0[0]}'}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#F59E0B"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   IsVisible="{Binding FriendProfileImage, Converter={StaticResource IsNullOrEmpty}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <VerticalStackLayout>
                                                                    <Label Text="{Binding FriendName}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}" />
                                                                    <Label Text="Awaiting response..."
                                               FontSize="10"
                                               TextColor="#F59E0B" />
                                                                </VerticalStackLayout>
                                                            </HorizontalStackLayout>
                                                            <Label Grid.Column="2" Text="⏳" FontSize="16" TextColor="#F59E0B"
                                       VerticalOptions="Center" />
                                                        </Grid>

                                                        <!-- Testimonial Preview -->
                                                        <Label Text="{Binding Testimonial}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2" />

                                                        <!-- Rating -->
                                                        <Label Text="{Binding Rating}"
                                   FontSize="11"
                                   TextColor="#888880" />

                                                        <!-- Timer / Time Sent -->
                                                        <HorizontalStackLayout Spacing="4" Margin="0,4,0,0">
                                                            <Label Text="🕐" FontSize="10" TextColor="#888880" VerticalOptions="Center" />
                                                            <Label Text="{Binding TimeAgo}"
                                       FontSize="10"
                                       TextColor="#888880"
                                       VerticalOptions="Center" />
                                                            <Label Text="·" FontSize="10" TextColor="#888880" VerticalOptions="Center" />
                                                            <Label Text="{Binding DisplayDate}"
                                       FontSize="10"
                                       TextColor="#888880"
                                       VerticalOptions="Center" />
                                                        </HorizontalStackLayout>

                                                        <!-- Action Buttons -->
                                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="End" Margin="0,4,0,0">
                                                            <Border Padding="10,6" BackgroundColor="Transparent"
                                        Stroke="#F59E0B" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="ResendEndorsementRequest_Clicked"
                                                              CommandParameter="{Binding .}" />
                                                                </Border.GestureRecognizers>
                                                                <Label Text="Resend" FontSize="11" FontAttributes="Bold"
                                           TextColor="#F59E0B" />
                                                            </Border>
                                                            <Border Padding="10,6" BackgroundColor="Transparent"
                                        Stroke="#FF4444" StrokeThickness="1" StrokeShape="RoundRectangle 20">
                                                                <Border.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="CancelEndorsementRequest_Clicked"
                                                              CommandParameter="{Binding .}" />
                                                                </Border.GestureRecognizers>
                                                                <Label Text="Cancel" FontSize="11" FontAttributes="Bold"
                                           TextColor="#FF4444" />
                                                            </Border>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                        <CollectionView.EmptyView>
                                            <Label Text="No pending endorsement requests"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#888880, Dark=#666660}"
                       HorizontalOptions="Center"
                       Margin="0,20,0,20" />
                                        </CollectionView.EmptyView>
                                    </CollectionView>
                                </VerticalStackLayout>

                                <!-- Divider between pending and accepted -->
                                <BoxView x:Name="EndorsementDivider"
             HeightRequest="1" 
             Margin="20,12,20,12"
             Color="{AppThemeBinding Light=#EAE6E0, Dark=#333330}"
             IsVisible="False" />

                                <!-- ACCEPTED ENDORSEMENTS SECTION - VISIBLE TO EVERYONE -->
                                <VerticalStackLayout x:Name="AcceptedEndorsementsSection">
                                    <HorizontalStackLayout Spacing="6" Margin="20,0,20,8">
                                        <Label Text="✓" FontSize="12" TextColor="#10B981" VerticalOptions="Center" />
                                        <Label Text="ENDORSEMENTS" FontSize="10" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#888880, Dark=#008080}"
                   VerticalOptions="Center" />
                                        <Label x:Name="AcceptedEndorsementsCountLabel" Text="(0)" FontSize="10"
                   TextColor="{AppThemeBinding Light=#888880, Dark=#666660}"
                   VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <CollectionView x:Name="EndorsementsCollectionView"
                        ItemsLayout="VerticalList"
                        SelectionMode="None"
                        HeightRequest="500">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="16,14" Margin="20,0,20,12"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#161614}"
                            Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#252320}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 14">
                                                    <VerticalStackLayout Spacing="8">
                                                        <!-- Header with Profile Image and Name -->
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <HorizontalStackLayout Grid.Column="0" Spacing="12">
                                                                <!-- Profile Image Circle -->
                                                                <Border WidthRequest="44" HeightRequest="44"
                                            BackgroundColor="{AppThemeBinding Light=#F0EDE8, Dark=#1E1C1A}"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 22"
                                            Padding="0">
                                                                    <Grid>
                                                                        <Image Source="{Binding EndorserProfileImage}"
                                                   Aspect="AspectFill"
                                                   HeightRequest="44" WidthRequest="44">
                                                                            <Image.Clip>
                                                                                <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                                                                            </Image.Clip>
                                                                        </Image>
                                                                        <Label Text="{Binding EndorserName, StringFormat='{0[0]}'}"
                                                   FontSize="16" FontAttributes="Bold"
                                                   TextColor="#008080"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   IsVisible="{Binding EndorserProfileImage, Converter={StaticResource IsNullOrEmpty}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <VerticalStackLayout>
                                                                    <Label Text="{Binding EndorserName}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}" />
                                                                    <Label Text="Friend"
                                               FontSize="10"
                                               TextColor="{AppThemeBinding Light=#888880, Dark=#666660}" />
                                                                </VerticalStackLayout>
                                                            </HorizontalStackLayout>
                                                            <Label Grid.Column="2" Text="✓" FontSize="14" TextColor="#10B981"
                                       VerticalOptions="Center" />
                                                        </Grid>

                                                        <!-- Rating Stars -->
                                                        <Label Text="{Binding RatingStars}"
                                   FontSize="14"
                                   TextColor="#FFD700"
                                   Margin="0,4,0,0" />

                                                        <!-- Testimonial Text -->
                                                        <Label Text="{Binding Testimonial}"
                                   FontSize="13" FontFamily="Georgia"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#DDDDDD}"
                                   LineBreakMode="WordWrap" />

                                                        <!-- Date -->
                                                        <Label Text="{Binding CreatedAt, StringFormat='{0:MMMM dd, yyyy}'}"
                                   FontSize="10"
                                   TextColor="{AppThemeBinding Light=#AAAAAA, Dark=#555550}"
                                   HorizontalOptions="End" />

                                                        <!-- Delete Button (Owner Only) -->
                                                        <Border Padding="10,5" BackgroundColor="Transparent"
                                    Stroke="#FF4444" StrokeThickness="1" StrokeShape="RoundRectangle 20"
                                    HorizontalOptions="End"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:ProfilePage}}, Path=IsOwner}">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="DeleteEndorsementButton_Clicked"
                                                          CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Label Text="Remove" FontSize="11" FontAttributes="Bold"
                                       TextColor="#FF4444" />
                                                        </Border>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                        <CollectionView.EmptyView>
                                            <VerticalStackLayout Padding="40" Spacing="10" HorizontalOptions="Center">
                                                <Label Text="✨" FontSize="40" HorizontalOptions="Center" />
                                                <Label Text="No endorsements yet"
                           FontSize="14" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#888880}"
                           HorizontalOptions="Center" />
                                                <Label Text="Ask a friend to vouch for you"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#999999, Dark=#666660}"
                           HorizontalOptions="Center" />
                                            </VerticalStackLayout>
                                        </CollectionView.EmptyView>
                                    </CollectionView>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollView>

        <!-- Bottom Navigation Bar -->
        <Border Grid.Row="1" x:Name="BottomNavBar" Padding="0"
                StrokeThickness="0" StrokeShape="RoundRectangle 0"
                HorizontalOptions="Fill" BackgroundColor="Transparent">
            <Grid HeightRequest="56" ColumnSpacing="0"
                  HorizontalOptions="Fill" BackgroundColor="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" BackgroundColor="Transparent"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHomeTapped" NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                        <Path Data="M240-200h156v-234h168v234h156v-360L480-742 240-560v360Zm-28 28v-402l268-203 268 203v402H536v-234H424v234H212Zm268-299Z"
                              Fill="#5A5A6A" Stroke="#5A5A6A" StrokeThickness="1.2"
                              HeightRequest="20" WidthRequest="20"
                              HorizontalOptions="Center" Aspect="Uniform" />
                        <Label Text="Home" FontSize="9" TextColor="#5A5A6A"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Column="1" BackgroundColor="Transparent"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnChatsTapped" NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                        <Grid WidthRequest="22" HeightRequest="22" HorizontalOptions="Center">
                            <Path Data="M266-426h268v-28H266v28Zm0-120h428v-28H266v28Zm0-120h428v-28H266v28ZM132-180v-588q0-26 17-43t43-17h576q26 0 43 17t17 43v416q0 26-17 43t-43 17H244L132-180Zm100-140h536q12 0 22-10t10-22v-416q0-12-10-22t-22-10H192q-12 0-22 10t-10 22v520l72-72Zm-72 0v-480 480Z"
                                  Fill="#5A5A6A" Stroke="#5A5A6A" StrokeThickness="1.2"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Aspect="Uniform" />
                            <Border x:Name="ChatBadge" BackgroundColor="#5A5A6A"
                                    StrokeThickness="0" MinimumHeightRequest="16" MinimumWidthRequest="16"
                                    Padding="4,0" HorizontalOptions="End" VerticalOptions="Start"
                                    TranslationX="6" TranslationY="-6" IsVisible="False">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label x:Name="ChatBadgeLabel" Text="0" FontSize="9" FontAttributes="Bold"
                                       TextColor="White" HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" LineBreakMode="NoWrap" />
                            </Border>
                        </Grid>
                        <Label Text="Chat" FontSize="9" TextColor="#5A5A6A"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>

                <Grid Grid.Column="2" BackgroundColor="Transparent"
                      HorizontalOptions="Fill" VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnNotificationsTapped" NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="2">
                        <Grid WidthRequest="22" HeightRequest="22" HorizontalOptions="Center">
                            <Path Data="M215.5-216v-25.5H273V-565q0-76.5 49.61-134.5T447-771v-19.06q0-14.07 9.26-23.5 9.27-9.44 23.5-9.44 14.24 0 23.74 9.44 9.5 9.43 9.5 23.5V-771q75 13.5 124.75 71.5T687.5-565v323.5H745v25.5H215.5ZM480-494Zm-.18 376q-24.32 0-41.57-17.38Q421-152.75 421-177h118q0 24.5-17.43 41.75Q504.15-118 479.82-118ZM298.5-241.5H662V-565q0-75.62-53.29-128.56T479.84-746.5q-75.59 0-128.46 52.94Q298.5-640.62 298.5-565v323.5Z"
                                  Fill="#5A5A6A" Stroke="#5A5A6A" StrokeThickness="1.2"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Aspect="Uniform" />
                            <Border x:Name="NotificationBadge" BackgroundColor="#5A5A6A"
                                    StrokeThickness="0" MinimumHeightRequest="16" MinimumWidthRequest="16"
                                    Padding="4,0" HorizontalOptions="End" VerticalOptions="Start"
                                    TranslationX="6" TranslationY="-6" IsVisible="False">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Label x:Name="NotificationBadgeLabel" Text="0" FontSize="9" FontAttributes="Bold"
                                       TextColor="White" HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center" LineBreakMode="NoWrap" />
                            </Border>
                        </Grid>
                        <Label Text="Alerts" FontSize="9" TextColor="#5A5A6A"
                               HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
    