<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:models="clr-namespace:Lock.Models"
             xmlns:conv="clr-namespace:Lock.Converter.Post"
             xmlns:local="clr-namespace:Lock.Pages.Profile" 
             x:Class="Lock.Pages.Profile.ProfilePage"
             x:Name="ProfilePageRoot"  
             Title="" 
             Shell.NavBarIsVisible="False" 
             BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#0F0F11}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:ListNotEmptyConverter x:Key="ListNotEmptyConverter" />
            <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
            <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <conv:IsNullOrEmptyConverter x:Key="IsNullOrEmpty" />
            
            
            <Color x:Key="AppBackground">#F5F6FA</Color>
            <Color x:Key="CardBackground">#FFFFFF</Color>
            <Color x:Key="Primary">#2563EB</Color>
            <Color x:Key="Accent">#10B981</Color>
            <Color x:Key="Danger">#D23E3E</Color>
            <Color x:Key="Muted">#6B6F76</Color>
            <Color x:Key="Subtle">#9AA0A6</Color>
            <Color x:Key="SoftBorder">#E6E9EE</Color>

            <Color x:Key="DarkCard">#1F1F21</Color>
            <Color x:Key="DarkBorder">#333333</Color>
            <Color x:Key="DarkInput">#111111</Color>
            <Color x:Key="DarkTextPrimary">#F5F5F5</Color>
            <Color x:Key="DarkTextSecondary">#008080</Color>

            <Style x:Key="LabelSmall" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark=#AAAAAA}" />
            </Style>

            <Style x:Key="LabelMedium" TargetType="Label">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#222222, Dark=#F5F5F5}" />
            </Style>

            <Style x:Key="HintLabel" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Subtle}, Dark=#777777}" />
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Muted}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="TabButton" TargetType="Button">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="HeightRequest" Value="34" />
                <Setter Property="MinimumWidthRequest" Value="52" />
                <Setter Property="MaximumWidthRequest" Value="96" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#222222, Dark=#F5F5F5}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#9AA0A6, Dark=#AAAAAA}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#111111}" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#222222, Dark=#008080}" />
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#111111}" />
            </Style>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource DarkCard}}" />
                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SoftBorder}, Dark={StaticResource DarkBorder}}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape">
                    <RoundRectangle CornerRadius="0" />
                </Setter>
                <Setter Property="Padding" Value="14" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#22000000" Offset="0,2" Radius="6" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TagChip" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F2F4F7, Dark=#2A2A2E}" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#333333, Dark=#008080}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HeightRequest" Value="32" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    
    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0" x:Name="MainScrollView" Margin="0"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never">
            <Grid Padding="0" RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="140" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Cover -->
                <Image x:Name="CoverImageOverlay" Grid.Row="0"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill"
                       ZIndex="0" />

                <BoxView Grid.Row="0"
                         BackgroundColor="#00000020"
                         VerticalOptions="End"
                         HeightRequest="56"
                         ZIndex="0" />

                <Border x:Name="CoverEditIcon"
                        Grid.Row="0"
                        BackgroundColor="#FFFFFFFF"
                        Opacity="0.95"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 0"  
                        HeightRequest="28"
                        WidthRequest="28"
                        HorizontalOptions="End"
                        VerticalOptions="Start"
                        Margin="0,8,8,0"
                        ZIndex="400"
                        IsVisible="{Binding IsOwner, Source={RelativeSource AncestorType={x:Type local:ProfilePage}}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ChangeCoverButton_Clicked" NumberOfTapsRequired="1" />
                    </Border.GestureRecognizers>
                    <shapes:Path Data="M3 12 L7 12 L7 4 L17 4 L17 12 L21 12 L21 20 L3 20 Z M7 16 A3 3 0 1 0 13 16 A3 3 0 1 0 7 16 Z"
                                 Stroke="#333"
                                 StrokeThickness="0.9"
                                 StrokeLineJoin="Round"
                                 StrokeLineCap="Round"
                                 HeightRequest="12"
                                 WidthRequest="12"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center" />
                </Border>

                <!-- Profile image area -->
                <Grid Grid.Row="0"
                      HorizontalOptions="Start"
                      VerticalOptions="End"
                      Margin="16,0,0,-40"
                      WidthRequest="88"
                      HeightRequest="88"
                      ZIndex="300">
                    <Image x:Name="ProfileImageOverlay"
                           Aspect="AspectFill"
                           HeightRequest="80"
                           WidthRequest="80"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Image.Clip>
                            <EllipseGeometry Center="40,40" RadiusX="40" RadiusY="40" />
                        </Image.Clip>
                    </Image>

                    <Border x:Name="ProfileEditIconOverlay"
                            BackgroundColor="#FFFFFFFF"
                            Opacity="0.95"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10" 
                            HeightRequest="22"
                            WidthRequest="22"
                            HorizontalOptions="End"
                            VerticalOptions="End"
                            Margin="0,0,0,0"
                            ZIndex="400"
                            IsVisible="{Binding IsOwner, Source={RelativeSource AncestorType={x:Type local:ProfilePage}}}">
                        <shapes:Path Data="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125"
                                     Stroke="#333"
                                     StrokeThickness="0.9"
                                     StrokeLineJoin="Round"
                                     StrokeLineCap="Round"
                                     HeightRequest="10"
                                     WidthRequest="10" />
                    </Border>
                    <Border x:Name="EditImagesButton"
                            HorizontalOptions="End"
                            VerticalOptions="Start"
                            Margin="0,-8,-8,0"
                            Padding="8"
                            BackgroundColor="#FFFFFFFF"
                            Opacity="0.95"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 0" 
                            HeightRequest="28"
                            WidthRequest="28"
                            ZIndex="401"
                            IsVisible="{Binding IsOwner, Source={RelativeSource AncestorType={x:Type local:ProfilePage}}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EditImagesButton_Tapped" NumberOfTapsRequired="1" />
                        </Border.GestureRecognizers>
                        <Label Text="✎" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12" TextColor="#333"/>
                    </Border>
                </Grid>

                <!-- Row 1: Profile Info -->
                <Grid Grid.Row="1"
      Padding="0"
      BackgroundColor="{AppThemeBinding Light=#FAFAF8, Dark=#0E0E0F}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- NAME + DOB -->
                    <Grid Grid.Row="0" Padding="20,44,20,0" ColumnDefinitions="*,Auto">

                        <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto">

                            <!-- Name Label -->
                            <Label Grid.Column="0" x:Name="NameLabel"
            FontFamily="Georgia"
            FontSize="26"
            FontAttributes="Bold"
            CharacterSpacing="0.3"
            VerticalOptions="Center"
            TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}"
            LineBreakMode="TailTruncation" />
                            
                            
                            <!-- Verification Badge - Next to Name (UPDATED) -->
                            <Border x:Name="VerificationBadge"
        Grid.Column="1"
        BackgroundColor="Transparent"
        Stroke="Transparent"
        StrokeThickness="0"
        Padding="0"
        Margin="0"
        VerticalOptions="Center"
        IsVisible="False">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVerificationBadgeTapped" />
                                </Border.GestureRecognizers>

                                <!-- Verified Icon only (no border/background) -->
                                <Path Data="m366-126-64-108-122-26 12-126-82-94 82-94-12-126 122-26 64-108 114 48 114-48 64 108 122 26-12 126 82 94-82 94 12 126-122 26-64 108-114-48-114 48Zm12-36 102-42 102 42 58-96 110-24-10-114 74-84-74-84 10-114-110-24-58-96-102 42-102-42-58 96-110 24 10 114-74 84 74 84-10 114 110 24 58 96Zm102-318Zm-42 106 190-190-20-20-170 170-86-86-20 20 106 106Z"
          Fill="#00B5B5"
          Stroke="#00B5B5"
          StrokeThickness="1.5"
          WidthRequest="16"
          HeightRequest="16"
          Aspect="Uniform"
          HorizontalOptions="Center"
          VerticalOptions="Center" />
                            </Border>
                        </Grid>



                        <!-- DOB Card (unchanged) -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Border WidthRequest="32" HeightRequest="32"
            BackgroundColor="{AppThemeBinding Light=#F0EDE8, Dark=#1E1C1A}"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            Padding="0">
                                <Path Data="M758.5-638v-80h-80v-25.5h80v-80H784v80h80v25.5h-80v80h-25.5ZM162.07-136.5q-11.07 0-18.32-7.93-7.25-7.92-7.25-19.07V-351q0-23.97 16.77-40.73Q170.03-408.5 194-408.5h22v-169q0-23.97 16.77-40.73Q249.53-635 273.5-635H427v-59.5q-16.5-10.5-28-23.69-11.5-13.19-11.5-31.06 0-10.03 4-19.83 4-9.8 11.5-17.42l37-36.5 36.94 36.62q7.56 7.38 11.56 17.2 4 9.83 4 19.89 0 17.91-11.5 31.1-11.5 13.19-28 23.69v59.5h153.5q23.97 0 40.73 16.77Q664-601.47 664-577.5v169h22q23.97 0 40.73 16.77Q743.5-374.97 743.5-351v187.5q0 11.15-8.21 19.07-8.21 7.93-19.29 7.93H162.07Zm79.43-272h397v-169q0-14-9-23t-23-9h-333q-14 0-23 9t-9 23v169ZM162-162h556v-189q0-14-9-23t-23-9H194q-14 0-23 9t-9 23v189Zm79.5-246.5h397-397ZM162-162h556-556Zm504-246.5H214h452Z"
                Fill="{AppThemeBinding Light=#B04040, Dark=#008080}"
                StrokeThickness="0"
                HeightRequest="14"
                WidthRequest="14"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Aspect="Uniform" />
                            </Border>
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="BORN" FontSize="8" CharacterSpacing="1.5"
                HorizontalOptions="Center"
                TextColor="{AppThemeBinding Light=#B04040, Dark=#008080}" />
                                <Label x:Name="DobLabel" Text="—" FontSize="13" FontAttributes="Bold"
                CharacterSpacing="0.5" HorizontalOptions="Center"
                TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Grid>
                    <!-- Age, Gender, Interested In -->
                    <VerticalStackLayout Grid.Row="1" Padding="20,10,20,0" Spacing="10">
                        <HorizontalStackLayout Spacing="6">
                            <!-- Age -->
                            <HorizontalStackLayout Spacing="8">
                                <Border WidthRequest="32" HeightRequest="32"
                        BackgroundColor="{AppThemeBinding Light=#F0EDE8, Dark=#1E1C1A}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                                    <Path Data="M758.5-638v-80h-80v-25.5h80v-80H784v80h80v25.5h-80v80h-25.5ZM162.07-136.5q-11.07 0-18.32-7.93-7.25-7.92-7.25-19.07V-351q0-23.97 16.77-40.73Q170.03-408.5 194-408.5h22v-169q0-23.97 16.77-40.73Q249.53-635 273.5-635H427v-59.5q-16.5-10.5-28-23.69-11.5-13.19-11.5-31.06 0-10.03 4-19.83 4-9.8 11.5-17.42l37-36.5 36.94 36.62q7.56 7.38 11.56 17.2 4 9.83 4 19.89 0 17.91-11.5 31.1-11.5 13.19-28 23.69v59.5h153.5q23.97 0 40.73 16.77Q664-601.47 664-577.5v169h22q23.97 0 40.73 16.77Q743.5-374.97 743.5-351v187.5q0 11.15-8.21 19.07-8.21 7.93-19.29 7.93H162.07Zm79.43-272h397v-169q0-14-9-23t-23-9h-333q-14 0-23 9t-9 23v169ZM162-162h556v-189q0-14-9-23t-23-9H194q-14 0-23 9t-9 23v189Zm79.5-246.5h397-397ZM162-162h556-556Zm504-246.5H214h452Z"
                          Fill="{AppThemeBinding Light=#B04040, Dark=#008080}"
                          StrokeThickness="0"
                          HeightRequest="14"
                          WidthRequest="14"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Aspect="Uniform" />
                                </Border>
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="AGE" FontSize="8" CharacterSpacing="1.5"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#B04040, Dark=#008080}" />
                                    <Label x:Name="AgeLabel" Text="—" FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- Gender -->
                            <HorizontalStackLayout Spacing="8">
                                <Border WidthRequest="32" HeightRequest="32"
                        BackgroundColor="{AppThemeBinding Light=#F0EDE8, Dark=#1E1C1A}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                                    <Path Data="M256.5-110v-271H198v-218.5q0-22 15.25-37.25T250.5-652H352q22 0 37.25 15.25t15.25 37.25V-381H346v271h-89.5Zm.25-601.75Q238.5-730 238.5-756.5t18.25-44.75Q275-819.5 301.5-819.5t44.75 18.25Q364.5-783 364.5-756.5t-18.25 44.75Q328-693.5 301.5-693.5t-44.75-18.25ZM626-110v-211.5h-87.5L610-617q5-16 18-25.5t30.5-9.5q17.5 0 30.75 9.5T707-617l71.5 295.5h-87V-110H626Zm-12.25-601.75Q595.5-730 595.5-756.5t18.25-44.75Q632-819.5 658.5-819.5t44.75 18.25Q721.5-783 721.5-756.5t-18.25 44.75Q685-693.5 658.5-693.5t-44.75-18.25Z"
                          Fill="{AppThemeBinding Light=#888880, Dark=#008080}"
                          StrokeThickness="0"
                          HeightRequest="14"
                          WidthRequest="14"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Aspect="Uniform" />
                                </Border>
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="GENDER" FontSize="8" CharacterSpacing="1.5"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                    <Label x:Name="GenderLabel" Text="—" FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>

                            <!-- Interested In -->
                            <HorizontalStackLayout Spacing="8">
                                <Border WidthRequest="32" HeightRequest="32"
                        BackgroundColor="{AppThemeBinding Light=#F0EDE8, Dark=#1E1C1A}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="0">
                                    <Path Data="M480-420q41-37 65.25-60.75t37.5-40.5q13.25-16.75 17.75-30t4.5-27.6q0-28.65-20-49.15t-48.05-20.5q-16.98 0-32.2 7.1-15.22 7.1-24.85 18.4-9.7-11.3-24.74-18.4-15.04-7.1-31.71-7.1Q395-648.5 375-628q-20 20.5-20 49.15 0 14.35 4 27.1 4 12.75 17.22 29.56 13.22 16.8 37.92 40.92Q438.85-457.16 480-420ZM256-204v-522.08q0-24.36 16.53-40.89t40.75-16.53h333.44q24.22 0 40.75 16.53T704-726.08V-204l-224-96-224 96Zm25.5-40L480-329.66 678.5-244v-482q0-12-10-22t-22-10h-333q-12 0-22 10t-10 22v482Zm0-514h397-397Z"
                          Fill="{AppThemeBinding Light=#888880, Dark=#008080}"
                          StrokeThickness="0"
                          HeightRequest="14"
                          WidthRequest="14"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Aspect="Uniform" />
                                </Border>
                                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                    <Label Text="INTERESTED IN" FontSize="8" CharacterSpacing="1.5"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#888880, Dark=#008080}" />
                                    <Label x:Name="InterestLabel" Text="—" FontSize="13" FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}" />
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Compatibility Score Card -->
                    <Border x:Name="CompatibilityCard" Grid.Row="2"
            Margin="20,16,20,8" Padding="16,12"
            BackgroundColor="#008080" StrokeThickness="0"
            StrokeShape="RoundRectangle 14"
            IsVisible="{Binding IsNotOwner, Source={RelativeSource AncestorType={x:Type local:ProfilePage}}}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="💕" FontSize="24" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="12,0">
                                <Label Text="Compatibility Score" FontSize="10" CharacterSpacing="1.5"
                       TextColor="White" Opacity="0.8" />
                                <Label x:Name="CompatibilityScoreLabel" Text="0%" FontSize="24"
                       FontAttributes="Bold" TextColor="White" />
                            </VerticalStackLayout>
                            <Border Grid.Column="2" Padding="10,6" BackgroundColor="#FFFFFF20"
                    StrokeThickness="0" StrokeShape="RoundRectangle 20"
                    VerticalOptions="Center">
                                <Label x:Name="CompatibilityMatchLabel" Text="Good Match"
                       FontSize="11" FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Mutual Interests Card -->
                    <Border x:Name="MutualInterestsCard" Grid.Row="3"
            Margin="20,8,20,8" Padding="12,10"
            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1C1A}"
            Stroke="{AppThemeBinding Light=#EAE6E0, Dark=#333330}"
            StrokeThickness="1" StrokeShape="RoundRectangle 12"
            IsVisible="{Binding IsNotOwner, Source={RelativeSource AncestorType={x:Type local:ProfilePage}}}">
                        <VerticalStackLayout Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="🤝" FontSize="14" VerticalOptions="Center" />
                                    <Label Text="Mutual Interests" FontSize="11" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                           VerticalOptions="Center" />
                                    <Label x:Name="MutualInterestsCountLabel" Text="(0)" FontSize="10"
                           TextColor="{AppThemeBinding Light=#888880, Dark=#666660}"
                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Border x:Name="ExpandMutualInterestsButton" Grid.Column="1"
                        Padding="8,4" BackgroundColor="Transparent"
                        StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="ToggleMutualInterestsExpand" />
                                    </Border.GestureRecognizers>
                                    <Label x:Name="ExpandMutualInterestsIcon" Text="▼" FontSize="10"
                           TextColor="{AppThemeBinding Light=#888880, Dark=#666660}" />
                                </Border>
                            </Grid>
                            <FlexLayout x:Name="MutualInterestsCollapsedLayout"
                        Wrap="Wrap" JustifyContent="Start" AlignItems="Center" />
                            <Border x:Name="MutualInterestsExpandedContainer" IsVisible="False"
                    BackgroundColor="{AppThemeBinding Light=#F8F8F8, Dark=#141416}"
                    StrokeThickness="0" Padding="8" Margin="0,4,0,0"
                    StrokeShape="RoundRectangle 8">
                                <ScrollView HeightRequest="200">
                                    <VerticalStackLayout x:Name="MutualInterestsExpandedLayout" Spacing="8" />
                                </ScrollView>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Phone + Voice Intro -->
                    <VerticalStackLayout Grid.Row="4" Padding="20,10,20,0" Spacing="10">
                        <HorizontalStackLayout x:Name="PhoneRow" Spacing="8" Margin="2,0,0,0">
                            <Border WidthRequest="32" HeightRequest="32"
