<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lock.Pages.Profile.VerificationConfirmModal"
             BackgroundColor="#70000000"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped"/>
        </Grid.GestureRecognizers>

        <!-- Modal Card -->
        <Border x:Name="ModalCard"
                Margin="20,0"
                Padding="0"
                BackgroundColor="#0E1414"
                StrokeThickness="1"
                Stroke="#1F3535"
                StrokeShape="RoundRectangle 28"
                VerticalOptions="Center">

            <VerticalStackLayout Spacing="0">

                <!-- Header -->
                <Grid Padding="28,28,28,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Icon Badge -->
                    <Border Grid.Row="0"
                            WidthRequest="52" HeightRequest="52"
                            HorizontalOptions="Center"
                            BackgroundColor="#00B5B518"
                            Stroke="#00B5B540"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16">
                        <Label Text="✦"
                               FontSize="22"
                               TextColor="#00D4C8"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Label Grid.Row="2"
                           Text="Verify Your Identity"
                           FontSize="21"
                           FontAttributes="Bold"
                           TextColor="#EEF6F5"
                           CharacterSpacing="0.3"
                           HorizontalOptions="Center"/>

                    <Label Grid.Row="4"
                           Text="Review your details before submitting"
                           FontSize="13"
                           TextColor="#4A7A74"
                           HorizontalOptions="Center"/>
                </Grid>

                <!-- Thin Divider -->
                <BoxView HeightRequest="1" BackgroundColor="#172828" Margin="0"/>

                <!-- Match Score Strip -->
                <Grid Padding="20,14" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Label Grid.Column="0"
                           Text="MATCH CONFIDENCE"
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="#3A6060"
                           CharacterSpacing="1.8"
                           VerticalOptions="Center"/>
                    <!-- Progress Track -->
                    <Grid Grid.Column="1" HeightRequest="4" VerticalOptions="Center">
                        <BoxView BackgroundColor="#172828" CornerRadius="2" HeightRequest="4"/>
                        <BoxView x:Name="MatchProgressBar"
                                 BackgroundColor="#00B5B5"
                                 CornerRadius="2"
                                 HeightRequest="4"
                                 HorizontalOptions="Start"
                                 WidthRequest="130"/>
                    </Grid>
                    <Label Grid.Column="2"
                           x:Name="MatchScoreLabel"
                           Text="80%"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#00D4C8"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Thin Divider -->
                <BoxView HeightRequest="1" BackgroundColor="#172828"/>

                <!-- Scroll Area -->
                <ScrollView Margin="0" HeightRequest="340">
                    <VerticalStackLayout Spacing="0" Padding="20,20,20,8">

                        <!-- Section: ID -->
                        <Label Text="FROM YOUR ID"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#2E5050"
                               CharacterSpacing="2"
                               Margin="0,0,0,12"/>

                        <!-- Name Row -->
                        <Grid ColumnDefinitions="28,*,Auto"
                              ColumnSpacing="14"
                              Margin="0,0,0,2"
                              Padding="14,13"
                              BackgroundColor="#111C1C">
                            <!-- Left accent line -->
                            <BoxView Grid.Column="0"
                                     WidthRequest="2"
                                     HeightRequest="32"
                                     BackgroundColor="#00B5B5"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Center"
                                     CornerRadius="1"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Full Name" FontSize="10" TextColor="#3A6060" CharacterSpacing="0.5"/>
                                <Label x:Name="IdNameLabel" FontSize="14" TextColor="#00D4C8" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    BackgroundColor="#00B5B518"
                                    Stroke="#00B5B530"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,4"
                                    VerticalOptions="Center">
                                <Label x:Name="NameMatchIcon" Text="✓" FontSize="12" TextColor="#00D4C8"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#0F1F1F"/>

                        <!-- ID Number Row -->
                        <Grid ColumnDefinitions="28,*,Auto"
                              ColumnSpacing="14"
                              Margin="0,0,0,2"
                              Padding="14,13"
                              BackgroundColor="#111C1C">
                            <BoxView Grid.Column="0"
                                     WidthRequest="2"
                                     HeightRequest="32"
                                     BackgroundColor="#00B5B5"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Center"
                                     CornerRadius="1"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="ID Number" FontSize="10" TextColor="#3A6060" CharacterSpacing="0.5"/>
                                <Label x:Name="IdNumberLabel" FontSize="14" TextColor="#C5DCDA"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    BackgroundColor="#00B5B518"
                                    Stroke="#00B5B530"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,4"
                                    VerticalOptions="Center">
                                <Label x:Name="IdMatchIcon" Text="✓" FontSize="12" TextColor="#00D4C8"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#0F1F1F"/>

                        <!-- DOB Row -->
                        <Grid ColumnDefinitions="28,*,Auto"
                              ColumnSpacing="14"
                              Margin="0,0,0,2"
                              Padding="14,13"
                              BackgroundColor="#111C1C">
                            <BoxView Grid.Column="0"
                                     WidthRequest="2"
                                     HeightRequest="32"
                                     BackgroundColor="#E8963A"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Center"
                                     CornerRadius="1"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Date of Birth" FontSize="10" TextColor="#3A6060" CharacterSpacing="0.5"/>
                                <Label x:Name="IdDobLabel" FontSize="14" TextColor="#C5DCDA"/>
                            </VerticalStackLayout>
                            <Border Grid.Column="2"
                                    BackgroundColor="#E8963A18"
                                    Stroke="#E8963A30"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,4"
                                    VerticalOptions="Center">
                                <Label x:Name="DobMatchIcon" Text="⚠" FontSize="12" TextColor="#E8963A"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#0F1F1F"/>

                        <!-- Address Row -->
                        <Grid ColumnDefinitions="28,*"
                              ColumnSpacing="14"
                              Margin="0,0,0,0"
                              Padding="14,13"
                              BackgroundColor="#111C1C">
                            <BoxView Grid.Column="0"
                                     WidthRequest="2"
                                     HeightRequest="32"
                                     BackgroundColor="#00B5B5"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Center"
                                     CornerRadius="1"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Address" FontSize="10" TextColor="#3A6060" CharacterSpacing="0.5"/>
                                <Label x:Name="IdAddressLabel" FontSize="13" TextColor="#C5DCDA" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Section Spacer -->
                        <BoxView HeightRequest="20" BackgroundColor="Transparent"/>

                        <!-- Section: Profile -->
                        <Label Text="YOUR PROFILE"
                               FontSize="10"
                               FontAttributes="Bold"
                               TextColor="#2E5050"
                               CharacterSpacing="2"
                               Margin="0,0,0,12"/>

                        <!-- Profile Name -->
                        <Grid ColumnDefinitions="28,*"
                              ColumnSpacing="14"
                              Margin="0,0,0,2"
                              Padding="14,13"
                              BackgroundColor="#111C1C">
                            <BoxView Grid.Column="0"
                                     WidthRequest="2"
                                     HeightRequest="32"
                                     BackgroundColor="#6A5AE0"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Center"
                                     CornerRadius="1"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Profile Name" FontSize="10" TextColor="#3A6060" CharacterSpacing="0.5"/>
                                <Label x:Name="ProfileNameLabel" FontSize="14" TextColor="#C5DCDA" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#0F1F1F"/>

                        <!-- Profile DOB -->
                        <Grid ColumnDefinitions="28,*"
                              ColumnSpacing="14"
                              Padding="14,13"
                              BackgroundColor="#111C1C">
                            <BoxView Grid.Column="0"
                                     WidthRequest="2"
                                     HeightRequest="32"
                                     BackgroundColor="#6A5AE0"
                                     HorizontalOptions="Start"
                                     VerticalOptions="Center"
                                     CornerRadius="1"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Profile Date of Birth" FontSize="10" TextColor="#3A6060" CharacterSpacing="0.5"/>
                                <Label x:Name="ProfileDobLabel" FontSize="14" TextColor="#C5DCDA"/>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- Footer Buttons -->
                <BoxView HeightRequest="1" BackgroundColor="#172828"/>

                <Grid Padding="20,16,20,28"
                      ColumnDefinitions="*,12,*"
                      ColumnSpacing="0">

                    <!-- Cancel -->
                    <Border Grid.Column="0"
                            BackgroundColor="Transparent"
                            Stroke="#1F3535"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 14"
                            Padding="0,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelClicked"/>
                        </Border.GestureRecognizers>
                        <Label Text="Cancel"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#3A6060"
                               CharacterSpacing="0.3"
                               HorizontalOptions="Center"/>
                    </Border>

                    <!-- Submit -->
                    <Border Grid.Column="2"
                            x:Name="SubmitModalButton"
                            BackgroundColor="#00B5B5"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="0,14">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubmitClicked"/>
                        </Border.GestureRecognizers>
                        <Grid>
                            <ActivityIndicator x:Name="SubmitModalLoading"
                                               IsRunning="False"
                                               IsVisible="False"
                                               Color="#05201D"
                                               HeightRequest="20"
                                               HorizontalOptions="Center"/>
                            <Label x:Name="SubmitModalText"
                                   Text="Submit"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#05201D"
                                   CharacterSpacing="0.5"
                                   HorizontalOptions="Center"/>
                        </Grid>
                    </Border>

                </Grid>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
