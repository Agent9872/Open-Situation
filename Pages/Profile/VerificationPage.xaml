<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lock.Pages.Profile.VerificationPage"
             BackgroundColor="#0A0E0E"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="#0A0E0E">

        <!-- ══════════════════════════════════════════
             ROW 0 · HEADER (Centered)
        ══════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              Padding="16,52,16,16"
              ColumnDefinitions="*,Auto,*">

         

            <!-- Title + subtitle - Centered -->
            <VerticalStackLayout Grid.Column="1"
                                 Spacing="4"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center">
                <Label Text="ID Verification"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#E8F5F3"
                       HorizontalOptions="Center"/>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <Label Text="Secure"
                           FontSize="12"
                           TextColor="#4ECDC4"/>
                    <Label Text="·"
                           FontSize="12"
                           TextColor="#2A4040"/>
                    <Label Text="Encrypted"
                           FontSize="12"
                           TextColor="#4ECDC4"/>
                    <Label Text="·"
                           FontSize="12"
                           TextColor="#2A4040"/>
                    <Label Text="Private"
                           FontSize="12"
                           TextColor="#4ECDC4"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>


        </Grid>

        <!-- Thin header divider -->
        <BoxView Grid.Row="0"
                 HeightRequest="1"
                 BackgroundColor="#0F2020"
                 VerticalOptions="End"/>

        <!-- ══════════════════════════════════════════
             ROW 1 · SCROLLABLE CONTENT
        ══════════════════════════════════════════ -->
        <ScrollView Grid.Row="1"
                    VerticalScrollBarVisibility="Never"
                    BackgroundColor="Transparent">

            <VerticalStackLayout Spacing="0" Padding="20,20,20,28">

                <!-- ─── PROFILE INFO BANNER ───────────────────────── -->
                <Border x:Name="ProfileInfoBanner"
        Padding="16,14"
        Margin="0,0,0,24"
        BackgroundColor="#0D2020"
        StrokeThickness="1"
        Stroke="#1E4040"
        StrokeShape="RoundRectangle 16"
        IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <!-- Avatar Circle -->
                        <Border Grid.Column="0"
        WidthRequest="52" HeightRequest="52"
        BackgroundColor="#1A3A3A"
        StrokeThickness="1.5"
        Stroke="#00B5B5"
        StrokeShape="RoundRectangle 52" 
                            VerticalOptions="Center"
        HorizontalOptions="Center">
                            <Label x:Name="ProfileInitials"
           Text="JD"
           FontSize="18"
           FontAttributes="Bold"
           TextColor="#00B5B5"
           HorizontalOptions="Center"
           VerticalOptions="Center"/>
                        </Border>
                        <!-- Name and DOB -->
                        <VerticalStackLayout Grid.Column="1" 
                             VerticalOptions="Center" 
                             Spacing="4">
                            <HorizontalStackLayout Spacing="8" 
                                   VerticalOptions="Center">
                                <Label x:Name="ProfileNameLabel"
                       Text="Loading..."
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="#E8F5F3"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"/>
                                <!-- Verified Star Icon -->
                                <Border x:Name="VerifiedStarIcon"
                        WidthRequest="22" 
                        HeightRequest="22"
                        BackgroundColor="Transparent"
                        IsVisible="False"
                        VerticalOptions="Center">
                                    <Path Data="M12 2L15 8.5L22 9.5L17 14L18.5 21L12 17.5L5.5 21L7 14L2 9.5L9 8.5L12 2Z"
                          Fill="#00B5B5"
                          Stroke="#00B5B5"
                          StrokeThickness="0.5"
                          WidthRequest="18" 
                          HeightRequest="18"
                          Aspect="Uniform"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"/>
                                </Border>
                            </HorizontalStackLayout>
                            <Label x:Name="ProfileDobLabel"
                   Text="DOB: --/--/----"
                   FontSize="13"
                   TextColor="#6AABA5"/>
                        </VerticalStackLayout>

                        <!-- Status Badge -->
                        <Border x:Name="ProfileStatusBadge"
                Grid.Column="2"
                Padding="10,6"
                BackgroundColor="#FF6B6B20"
                StrokeThickness="1"
                Stroke="#FF6B6B"
                StrokeShape="RoundRectangle 20"
                VerticalOptions="Center">
                            <Label x:Name="ProfileVerifiedBadge"
                   Text="Not Verified"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="#FF6B6B"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                </Border>
                <!-- ─── SELECT ID TYPE ────────────────────────── -->
                <Label Text="SELECT ID TYPE"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#3A6060"
                       CharacterSpacing="2.0"
                       Margin="4,0,0,14"/>

                <Border Padding="8"
                        Margin="0,0,0,28"
                        StrokeThickness="1"
                        Stroke="#152C2C"
                        BackgroundColor="#0C1C1C"
                        StrokeShape="RoundRectangle 16">

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,*"
                          RowSpacing="8"
                          ColumnSpacing="8">

                        <!-- National ID -->
                        <Border Grid.Row="0" Grid.Column="0"
                                x:Name="ChipNational"
                                Padding="0,12"
                                BackgroundColor="#0F2020"
                                StrokeThickness="1"
                                Stroke="#1A3535"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIdTypeSelected" CommandParameter="National ID"/>
                            </Border.GestureRecognizers>
                            <Label Text="National ID"
                                   FontSize="14"
                                   TextColor="#A8D8D4"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <!-- Driver's License -->
                        <Border Grid.Row="0" Grid.Column="1"
                                x:Name="ChipDriver"
                                Padding="0,12"
                                BackgroundColor="#0F2020"
                                StrokeThickness="1"
                                Stroke="#1A3535"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIdTypeSelected" CommandParameter="Driver's License"/>
                            </Border.GestureRecognizers>
                            <Label Text="Driver's License"
                                   FontSize="14"
                                   TextColor="#A8D8D4"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <!-- Passport -->
                        <Border Grid.Row="1" Grid.Column="0"
                                x:Name="ChipPassport"
                                Padding="0,12"
                                BackgroundColor="#0F2020"
                                StrokeThickness="1"
                                Stroke="#1A3535"
                                StrokeShape="RoundRectangle 12">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIdTypeSelected" CommandParameter="Passport"/>
                            </Border.GestureRecognizers>
                            <Label Text="Passport"
                                   FontSize="14"
                                   TextColor="#A8D8D4"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <!-- Voter's Card -->
                        <Border Grid.Row="1" Grid.Column="1"
                                x:Name="ChipVoter"
                                Padding="0,12"
                                StrokeThickness="1.5"
                                Stroke="#00B5B5"
                                StrokeShape="RoundRectangle 12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0E2E2E" Offset="0"/>
                                    <GradientStop Color="#0A2424" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnIdTypeSelected" CommandParameter="Voter's Card"/>
                            </Border.GestureRecognizers>
                            <Label Text="Voter's Card"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#00B5B5"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                    </Grid>
                </Border>
                <!-- UPLOAD DOCUMENT -->
                <Label Text="UPLOAD DOCUMENT"
       FontSize="13"
       FontAttributes="Bold"
       TextColor="#3A6060"
       CharacterSpacing="2.0"
       Margin="4,0,0,14"/>

                <!-- Combined Upload Area -->
                <Border x:Name="UploadDropZone"
        Padding="20,24"
        Margin="0,0,0,24"
        BackgroundColor="#0C1A1A"
        StrokeThickness="1.5"
        Stroke="#1A3535"
        StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                        <!-- Dual Icons Row -->
                        <Grid ColumnDefinitions="Auto,24,Auto"
              HorizontalOptions="Center"
              ColumnSpacing="0">

                            <!-- Camera Icon - No border/container -->
                            <Grid Grid.Column="0"
                  WidthRequest="48"
                  HeightRequest="48"
                  HorizontalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTakePhotoClicked"/>
                                </Grid.GestureRecognizers>
                                <Path Data="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2zM12 17a4 4 0 100-8 4 4 0 000 8z"
                      Stroke="#00B5B5"
                      StrokeThickness="2"
                      Fill="Transparent"
                      WidthRequest="22"
                      HeightRequest="22"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"/>
                            </Grid>

                            <!-- Upload Icon - No border/container -->
                            <Grid Grid.Column="2"
                  WidthRequest="48"
                  HeightRequest="48"
                  HorizontalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUploadClicked"/>
                                </Grid.GestureRecognizers>
                                <Path Data="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"
                      Stroke="#00B5B5"
                      StrokeThickness="2"
                      Fill="Transparent"
                      WidthRequest="22"
                      HeightRequest="22"
                      Aspect="Uniform"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      StrokeLineCap="Round"
                      StrokeLineJoin="Round"/>
                            </Grid>

                        </Grid>

                        <!-- Text Section -->
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Camera or Upload"
                   FontSize="14"
                   TextColor="#8ABFBA"
                   HorizontalOptions="Center"/>
                            <Label Text="Tap to capture or select your ID"
                   FontSize="12"
                   TextColor="#6AABA5"
                   HorizontalOptions="Center"/>
                            <Label Text="JPG · PNG · PDF"
                   FontSize="11"
                   FontAttributes="Bold"
                   TextColor="#00B5B5"
                   HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Loading Indicator -->
                <Border x:Name="ProcessingContainer"
        BackgroundColor="#0C1A1A"
        Stroke="#00B5B5"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 18"
        Padding="16"
        Margin="0,0,0,16"
        IsVisible="False">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <ActivityIndicator x:Name="ProcessingActivity"
                           IsRunning="True"
                           IsVisible="True"
                           Color="#00B5B5"
                           HeightRequest="36"/>
                        <Label Text="Processing your ID..."
               FontSize="13"
               TextColor="#8ABFBA"
               HorizontalOptions="Center"/>
                        <Label Text="Please wait while we extract the information"
               FontSize="11"
               TextColor="#6AABA5"
               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Image preview container -->
                <Border x:Name="ImagePreviewContainer"
        BackgroundColor="#0C1A1A"
        Stroke="#00B5B5"
        StrokeThickness="2"
        StrokeShape="RoundRectangle 18"
        HeightRequest="180"
        Margin="0,0,0,16"
        IsVisible="False">
                    <Image x:Name="PreviewImage"
           Aspect="AspectFill"
           HorizontalOptions="Fill"
           VerticalOptions="Fill"/>
                </Border>
                <!-- ─── EXTRACTED INFO CARD ───────────────────────── -->
                <Border x:Name="ExtractedInfoContainer"
                        BackgroundColor="#0C1A1A"
                        Stroke="#1E4040"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="0"
                        Margin="0,0,0,16"
                        IsVisible="False">

                    <VerticalStackLayout Spacing="0">

                        <!-- ACCOUNT VERIFIED BANNER -->
                        <Border x:Name="AlreadyVerifiedBanner"
                                BackgroundColor="#0F2020"
                                Stroke="#00B5B5"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 16"
                                Padding="16,14"
                                IsVisible="False">
                            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                                <Label Text="Account Verified"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="#00B5B5"
                                       HorizontalOptions="Center"/>
                                <Label x:Name="VerifiedDateLabel"
                                       Text="Verified on April 14, 2026"
                                       FontSize="13"
                                       TextColor="#6AABA5"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Card header -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              Padding="14,12" ColumnSpacing="8">
                            <BoxView Grid.Column="0"
                                     WidthRequest="6" HeightRequest="6"
                                     CornerRadius="3"
                                     BackgroundColor="#00B5B5"
                                     VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="VERIFICATION INFORMATION"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="#00B5B5"
                                   CharacterSpacing="1.5"
                                   VerticalOptions="Center"/>
                            <Border Grid.Column="2"
                                    BackgroundColor="#0F2020"
                                    Stroke="#1E4040"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20"
                                    Padding="8,4">
                                <Label x:Name="ConfidenceBadge"
                                       Text="From Profile"
                                       FontSize="10"
                                       TextColor="#00B5B5"/>
                            </Border>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#1E4040"/>

                        <!-- Name row -->
                        <Grid ColumnDefinitions="40,*" Padding="14,12" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#0F2020" Stroke="#1E4040" StrokeThickness="1" StrokeShape="RoundRectangle 10" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Path Data="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2 M12 11a4 4 0 100-8 4 4 0 000 8z" Stroke="#6AABA5" StrokeThickness="1.5" Fill="Transparent" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="FULL NAME" FontSize="11" FontAttributes="Bold" TextColor="#3A6060" CharacterSpacing="1.0"/>
                                <Label x:Name="ExtractedName" FontSize="15" TextColor="#00B5B5" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#1E4040" Margin="14,0"/>

                        <!-- ID Number row -->
                        <Grid ColumnDefinitions="40,*" Padding="14,12" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#0F2020" Stroke="#1E4040" StrokeThickness="1" StrokeShape="RoundRectangle 10" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Path Data="M2 7a2 2 0 012-2h16a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V7z M2 10h20" Stroke="#6AABA5" StrokeThickness="1.5" Fill="Transparent" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="ID / NIN / VIN" FontSize="11" FontAttributes="Bold" TextColor="#3A6060" CharacterSpacing="1.0"/>
                                <Label x:Name="ExtractedIdNumber" FontSize="15" TextColor="#E8F5F3" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#1E4040" Margin="14,0"/>

                        <!-- DOB row -->
                        <Grid ColumnDefinitions="40,*" Padding="14,12" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#0F2020" Stroke="#1E4040" StrokeThickness="1" StrokeShape="RoundRectangle 10" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Path Data="M8 2v4 M16 2v4 M3 10h18 M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z" Stroke="#6AABA5" StrokeThickness="1.5" Fill="Transparent" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="DATE OF BIRTH" FontSize="11" FontAttributes="Bold" TextColor="#3A6060" CharacterSpacing="1.0"/>
                                <Label x:Name="ExtractedDob" FontSize="15" TextColor="#00B5B5" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#1E4040" Margin="14,0"/>

                        <!-- Age row -->
                        <Grid ColumnDefinitions="40,*" Padding="14,12" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#0F2020" Stroke="#1E4040" StrokeThickness="1" StrokeShape="RoundRectangle 10" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Path Data="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" Stroke="#6AABA5" StrokeThickness="1.5" Fill="Transparent" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="AGE" FontSize="11" FontAttributes="Bold" TextColor="#3A6060" CharacterSpacing="1.0"/>
                                <Label x:Name="ExtractedAge" FontSize="15" TextColor="#00B5B5" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#1E4040" Margin="14,0"/>

                        <!-- Address row -->
                        <Grid ColumnDefinitions="40,*" Padding="14,12" ColumnSpacing="12">
                            <Border Grid.Column="0" BackgroundColor="#0F2020" Stroke="#1E4040" StrokeThickness="1" StrokeShape="RoundRectangle 10" WidthRequest="32" HeightRequest="32" VerticalOptions="Center">
                                <Path Data="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z M12 10a2 2 0 100-4 2 2 0 000 4z" Stroke="#6AABA5" StrokeThickness="1.5" Fill="Transparent" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform"/>
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="ADDRESS" FontSize="11" FontAttributes="Bold" TextColor="#3A6060" CharacterSpacing="1.0"/>
                                <Label x:Name="ExtractedAddress" FontSize="14" TextColor="#E8F5F3" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Raw text section -->
                        <BoxView HeightRequest="1" BackgroundColor="#1E4040"/>
                        <Grid ColumnDefinitions="*,Auto" Padding="14,10,14,8">
                            <Label Grid.Column="0" Text="FULL EXTRACTED TEXT" FontSize="10" FontAttributes="Bold" TextColor="#3A6060" CharacterSpacing="1.5" VerticalOptions="Center"/>
                            <Label Grid.Column="1" Text="Read-only" FontSize="10" TextColor="#3A6060"/>
                        </Grid>
                        <Editor x:Name="FullExtractedText" AutoSize="TextChanges" MinimumHeightRequest="70" FontSize="12" TextColor="#6AABA5" BackgroundColor="#071212" IsReadOnly="True" Margin="14,0,14,14"/>

                        <!-- Verification Status -->
                        <Border x:Name="VerificationStatusContainer" BackgroundColor="#0F2020" Stroke="#FF6B6B" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="12,10" Margin="14,2,14,4" IsVisible="False">
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <Label x:Name="VerificationStatusIcon" Text="⚠️" FontSize="14" VerticalOptions="Center"/>
                                <Label x:Name="VerificationStatusMessage" Text="Waiting for verification..." FontSize="12" TextColor="#FF6B6B" VerticalOptions="Center"/>
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Submit Button -->
                        <Border x:Name="SubmitButton" BackgroundColor="#00B5B5" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="14,12" Margin="14,8,14,14" Opacity="0.5" IsEnabled="False">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSubmitVerificationClicked"/>
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                <ActivityIndicator x:Name="SubmitLoading" IsRunning="False" IsVisible="False" Color="#00B5B5" HeightRequest="20"/>
                                <Label x:Name="SubmitButtonText" Text="Submit for Verification" FontSize="14" FontAttributes="Bold" TextColor="#00B5B5"/>
                            </HorizontalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </Border>
                
                <!-- ─── SECURITY NOTE ─────────────────────────── -->
                <Border Padding="12,10"
                        BackgroundColor="#080F0F"
                        StrokeThickness="1"
                        Stroke="#0F2020"
                        StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                        <Path Grid.Column="0"
                              Data="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                              Stroke="#00B5B5"
                              StrokeThickness="1.5"
                              Fill="Transparent"
                              WidthRequest="14" HeightRequest="14"
                              Aspect="Uniform"
                              VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="256-bit encryption protects your documents. Your ID is never stored as an image."
                               FontSize="11"
                               TextColor="#3A6A65"
                               LineBreakMode="WordWrap"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>