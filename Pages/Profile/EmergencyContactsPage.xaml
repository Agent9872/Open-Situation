<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lock.Pages.Profile.EmergencyContactsPage"
             Title="Emergency Contacts"
             BackgroundColor="{AppThemeBinding Light=#F5F6FA, Dark=#0F0F11}">

    <Grid RowDefinitions="Auto,*">

        <!-- Header with SOS button -->
        <Border Grid.Row="0"
                BackgroundColor="#C05050"
                Padding="20,15"
                StrokeThickness="0">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Emergency Contacts"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="These contacts will be notified in case of emergency"
                           FontSize="12"
                           TextColor="#FFE0E0"
                           Margin="0,4,0,0" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="SOS"
                        BackgroundColor="White"
                        TextColor="#FF3B6F"
                        FontSize="16"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        WidthRequest="70"
                        HeightRequest="50"
                        x:Name="SOSButton" />
            </Grid>
        </Border>

        <!-- Contacts list -->
        <CollectionView x:Name="ContactsCollectionView"
                        Grid.Row="1"
                        SelectionMode="None"
                        Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16,12"
                            Margin="16,8"
                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F21}"
                            Stroke="{AppThemeBinding Light=#E6E9EE, Dark=#333333}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                              ColumnSpacing="8">

                            <!-- Primary badge -->
                            <Border Grid.Column="0"
                                    IsVisible="{Binding IsPrimary}"
                                    BackgroundColor="#008080"
                                    Padding="6,3"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8"
                                    VerticalOptions="Center">
                                <Label Text="Primary"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>

                            <!-- Contact info -->
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="{Binding Name}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}" />
                                <Label Text="{Binding PhoneNumber}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                <Label Text="{Binding Relationship}"
                                       FontSize="11"
                                       TextColor="{AppThemeBinding Light=#888880, Dark=#666660}" />
                            </VerticalStackLayout>

                            <!-- Edit button -->
                            <Button Grid.Column="2"
                                    Text="Edit"
                                    BackgroundColor="Transparent"
                                    TextColor="#008080"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    Padding="12,8"
                                    VerticalOptions="Center"
                                    Clicked="OnEditContactClicked"
                                    CommandParameter="{Binding .}" />

                            <!-- Delete button -->
                            <Button Grid.Column="3"
                                    Text="Delete"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#888880, Dark=#666660}"
                                    FontSize="12"
                                    Padding="12,8"
                                    VerticalOptions="Center"
                                    Clicked="OnDeleteContactClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="16"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Margin="20">
                    <Label Text="👥"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="No emergency contacts"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#1A1A1A, Dark=#F0EDE8}"
                           HorizontalOptions="Center" />
                    <Label Text="Add contacts to be notified in case of emergency"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#888880, Dark=#666660}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Add button -->
        <Border Grid.Row="1"
                BackgroundColor="Transparent"
                VerticalOptions="End"
                HorizontalOptions="End"
                Margin="0,0,20,20">
            <Button x:Name="AddContactButton"
        Text="+"
        BackgroundColor="#FF3B6F"
        TextColor="White"
        FontSize="24"
        FontAttributes="Bold"
        CornerRadius="30"
        WidthRequest="60"
        HeightRequest="60"
        BorderColor="Transparent"
        BorderWidth="0" />
        </Border>
    </Grid>
</ContentPage>