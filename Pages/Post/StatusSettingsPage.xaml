                        Stroke="#1A3A3A"
                        StrokeShape="RoundRectangle 14"
                        Padding="14,12"
                        Margin="0,12,0,0">
                    <HorizontalStackLayout Spacing="10">
                        <Path Data="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q134 0 227-93t93-227q0-134-93-227t-227-93q-134 0-227 93t-93 227q0 134 93 227t227 93Zm0-320q17 0 28.5 11.5T520-440v200q0 17-11.5 28.5T480-200q-17 0-28.5-11.5T440-240v-200q0-17 11.5-28.5T480-480Zm0-160q17 0 28.5 11.5T520-600q0 17-11.5 28.5T480-560q-17 0-28.5-11.5T440-600q0-17 11.5-28.5T480-640Z"
