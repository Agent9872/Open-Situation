                           FontSize="10" FontAttributes="Bold"
                           TextColor="#7A7A8C"
                           CharacterSpacing="2"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border BackgroundColor="#16161C"
                        StrokeThickness="1"
                        Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 16"
                        Padding="0"
                        Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="0">

                        <!-- View History -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              Padding="16,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnViewHistoryClicked" />
                            </Grid.GestureRecognizers>

                            <Border Grid.Column="0"
                                    BackgroundColor="#1C1C25"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    WidthRequest="36" HeightRequest="36">
                                <Path Data="M480-120q-138 0-240.5-91.5T122-440h82q14 104 92.5 172T480-200q117 0 198.5-81.5T760-480q0-117-81.5-198.5T480-760q-69 0-129 32t-101 88h110v80H120v-240h80v94q51-64 124.5-99T480-840q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-480q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-120Zm112-192L440-464v-216h80v184l128 128-56 56Z"
