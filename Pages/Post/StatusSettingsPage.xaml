                                <Label Text="Clear all statuses"
                                       FontSize="14" TextColor="#FF3B6F" />
                                <Label Text="Permanently delete all your status images"
                                       FontSize="11" TextColor="#5A5A6A" />
                            </VerticalStackLayout>

                            <Path Grid.Column="2"
                                  Data="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"
                                  Fill="#5A5A6A" HeightRequest="14" WidthRequest="14"
