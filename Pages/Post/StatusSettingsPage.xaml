                          HeightRequest="12" WidthRequest="12"
                          VerticalOptions="Center" Aspect="Uniform" />
                    <Label Text="AUTO-DELETE"
                           FontSize="10" FontAttributes="Bold"
                           TextColor="#00B5B5"
                           CharacterSpacing="2"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Border BackgroundColor="#16161C"
                        StrokeThickness="1"
                        Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 16"
                        Padding="0"
                        Margin="0,0,0,8">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12"
                          Padding="16,14">

                        <!-- Clock icon -->
                        <Border Grid.Column="0"
                                BackgroundColor="#0D1F1F"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                WidthRequest="36" HeightRequest="36">
                            <Path Data="M360-840v-80h240v80H360Zm80 440h80v-240h-80v240Zm40 320q-74 0-139.5-28.5T226-186q-49-49-77.5-114.5T120-440q0-74 28.5-139.5T226-694q49-49 114.5-77.5T480-800q62 0 119 20t107 58l56-56 56 56-56 56q38 50 58 107t20 119q0 74-28.5 139.5T734-186q-49 49-114.5 77.5T480-80Zm0-80q116 0 198-82t82-198q0-116-82-198t-198-82q-116 0-198 82t-82 198q0 116 82 198t198 82Zm0-280Z"
