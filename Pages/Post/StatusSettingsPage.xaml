                                      HeightRequest="16" WidthRequest="16"
                                      HorizontalOptions="Center" VerticalOptions="Center"
                                      Aspect="Uniform" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="Who can see my status"
                                       FontSize="14" TextColor="#F0EDE8" />
                                <Label Text="Choose your audience"
                                       FontSize="11" TextColor="#5A5A6A" />
                            </VerticalStackLayout>

                            <Picker x:Name="PrivacyPicker"
                                    Grid.Column="2"
                                    WidthRequest="130"
                                    FontSize="13"
                                    TextColor="#FF3B6F"
                                    BackgroundColor="Transparent"
                                    Title="Select"
                                    TitleColor="#5A5A6A"
                                    SelectedIndexChanged="OnPrivacyChanged">
                                <Picker.Items>
                                    <x:String>Everyone</x:String>
                                    <x:String>My Contacts</x:String>
                                    <x:String>Only Me</x:String>
                                    <x:String>Custom</x:String>
                                </Picker.Items>
                            </Picker>
                        </Grid>

                        <!-- Custom options (collapsible) -->
                        <VerticalStackLayout x:Name="CustomPrivacyOptions"
                                             IsVisible="False" Spacing="0">
                            <BoxView HeightRequest="1" BackgroundColor="#2A2A38" />

                            <VerticalStackLayout Padding="16,12" Spacing="10">
                                <Label Text="CUSTOM VISIBILITY"
                                       FontSize="9" FontAttributes="Bold"
                                       TextColor="#5A5A6A"
                                       CharacterSpacing="1.5" />

