                                              HeightRequest="14" WidthRequest="14"
                                              VerticalOptions="Center" Aspect="Uniform" />
                                        <Label Grid.Column="1"
                                               Text="Allowed contacts"
                                               FontSize="13" TextColor="#F0EDE8"
                                               VerticalOptions="Center" />
                                        <Path Grid.Column="2"
                                              Data="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"
                                              Fill="#5A5A6A" HeightRequest="12" WidthRequest="12"
                                              VerticalOptions="Center" Aspect="Uniform" />
                                    </Grid>
                                </Border>

                                <!-- Blocked contacts -->
                                <Border BackgroundColor="#1A0D1A"
                                        StrokeThickness="1"
                                        Stroke="#3A1A2A"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="14,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBlockedContactsClicked" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <Path Grid.Column="0"
                                              Data="M480-80q-83 0-156-31.5T197-197q-54-54-85.5-127T80-480q0-83 31.5-156T197-763q54-54 127-85.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 83-31.5 156T763-197q-54 54-127 85.5T480-80Zm0-80q54 0 104-17.5t92-50.5L228-612q-33 42-50.5 92T160-480q0 134 93 227t227 93Zm252-168L252-652q33-43 83-65.5T480-740q134 0 227 93t93 227q0 56-22.5 106T732-228Z"
