                                  HeightRequest="16" WidthRequest="16"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Aspect="Uniform" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="Visibility duration"
                                   FontSize="14" TextColor="#F0EDE8" />
                            <Label Text="How long before it disappears"
                                   FontSize="11" TextColor="#5A5A6A" />
                        </VerticalStackLayout>

                        <Picker x:Name="DurationPicker"
                                Grid.Column="2"
                                WidthRequest="120"
                                FontSize="13"
                                TextColor="#00B5B5"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnDurationChanged">
                            <Picker.Items>
                                <x:String>24 hours</x:String>
                                <x:String>48 hours</x:String>
                                <x:String>7 days</x:String>
                                <x:String>Never expire</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>
                </Border>

