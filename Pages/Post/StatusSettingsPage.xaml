                <Border BackgroundColor="#16161C"
                        StrokeThickness="1"
                        Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 16"
                        Padding="0"
                        Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="0">

                        <!-- Who can see -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              Padding="16,14">

                            <!-- Icon circle -->
