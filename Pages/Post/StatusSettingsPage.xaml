                                              HeightRequest="14" WidthRequest="14"
                                              VerticalOptions="Center" Aspect="Uniform" />
                                        <Label Grid.Column="1"
                                               Text="Blocked contacts"
                                               FontSize="13" TextColor="#F0EDE8"
                                               VerticalOptions="Center" />
                                        <Path Grid.Column="2"
                                              Data="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"
                                              Fill="#5A5A6A" HeightRequest="12" WidthRequest="12"
                                              VerticalOptions="Center" Aspect="Uniform" />
                                    </Grid>
                                </Border>

                                <Label Text="Only selected contacts can view your status"
                                       FontSize="11" TextColor="#5A5A6A"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- ══ SECTION: AUTO-DELETE ══ -->
                <HorizontalStackLayout Spacing="8" Margin="4,20,0,10">
                    <Path Data="M360-840v-80h240v80H360Zm80 440h80v-240h-80v240Zm40 320q-74 0-139.5-28.5T226-186q-49-49-77.5-114.5T120-440q0-74 28.5-139.5T226-694q49-49 114.5-77.5T480-800q62 0 119 20t107 58l56-56 56 56-56 56q38 50 58 107t20 119q0 74-28.5 139.5T734-186q-49 49-114.5 77.5T480-80Zm0-80q116 0 198-82t82-198q0-116-82-198t-198-82q-116 0-198 82t-82 198q0 116 82 198t198 82Zm0-280Z"
