                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="View my status history"
                                       FontSize="14" TextColor="#F0EDE8" />
                                <Label Text="See all statuses you've posted"
                                       FontSize="11" TextColor="#5A5A6A" />
                            </VerticalStackLayout>

                            <Path Grid.Column="2"
                                  Data="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"
                                  Fill="#5A5A6A" HeightRequest="14" WidthRequest="14"
                                  VerticalOptions="Center" Aspect="Uniform" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2A2A38" Margin="16,0" />

                        <!-- Clear All -->
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12"
                              Padding="16,14">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnClearAllClicked" />
                            </Grid.GestureRecognizers>

                            <Border Grid.Column="0"
                                    BackgroundColor="#1A0808"
