<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lock.Pages.Post.StatusSettingsPage"
             BackgroundColor="#0E0E12">

    <Grid RowDefinitions="Auto,*">

        <!-- ── HEADER ── -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              Padding="16,12,16,12"
              BackgroundColor="#0E0E12">

          
            <!-- Title -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"
                                 HorizontalOptions="Center" Spacing="1">
                <Label Text="Status Settings"
                       FontSize="15" FontAttributes="Bold"
                       TextColor="#F0EDE8"
                       HorizontalOptions="Center" />
                <Label Text="Control who sees your moments"
                       FontSize="11"
                       TextColor="#5A5A6A"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </Grid>

        <!-- Header divider -->
        <BoxView Grid.Row="0"
                 HeightRequest="1"
                 BackgroundColor="#1C1C25"
                 VerticalOptions="End" />

        <!-- ── SCROLLABLE CONTENT ── -->
        <ScrollView Grid.Row="1" BackgroundColor="#0E0E12">
            <VerticalStackLayout Spacing="0" Padding="16,20,16,48">

                <!-- ══ SECTION: PRIVACY ══ -->
