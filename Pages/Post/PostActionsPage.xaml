<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lock.Pages.Post.PostActionsPage"
             BackgroundColor="#80000000"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             NavigationPage.HasBackButton="False"
             Title="Post actions">

    <Grid BackgroundColor="#80000000">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackgroundTapped" NumberOfTapsRequired="1" />
        </Grid.GestureRecognizers>

        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="0"
                BackgroundColor="#1E1E1E"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                WidthRequest="320"
                MaximumWidthRequest="340">

            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCardTapped" />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="0">

                <!-- Header -->
                <Grid Padding="14,12,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Label x:Name="PreviewLabel"
                           Grid.Column="0"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"
                           TextColor="White"
                           FontSize="14"
                           VerticalOptions="Center" />

                    <Button Grid.Column="1"
                            Text="✕"
                            FontSize="18"
                            FontAttributes="Bold"
                            BackgroundColor="Transparent"
                            TextColor="#888888"
                            WidthRequest="32" HeightRequest="32"
                            HorizontalOptions="End" VerticalOptions="Center"
                            Clicked="OnCloseClicked" />
                </Grid>

                <BoxView HeightRequest="2" BackgroundColor="#FF3B6F" HorizontalOptions="Fill" />

                <Label Text="Actions" FontSize="14" TextColor="#BBBBBB" Padding="14,12,14,4" />

                <ScrollView Orientation="Vertical" HeightRequest="460">
                    <VerticalStackLayout Spacing="0">

                        <!-- ── OWN POST: Edit ──────────────────────────── -->
                        <Grid x:Name="EditPostRow" Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnEditTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125"
                                      Fill="#60A5FA" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <Label Grid.Column="1" Text="Edit post"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>
                        <BoxView x:Name="EditDivider" HeightRequest="1" BackgroundColor="#333333" Margin="14,0" />

                        <!-- ── OWN POST: Delete ────────────────────────── -->
                        <Grid x:Name="DeletePostRow" Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDeleteTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2-0.9 2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z"
                                      Fill="#FF3B6F" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <Label Grid.Column="1" Text="Delete post"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>
                        <BoxView x:Name="DeleteDivider" HeightRequest="1" BackgroundColor="#333333" Margin="14,0" />

                        <!-- ── OTHER: Hide Post ───────────────────────── -->
                        <Grid x:Name="HidePostRow" Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnHidePostTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="M480-320q75 0 127.5-52.5T660-500q0-75-52.5-127.5T480-680q-75 0-127.5 52.5T300-500q0 75 52.5 127.5T480-320Zm0-72q-45 0-76.5-31.5T372-500q0-45 31.5-76.5T480-608q45 0 76.5 31.5T588-500q0 45-31.5 76.5T480-392Zm0 192q-146 0-266-81.5T40-500q54-137 174-218.5T480-800q146 0 266 81.5T920-500q-54 137-174 218.5T480-200Zm0-300Zm0 220q113 0 207.5-59.5T832-500q-50-101-144.5-160.5T480-720q-113 0-207.5 59.5T128-500q50 101 144.5 160.5T480-280Z"
                                      Fill="#888888" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <Label Grid.Column="1" Text="Hide post (won't see it again)"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>
                        <BoxView x:Name="HidePostDivider" HeightRequest="1" BackgroundColor="#333333" Margin="14,0" />

                        <!-- ── OTHER: Mute User ───────────────────────── -->
                        <Grid x:Name="MuteUserRow" Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMuteUserTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="M215.5-216v-25.5H273V-565q0-20.74 4-41.38 4-20.64 12.5-39.12l20 20q-5.5 14.56-8.25 29.72-2.75 15.16-2.75 30.78v323.5h364L128-770.5l18-18.5 670.5 670.5-18 18L682.84-216H215.5Zm472-144.5L662-386v-179q0-75.62-53.28-128.56T480-746.5q-36.72 0-69.86 12.75T352-696l-18-18q23.67-21.98 52.3-37.09Q414.92-766.2 447-771v-19.06q0-14.07 9.26-23.5 9.27-9.44 23.5-9.44 14.24 0 23.74 9.44 9.5 9.43 9.5 23.42v18.96q76.5 11.18 125.5 69.95t49 136.47v204.26Zm-207-61.5Zm-.68 304q-24.32 0-41.57-17.38Q421-152.75 421-177h118q0 24.5-17.43 41.75Q504.15-118 479.82-118ZM507-541Z"
                                      Fill="#888888" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <!-- x:Name so code-behind can update text to Unmute -->
                            <Label x:Name="MuteUserLabel"
                                   Grid.Column="1"
                                   Text="Mute user (stop seeing their posts)"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>
                        <BoxView x:Name="MuteUserDivider" HeightRequest="1" BackgroundColor="#333333" Margin="14,0" />

                        <!-- ── OTHER: Block User ──────────────────────── -->
                        <Grid x:Name="BlockUserRow" Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBlockUserTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10-4.48 10-10S17.52,2 12,2z M4,12c0-4.42 3.58-8 8-8 1.85,0 3.55,0.63 4.9,1.69L5.69,16.9C4.63,15.55 4,13.85 4,12z M12,20c-1.85,0-3.55-0.63-4.9-1.69L18.31,7.1C19.37,8.45 20,10.15 20,12 20,16.42 16.42,20 12,20z"
                                      Fill="#C05050" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <Label Grid.Column="1" Text="Block user"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>
                        <BoxView x:Name="BlockUserDivider" HeightRequest="1" BackgroundColor="#333333" Margin="14,0" />


                        <!-- ── UNIVERSAL: Copy Link ────────────────────── -->
                        <Grid Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCopyLinkTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="M440-280H280q-83 0-141.5-58.5T80-480q0-83 58.5-141.5T280-680h160v80H280q-50 0-85 35t-35 85q0 50 35 85t85 35h160v80ZM320-440v-80h320v80H320Zm200 160v-80h160q50 0 85-35t35-85q0-50-35-85t-85-35H520v-80h160q83 0 141.5 58.5T880-480q0 83-58.5 141.5T680-280H520Z"
                                      Fill="#60A5FA" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <Label Grid.Column="1" Text="Copy link"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="14,0" />

                        <!-- ── UNIVERSAL: Share ───────────────────────── -->
                        <Grid Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSharePostTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="M657.35-153q-36.35 0-61.1-24.85Q571.5-202.71 571.5-239q0-10 7.5-32L302.5-424q-12 14-28.94 22t-36.3 8q-35.11 0-59.68-25.27Q153-444.54 153-479.77q0-35.23 24.65-60.73Q202.29-566 237.5-566q19.23 0 36 7.87 16.78 7.86 28.5 21.63l245-152.08q-3.5-7.42-5.5-15.73t-2-17.19q0-35.63 24.9-60.56 24.89-24.94 61-24.94 36.1 0 60.85 25.04T711-721.15q0 35.98-24.96 60.82-24.96 24.83-60.62 24.83-19.69 0-35.8-8.25-16.11-8.25-28.12-22.75L317-513.5q3 8 5.25 16.63 2.25 8.62 2.25 16.95 0 8.32-2 16.58-2 8.27-5 16.28L561.5-294q11.79-14 28.06-22.5t35.86-8.5q35.66 0 60.62 25.25T711-239q0 36.5-24.98 61.25T657.35-153Z"
                                      Fill="#60A5FA" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <Label Grid.Column="1" Text="Share post (to chat, external apps)"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="14,0" />

                        <!-- ── OTHER: Follow/Unfollow ─────────────────── -->
                        <Grid x:Name="FollowUserRow" Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFollowUserTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="M480-400q-100 0-168.5 58.5T223-208q-10-80-36.5-113.5T118-356q-13 0-22.5-7T86-383q-2-5-2-10.5t3-11.5q19-49 59-84.5T254-546q-33-24-53-60t-20-78q0-70 49-119t119-49q70 0 119 49t49 119q0 42-20 78t-53 60q70 14 110 49.5t59 84.5q2 6 1.5 11.5T630-383q-5 10-14.5 16.5T594-360q-37 0-64 32t-33 96q-12-4-25.5-6t-28.5-2q-10 0-19.5.5T480-234q-20-2-38-3t-38-1q-26 0-46 1.5t-30 4.5v-27h152Z"
                                      Fill="#60A5FA" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <Label Grid.Column="1" Text="Follow / Unfollow user"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>
                        <BoxView x:Name="FollowUserDivider" HeightRequest="1" BackgroundColor="#333333" Margin="14,0" />

                        <!-- ── OTHER: Not Interested ──────────────────── -->
                        <Grid x:Name="NotInterestedRow" Padding="14,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnNotInterestedTapped" />
                            </Grid.GestureRecognizers>
                            <ContentView Grid.Column="0" WidthRequest="24" HeightRequest="24">
                                <Path Data="M480-413 357-290l-36-36 123-123-123-123 36-36 123 123 123-123 36 36-123 123 123 123-36 36-123-123Z"
                                      Fill="#888888" HeightRequest="20" WidthRequest="20"
                                      HorizontalOptions="Center" VerticalOptions="Center" Aspect="Uniform" />
                            </ContentView>
                            <Label Grid.Column="1" Text="Not interested"
                                   VerticalOptions="Center" TextColor="#E6E6E6" FontSize="15" />
                        </Grid>

                    </VerticalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
