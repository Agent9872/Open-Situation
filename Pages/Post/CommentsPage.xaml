      Fill="{Binding LoveIconColor}" Stroke="{Binding LoveIconColor}"
      StrokeThickness="1" HeightRequest="14" WidthRequest="14" Aspect="Uniform" />
                                    <Label Text="{Binding LoveCountDisplay}"
       TextColor="{Binding LoveIconColor}"
       FontSize="12" FontAttributes="Bold" VerticalOptions="Center"
       IsVisible="{Binding LoveCount, Converter={StaticResource GreaterThanZeroConverter}}" />
                                </HorizontalStackLayout>
                            </Border>
                            <!-- Spark Button -->
                            <Border BackgroundColor="#0E0E12" StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 20" Padding="12,7">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSparkPostTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="⚡" FontSize="14" TextColor="{Binding SparkIconColor}" VerticalOptions="Center" />
                                    <Label Text="{Binding SparkCountDisplay}"
                               TextColor="{Binding SparkIconColor}"
                               FontSize="12" FontAttributes="Bold"
                               VerticalOptions="Center"
                               IsVisible="{Binding SparkCount, Converter={StaticResource GreaterThanZeroConverter}}" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Share Button -->
                            <Border BackgroundColor="#0E0E12" StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 20" Padding="12,7">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSharePostTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
