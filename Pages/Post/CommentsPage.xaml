                        </HorizontalStackLayout>
                    </ScrollView>

                </VerticalStackLayout>
            </Grid>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid x:Name="MainGrid" RowDefinitions="*,Auto" BackgroundColor="#0E0E12">

        <!-- Scrollable content -->
        <ScrollView Grid.Row="0" BackgroundColor="#0E0E12">
            <VerticalStackLayout Spacing="0" Padding="16,8,16,16">

                <ContentView x:Name="PostHeaderContainer" />

                <!-- Comments header -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,20,0,10">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Path Data="M269-428.5h422V-454H269v25.5Zm0-119h422V-573H269v25.5Zm0-119h422V-692H269v25.5Zm554 479-109-109H194.28q-24.22 0-40.75-16.53T137-353.8v-412.4q0-24.24 16.53-40.77 16.53-16.53 40.75-16.53h571.44q24.22 0 40.75 16.53T823-766.06v578.56ZM194.5-322H725l72.5 73v-517q0-12-10-22t-22-10h-571q-12 0-22 10t-10 22v412q0 12 10 22t22 10Zm-32 0v-476 476Z"
                              Fill="#F0EDE8"
                              HeightRequest="16" WidthRequest="16"
                              VerticalOptions="Center" Aspect="Uniform" />
                        <Label Text="Comments"
                               FontAttributes="Bold" FontSize="16"
                               TextColor="#F0EDE8"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Grid.Column="1"
                           Text="{Binding Comments.Count, StringFormat='{0} total'}"
                           FontSize="11" TextColor="#5A5A6A"
                           VerticalOptions="Center" />
                </Grid>

                <!-- Divider -->
                <BoxView HeightRequest="1" BackgroundColor="#1C1C25" Margin="0,0,0,4" />

                <!-- Comments CollectionView -->
                <CollectionView x:Name="CommentsCollectionView"
                                ItemsSource="{Binding Comments}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="10"
                                             Padding="0,40,0,40">
                            <Path Data="M269-428.5h422V-454H269v25.5Zm0-119h422V-573H269v25.5Zm0-119h422V-692H269v25.5Zm554 479-109-109H194.28q-24.22 0-40.75-16.53T137-353.8v-412.4q0-24.24 16.53-40.77 16.53-16.53 40.75-16.53h571.44q24.22 0 40.75 16.53T823-766.06v578.56ZM194.5-322H725l72.5 73v-517q0-12-10-22t-22-10h-571q-12 0-22 10t-10 22v412q0 12 10 22t22 10Zm-32 0v-476 476Z"
                                  Fill="#2A2A38"
                                  HeightRequest="36" WidthRequest="36"
                                  HorizontalOptions="Center" Aspect="Uniform" />
                            <Label Text="No comments yet"
                                   FontAttributes="Bold" FontSize="15"
                                   TextColor="#F0EDE8"
                                   HorizontalOptions="Center" />
                            <Label Text="Be the first to start the conversation"
                                   FontSize="12" TextColor="#5A5A6A"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Discover People -->
                <VerticalStackLayout x:Name="DiscoverSection" Spacing="0" Margin="0,28,0,0">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Path Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"
                                  Fill="#F0EDE8"
                                  HeightRequest="14" WidthRequest="14"
                                  VerticalOptions="Center" Aspect="Uniform" />
                            <Label Text="Discover People"
                                   FontSize="16" FontAttributes="Bold"
                                   TextColor="#F0EDE8" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="See all →"
                               FontSize="12" TextColor="#00B5B5"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSeeAllTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#1C1C25" Margin="0,0,0,12" />

                    <ScrollView Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never"
                                VerticalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="SuggestedUsersLayout"
                                               Spacing="12"
                                               Padding="2,4,2,16"
                                               VerticalOptions="Start" />
                    </ScrollView>
                </VerticalStackLayout>

                <BoxView HeightRequest="20" BackgroundColor="Transparent" />

            </VerticalStackLayout>
        </ScrollView>

        <!--
  ╔══════════════════════════════════════════════════════╗
  ║   LOADING OVERLAY — AMORE DATING APP                ║
  ║   Brand: #FF3B6F  |  Dark: #0B0B10  |  Surface: #12121A
  ╚══════════════════════════════════════════════════════╝

  DROP THIS INSIDE YOUR PAGE'S ROOT GRID (last child = top layer)
  Grid must have: RowDefinitions with at least the rows your page uses.
  Set Grid.RowSpan to cover the full page.
-->

        <!-- ── Loading Overlay ── -->
        <Grid x:Name="LoadingOverlay"
      Grid.Row="0"
      Grid.RowSpan="2"
      BackgroundColor="#0B0B10"
      ZIndex="9999"
      IsVisible="True">

            <!-- Ambient glow — soft radial behind the logo -->
            <Ellipse
        WidthRequest="260"
        HeightRequest="260"
        HorizontalOptions="Center"
        VerticalOptions="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                        <GradientStop Color="#1AFF3B6F" Offset="0.0"/>
                        <GradientStop Color="#00FF3B6F" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Content stack -->
            <VerticalStackLayout
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Spacing="0">

                <!-- ── Logo mark ── -->
                <Grid
            WidthRequest="80"
            HeightRequest="80"
            HorizontalOptions="Center"
            Margin="0,0,0,24">

                    <!-- Outer spinning ring -->
                    <Ellipse
                x:Name="SpinRing"
                WidthRequest="80"
                HeightRequest="80"
                Stroke="#33FF3B6F"
                StrokeThickness="1.5"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

                    <!-- Rotating accent dot on the ring -->
                    <Ellipse
                x:Name="RingDot"
                WidthRequest="7"
                HeightRequest="7"
                Fill="#FF3B6F"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,0,0,0">
                        <!-- Shadow approximated via overlapping ellipses in code-behind -->
                    </Ellipse>

                    <!-- Heart icon centred -->
                    <Image
                Source="heart_solid.png"
                WidthRequest="28"
                HeightRequest="28"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                x:Name="HeartIcon">
                        <!-- Tint applied via code-behind:
                     HeartIcon.SetAppThemeColor(TintColorProperty, Color.FromArgb("#FF3B6F"), …) -->
                    </Image>
                </Grid>

                <!-- App name -->
                <Label
            Text="OS"
            FontFamily="CormorantGaramond-Light"
            FontSize="32"
            TextColor="#F5F0FF"
            CharacterSpacing="2"
            HorizontalOptions="Center"
            Margin="0,0,0,4"/>

                <!-- Tagline -->
                <Label
            Text="FIND YOUR PERSON"
            FontFamily="DMSans-Regular"
            FontSize="10"
            TextColor="#5A5A72"
            CharacterSpacing="4"
            HorizontalOptions="Center"
            Margin="0,0,0,44"/>

                <!-- ── Dot-bar indicator ── -->
                <HorizontalStackLayout
            x:Name="DotBar"
            HorizontalOptions="Center"
            Spacing="8">
                    <Ellipse x:Name="Dot1" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                    <Ellipse x:Name="Dot2" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                    <Ellipse x:Name="Dot3" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                    <Ellipse x:Name="Dot4" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                    <Ellipse x:Name="Dot5" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Hint at bottom -->
            <Label
        Text="Loading your matches"
        FontFamily="DMSans-Regular"
        FontSize="10"
        TextColor="#3A3A4C"
        CharacterSpacing="3"
        HorizontalOptions="Center"
        VerticalOptions="End"
        Margin="0,0,0,52"/>

        </Grid>


        <!-- Bottom Input Area -->
        <Grid Grid.Row="1"
      BackgroundColor="#0E0E12"
      Padding="12,8,12,12">

            <!-- Top Divider -->
            <BoxView HeightRequest="1"
             BackgroundColor="#1C1C25"
             VerticalOptions="Start"
             HorizontalOptions="Fill" />

            <!-- Input Container -->
            <Border StrokeThickness="1"
            Stroke="#2A2A38"
            StrokeShape="RoundRectangle 24"
            BackgroundColor="#0E0E12"
            Padding="14,0"
            Margin="0,6,0,0">

                <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="8">

                    <!-- Editor -->
                    <Editor x:Name="CommentEditor"
                    Grid.Column="0"
                    Placeholder="Add a comment..."
                    AutoSize="TextChanges"
                    MinimumHeightRequest="44"
                    BackgroundColor="Transparent"
                    TextColor="#F0EDE8"
                    PlaceholderColor="#3A3A4A"
                    FontSize="14"
                    VerticalOptions="Center" />

                    <!-- Send Button INSIDE the input -->
                    <Border Grid.Column="1"
                    WidthRequest="38"
                    HeightRequest="38"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 19"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    Margin="6,0,0,0">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00B5B5" Offset="0" />
                                <GradientStop Color="#008080" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSendButtonClicked" />
                        </Border.GestureRecognizers>

                        <!-- Paper Plane Send Icon -->
                        <Path Data="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                      Fill="White"
                      HeightRequest="16"
                      WidthRequest="16"
                      HorizontalOptions="Center"
                      VerticalOptions="Center"
                      Aspect="Uniform" />
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</ContentPage>