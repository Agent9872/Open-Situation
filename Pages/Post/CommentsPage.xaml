<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lock.Models"
             xmlns:conv="clr-namespace:Lock.Converter.Post"
             xmlns:local="clr-namespace:Lock.Pages.Post"
             x:Class="Lock.Pages.Post.CommentsPage"
             Title="Comments"
             BackgroundColor="#0E0E12">

    <ContentPage.Resources>
        <conv:LoveIconColorConverter x:Key="LoveIconColorConverter" />
        <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
        <conv:ListNotEmptyConverter x:Key="ListNotEmptyConverter" />
        <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
        <conv:CommentCountConverter x:Key="CommentCountConverter" />
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <local:ImagePathConverter x:Key="ImagePathConverter" />
        <local:DefaultImageConverter x:Key="DefaultImageConverter" />

        <!-- ===== COMMENT WITH ACTIONS TEMPLATE ===== -->
        <DataTemplate x:Key="CommentWithActionsTemplate">
            <VerticalStackLayout Spacing="0">
                <Border BackgroundColor="#0E0E12"
                        StrokeThickness="1" Stroke="#1C1C25"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12"
                        Margin="0,6,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Avatar -->
                        <Grid Grid.Column="0" Grid.Row="0"
                              WidthRequest="40" HeightRequest="40"
                              VerticalOptions="Start">
                            <Ellipse WidthRequest="40" HeightRequest="40" StrokeThickness="2">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF3B6F" Offset="0" />
                                        <GradientStop Color="#00B5B5" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Frame WidthRequest="34" HeightRequest="34"
                                   CornerRadius="17" Padding="0"
                                   IsClippedToBounds="True" HasShadow="False"
                                   BackgroundColor="#1C1C25" BorderColor="Transparent"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="{Binding AuthorProfileImagePath}"
                                       Aspect="AspectFill"
                                       HeightRequest="34" WidthRequest="34" />
                            </Frame>
                        </Grid>

                        <!-- Name + time + content -->
                        <VerticalStackLayout Grid.Column="1" Grid.Row="0"
                                             Spacing="4" VerticalOptions="Start">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAuthorNameTapped"
                                                          CommandParameter="{Binding .}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="{Binding AuthorDisplayName}"
                                       FontAttributes="Bold"
                                       TextColor="#F0EDE8"
                                       FontSize="14" VerticalOptions="Center" />
                                <Label Text="·" FontSize="12" TextColor="#3A3A4A"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding CreatedAtRelative}"
                                       TextColor="#00B5B5"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Content}"
                                   TextColor="#D0CEC8"
                                   FontSize="14"
                                   LineHeight="1.5"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <!-- Three-dot menu -->
                        <Button Grid.Column="2" Grid.Row="0"
                                Text="⋮"
                                FontSize="18"
                                BackgroundColor="Transparent"
                                TextColor="#5A5A6A"
                                WidthRequest="32" HeightRequest="32"
                                VerticalOptions="Start"
                                HorizontalOptions="End"
                                IsVisible="{Binding IsOwnedByCurrentUser}"
                                Clicked="OnMenuButtonClicked"
                                CommandParameter="{Binding .}" />

                        <!-- Love + Reply actions -->
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Spacing="4"
                                               Margin="0,8,0,0"
                                               HorizontalOptions="Start">
                            <!-- Love Button -->
                            <Border BackgroundColor="#0E0E12" StrokeThickness="1" Stroke="#2A2A38"
                                    StrokeShape="RoundRectangle 16" Padding="10,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLoveTapped"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="❤️" 
                                           FontSize="15"
                                           TextColor="{Binding LoveIconColor}"
                                           VerticalOptions="Center" 
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding LoveCountDisplay}"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="{Binding LoveIconColor}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Reply Button -->
                            <Border BackgroundColor="#0E0E12" StrokeThickness="1" Stroke="#2A2A38"
                                    StrokeShape="RoundRectangle 16" Padding="10,5">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnReplyTapped"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Path Data="M269-428.5h422V-454H269v25.5Zm0-119h422V-573H269v25.5Zm0-119h422V-692H269v25.5Zm554 479-109-109H194.28q-24.22 0-40.75-16.53T137-353.8v-412.4q0-24.24 16.53-40.77 16.53-16.53 40.75-16.53h571.44q24.22 0 40.75 16.53T823-766.06v578.56ZM194.5-322H725l72.5 73v-517q0-12-10-22t-22-10h-571q-12 0-22 10t-10 22v412q0 12 10 22t22 10Zm-32 0v-476 476Z"
                                          Fill="#5A5A6A"
                                          HeightRequest="14" WidthRequest="14"
                                          HorizontalOptions="Center" VerticalOptions="Center"
                                          Aspect="Uniform" />
                                    <Label Text="Reply"
                                           FontSize="11" FontAttributes="Bold"
                                           TextColor="#5A5A6A"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <!-- ===== SIMPLE COMMENT TEMPLATE ===== -->
        <DataTemplate x:Key="CommentTemplate">
            <VerticalStackLayout Spacing="0">
                <Border BackgroundColor="#0E0E12"
                        StrokeThickness="1" Stroke="#1C1C25"
                        StrokeShape="RoundRectangle 16"
                        Padding="14,12"
                        Margin="0,6,0,0">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Grid Grid.Column="0"
                              WidthRequest="40" HeightRequest="40"
                              VerticalOptions="Start">
                            <Ellipse WidthRequest="40" HeightRequest="40" StrokeThickness="2">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF3B6F" Offset="0" />
                                        <GradientStop Color="#00B5B5" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Frame WidthRequest="34" HeightRequest="34"
                                   CornerRadius="17" Padding="0"
                                   IsClippedToBounds="True" HasShadow="False"
                                   BackgroundColor="#1C1C25" BorderColor="Transparent"
                                   HorizontalOptions="Center" VerticalOptions="Center">
                                <Image Source="{Binding AuthorProfileImagePath}"
                                       Aspect="AspectFill"
                                       HeightRequest="34" WidthRequest="34" />
                            </Frame>
                        </Grid>

                        <!-- Name + time + content -->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4" VerticalOptions="Start">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAuthorNameTapped"
                                                          CommandParameter="{Binding .}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="{Binding AuthorDisplayName}"
                                       FontAttributes="Bold"
                                       TextColor="#F0EDE8"
                                       FontSize="14" VerticalOptions="Center" />
                                <Label Text="·" FontSize="12" TextColor="#3A3A4A"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding CreatedAtRelative}"
                                       TextColor="#00B5B5"
                                       FontSize="11"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Content}"
                                   TextColor="#D0CEC8"
                                   FontSize="14"
                                   LineHeight="1.5"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </DataTemplate>

        <!-- ===== POST HEADER TEMPLATE ===== -->
        <DataTemplate x:Key="PostHeaderTemplate">
            <Grid>
                <BoxView WidthRequest="3" BackgroundColor="#00B5B5" Opacity="0.25"
                         HorizontalOptions="Start" VerticalOptions="Fill" />

                <VerticalStackLayout Spacing="0" Padding="14,12,14,0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCommentButtonTapped" CommandParameter="{Binding .}" />
                    </VerticalStackLayout.GestureRecognizers>

                    <Grid ColumnDefinitions="46,*" ColumnSpacing="10">
                        <!-- Avatar -->
                        <Grid Grid.Column="0" WidthRequest="42" HeightRequest="42">
                            <Ellipse WidthRequest="42" HeightRequest="42" StrokeThickness="2">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FF3B6F" Offset="0" />
                                        <GradientStop Color="#00B5B5" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Frame WidthRequest="36" HeightRequest="36"
                                   CornerRadius="18" Padding="0"
                                   IsClippedToBounds="True" HasShadow="False"
                                   BackgroundColor="#1C1C25" BorderColor="Transparent"
                                   VerticalOptions="Center" HorizontalOptions="Center">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAuthorNameTapped" CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Image Source="{Binding AuthorProfileImagePath}" Aspect="AspectFill"
                                       HeightRequest="36" WidthRequest="36" />
                            </Frame>
                            <Ellipse WidthRequest="10" HeightRequest="10" Fill="#22C55E"
                                     HorizontalOptions="End" VerticalOptions="End" Margin="0,0,1,1" />
                        </Grid>

                        <!-- Name and info -->
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding AuthorDisplayName}"
                                       FontAttributes="Bold" FontSize="14" TextColor="#F0EDE8" />
                                <Border BackgroundColor="#2A1520" StrokeThickness="1" Stroke="#FF3B6F"
                                        StrokeShape="RoundRectangle 8" Padding="7,2"
                                        IsVisible="{Binding AuthorMood, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                                    <Label Text="{Binding AuthorMood}" FontSize="10"
                                           FontAttributes="Bold" TextColor="#FF3B6F" />
                                </Border>
                                <Label Text="·" FontSize="12" TextColor="#3A3A4A" />
                                <Label Text="{Binding CreatedAtRelative}" FontSize="11" TextColor="#00B5B5" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding AuthorPhone}" FontSize="11" TextColor="#008080" />
                                <Label Text="·" FontSize="11" TextColor="#3A3A4A"
                                       IsVisible="{Binding MatchPercent, Converter={StaticResource GreaterThanZeroConverter}}" />
                                <Label FontSize="11" FontAttributes="Bold" TextColor="#22C55E"
                                       IsVisible="{Binding MatchPercent, Converter={StaticResource GreaterThanZeroConverter}}">
                                    <Label.Text>
                                        <Binding Path="MatchPercent" StringFormat="{}{0}% match" />
                                    </Label.Text>
                                </Label>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <!-- Menu -->
                        <Grid Grid.Column="2"
                              WidthRequest="32" HeightRequest="32"
                              HorizontalOptions="End" VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPostMenuButtonClicked"
                                                      CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Path Data="M264-452q-11.55 0-19.77-8.23Q236-468.45 236-480q0-11.55 8.23-19.77Q252.45-508 264-508q11.55 0 19.77 8.23Q292-491.55 292-480q0 11.55-8.23 19.77Q275.55-452 264-452Zm216 0q-11.55 0-19.77-8.23Q452-468.45 452-480q0-11.55 8.23-19.77Q468.45-508 480-508q11.55 0 19.77 8.23Q508-491.55 508-480q0 11.55-8.23 19.77Q491.55-452 480-452Zm216 0q-11.55 0-19.78-8.23Q668-468.45 668-480q0-11.55 8.22-19.77Q684.45-508 696-508t19.78 8.23Q724-491.55 724-480q0 11.55-8.22 19.77Q707.55-452 696-452Z"
                                  Fill="#7A7A8C"
                                  HeightRequest="20" WidthRequest="20"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  Aspect="Uniform" />
                        </Grid>
                    </Grid>

                    <!-- Post Content Area -->
                    <VerticalStackLayout Spacing="8" Margin="0,10,0,0">
                        <!-- Category -->
                        <Border BackgroundColor="#1A0D20" StrokeThickness="1" Stroke="#FF3B6F"
                                StrokeShape="RoundRectangle 10" Padding="9,4"
                                HorizontalOptions="Start"
                                IsVisible="{Binding Category, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="💝" FontSize="11" />
                                <Label Text="{Binding Category}" FontSize="11"
                                       FontAttributes="Bold" TextColor="#FF3B6F" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Post Text + Images + Link Preview -->
                        <Border StrokeThickness="0" Stroke="#2A2A38"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="Transparent"
                                Padding="16,10,12,10"
                                Margin="0,8,0,8">
                            <VerticalStackLayout Spacing="6">
                                <!-- Post text -->
                                <Label FontSize="14" LineBreakMode="WordWrap"
       TextColor="#F0EDE8" LineHeight="1.5"
       FormattedText="{Binding ToggleFormatted}"
       IsVisible="{Binding NeedsToggle}" />

                                <Label FontSize="14" LineBreakMode="WordWrap"
       TextColor="#F0EDE8" LineHeight="1.5"
       FormattedText="{Binding DisplayFormatted}"
       IsVisible="{Binding NeedsToggle, Converter={StaticResource InverseBoolConverter}}" />

                                <!-- Read more toggle -->
                                <Label Text="{Binding DisplayToggleText}"
                                       FontSize="12" FontAttributes="Bold"
                                       TextColor="#60A5FA"
                                       IsVisible="{Binding NeedsToggle}"
                                       HorizontalOptions="Start">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToggleExpandClicked"
                                                              CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <!-- Images ScrollView -->
                                <ScrollView Orientation="Horizontal" HeightRequest="260"
                                            HorizontalScrollBarVisibility="Never"
                                            Margin="0,4,0,0"
                                            IsVisible="{Binding ImagePathsList, Converter={StaticResource ListNotEmptyConverter}}">
                                    <HorizontalStackLayout Spacing="6" Padding="0,0,4,0">
                                        <BindableLayout.ItemsSource>
                                            <Binding Path="ImagePathsList" />
                                        </BindableLayout.ItemsSource>
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Frame WidthRequest="175" HeightRequest="250"
                                                       CornerRadius="14" Padding="0"
                                                       IsClippedToBounds="True" HasShadow="False"
                                                       BackgroundColor="#1C1C25" BorderColor="#2A2A38">
                                                    <Frame.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnPostImageTapped"
                                                                              CommandParameter="{Binding .}" />
                                                    </Frame.GestureRecognizers>
                                                    <Image Source="{Binding .}" Aspect="AspectFill"
                                                           HeightRequest="250" WidthRequest="175" />
                                                </Frame>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>

                                <!-- Link Preview -->
                                <Border BackgroundColor="#13131A"
                                        StrokeThickness="1" Stroke="#2A2A38"
                                        StrokeShape="RoundRectangle 14"
                                        Padding="0"
                                        IsVisible="{Binding HasLinkPreview}"
                                        Margin="0,8,0,4">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLinkPreviewTapped"
                                                              CommandParameter="{Binding FirstUrl}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="0">
                                        <Image Source="{Binding PreviewImageUrl}"
                                               Aspect="AspectFill" HeightRequest="160"
                                               HorizontalOptions="Fill"
                                               IsVisible="{Binding PreviewHasImage}"
                                               BackgroundColor="#1C1C25" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                                              Padding="12,10" BackgroundColor="#13131A">
                                            <Image Grid.Column="0" Source="{Binding PreviewFaviconUrl}"
                                                   WidthRequest="16" HeightRequest="16"
                                                   Aspect="AspectFit" VerticalOptions="Start" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label Text="{Binding PreviewSiteName}"
                                                       FontSize="10" FontAttributes="Bold"
                                                       TextColor="#00B5B5"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding PreviewTitle}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="#F0EDE8"
                                                       LineBreakMode="TailTruncation" MaxLines="2" />
                                                <Label Text="{Binding PreviewDescription}"
                                                       FontSize="11" TextColor="#8A8A9A"
                                                       LineBreakMode="TailTruncation" MaxLines="2"
                                                       IsVisible="{Binding PreviewDescription,
                                                           Converter={StaticResource StringNotNullOrEmptyConverter}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <BoxView HeightRequest="1" BackgroundColor="#1C1C25" Margin="0,2,0,0" />
                    </VerticalStackLayout>

                    <!-- INTERACTION BAR WITH LOVE BUTTON -->
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Margin="0,6,0,10">
                        <HorizontalStackLayout Spacing="6">

                            <!-- Comment Button -->
                            <Border BackgroundColor="#0E0E12" StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 20" Padding="12,7">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCommentButtonTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
                                    <Path Data="M269-428.5h422V-454H269v25.5Zm0-119h422V-573H269v25.5Zm0-119h422V-692H269v25.5Zm554 479-109-109H194.28q-24.22 0-40.75-16.53T137-353.8v-412.4q0-24.24 16.53-40.77 16.53-16.53 40.75-16.53h571.44q24.22 0 40.75 16.53T823-766.06v578.56ZM194.5-322H725l72.5 73v-517q0-12-10-22t-22-10h-571q-12 0-22 10t-10 22v412q0 12 10 22t22 10Zm-32 0v-476 476Z"
                              Fill="#7A7A8C" Stroke="#7A7A8C" StrokeThickness="1"
                              HeightRequest="14" WidthRequest="14" Aspect="Uniform" />
                                    <Label TextColor="#7A7A8C" FontSize="12" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Text>
                                            <Binding Path="CommentCount" StringFormat="{}{0}" FallbackValue="0" />
                                        </Label.Text>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Love Button for Post -->
                            <Border BackgroundColor="#0E0E12" StrokeThickness="1" Stroke="#2A2A38"
StrokeShape="RoundRectangle 20" Padding="12,7">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLovePostTapped" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5">
