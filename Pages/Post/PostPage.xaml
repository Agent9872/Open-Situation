                                    <BoxView HeightRequest="8"
                             BackgroundColor="#0A0A0E"
                             HorizontalOptions="Fill"
                             Margin="0,10,0,10" />
                                </VerticalStackLayout>
                                <BoxView HeightRequest="8" BackgroundColor="Transparent" />
