                                                     BackgroundColor="#2A2A38" Margin="4" />
                                            <BoxView Grid.Column="2" HeightRequest="30" CornerRadius="15"
                                                     BackgroundColor="#2A2A38" Margin="4" />
                                            <BoxView Grid.Column="3" HeightRequest="30" CornerRadius="15"
                                                     BackgroundColor="#2A2A38" Margin="4" />
                                            <BoxView Grid.Column="4" HeightRequest="30" CornerRadius="15"
