                    <GradientStop Color="#00B5B5" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="NewPostsPill_Tapped" />
            </Border.GestureRecognizers>

            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">

                <!-- Stacked avatars Twitter-style -->
                <Grid WidthRequest="64" HeightRequest="28" VerticalOptions="Center">

