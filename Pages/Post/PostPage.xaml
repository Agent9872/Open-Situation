══════════════════════════════════════════════════ -->
        <Border x:Name="NewPostsPill"
        Grid.Row="1"
        IsVisible="False"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 24"
        Padding="10,8,16,8"
        HorizontalOptions="Center"
        VerticalOptions="Start"
        Margin="0,12,0,0"
        ZIndex="100">
            <Border.Background>
