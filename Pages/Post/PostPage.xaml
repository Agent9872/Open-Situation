                                                     WidthRequest="38" HeightRequest="38"
                                                     CornerRadius="19"
                                                     BackgroundColor="#2A2A38" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                                <BoxView HeightRequest="13" WidthRequest="110"
                                                         CornerRadius="6"
                                                         BackgroundColor="#2A2A38"
                                                         HorizontalOptions="Start" />
                                                <BoxView HeightRequest="10" WidthRequest="80"
                                                         CornerRadius="5"
                                                         BackgroundColor="#2A2A38"
                                                         HorizontalOptions="Start" />
                                            </VerticalStackLayout>
                                            <BoxView Grid.Column="2"
                                                     WidthRequest="28" HeightRequest="28"
                                                     CornerRadius="14"
                                                     BackgroundColor="#2A2A38" />
