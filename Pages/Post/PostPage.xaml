            BackgroundColor="#555"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            TranslationX="20"
            IsVisible="False"
            Padding="0">
                        <Grid HeightRequest="28" WidthRequest="28" IsClippedToBounds="True">
                            <Image x:Name="PillAvatarImage3"
                   Aspect="AspectFill"
                   HeightRequest="28"
                   WidthRequest="28"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill">
                                <Image.Clip>
                                    <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Avatar 2 (middle) -->
                    <Border x:Name="PillAvatar2"
            HeightRequest="28" WidthRequest="28"
            StrokeThickness="1.5" Stroke="White"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#555"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            TranslationX="10"
            IsVisible="False"
            Padding="0">
                        <Grid HeightRequest="28" WidthRequest="28" IsClippedToBounds="True">
                            <Image x:Name="PillAvatarImage2"
                   Aspect="AspectFill"
                   HeightRequest="28"
                   WidthRequest="28"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill">
                                <Image.Clip>
                                    <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                    <!-- Avatar 1 (front) -->
                    <Border x:Name="PillAvatar1"
            HeightRequest="28" WidthRequest="28"
            StrokeThickness="1.5" Stroke="White"
            StrokeShape="RoundRectangle 14"
            BackgroundColor="#777"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            TranslationX="0"
            Padding="0">
                        <Grid HeightRequest="28" WidthRequest="28" IsClippedToBounds="True">
                            <Image x:Name="PillAvatarImage1"
                   Aspect="AspectFill"
                   HeightRequest="28"
                   WidthRequest="28"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill">
                                <Image.Clip>
                                    <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14" />
                                </Image.Clip>
                            </Image>
                        </Grid>
                    </Border>

                </Grid>

                <!-- Label -->
                <Label x:Name="NewPostsPillLabel"
               Text="new posts"
               TextColor="White"
               FontSize="13"
               FontAttributes="Bold"
               VerticalOptions="Center" />

                <!-- Arrow up icon -->
                <Label Text="↑"
               TextColor="White"
               FontSize="13"
               FontAttributes="Bold"
               VerticalOptions="Center" />

            </HorizontalStackLayout>
        </Border>

