<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Lock.Models;assembly=Lock"
             xmlns:conv="clr-namespace:Lock.Converter.Post"
             xmlns:local="clr-namespace:Lock.Pages.Post"
             x:Class="Lock.Pages.Post.PostPage"
             BackgroundColor="#0E0E12">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
            <conv:BoolToSearchIconConverter x:Key="BoolToSearchIconConverter" />
            <conv:BoolToResultColorConverter x:Key="BoolToResultColorConverter" />
            <conv:BoolToResultCountColorConverter x:Key="BoolToResultCountColorConverter" />
            <conv:BoolToTealColorConverter x:Key="BoolToTealColorConverter" />
            <conv:ListNotEmptyConverter x:Key="ListNotEmptyConverter" />
            <conv:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
            <conv:BoolToMarginConverter x:Key="BoolToMarginConverter" />
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <conv:CommentCountConverter x:Key="CommentCountConverter" />
            
            
            <!-- ═══════════════════════════════════════════════════════════
                 USER HEADER TEMPLATE  (Stories / Status row)
            ═══════════════════════════════════════════════════════════ -->
            <DataTemplate x:Key="UserHeaderTemplate">

                <Grid ColumnDefinitions="44,*,Auto" 
          ColumnSpacing="12" 
          Padding="14,8,14,8"
          HeightRequest="68">

                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="UserHeaderTapped"
                                  CommandParameter="{Binding Phone}" />
                    </Grid.GestureRecognizers>

                    <!-- Avatar with gradient ring -->
                    <Grid Grid.Column="0" WidthRequest="42" HeightRequest="42">
                        <Ellipse WidthRequest="42" HeightRequest="42"
                     StrokeThickness="2.8">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF3B6F" Offset="0" />
                                    <GradientStop Color="#00B5B5" Offset="1" />
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                        </Ellipse>

                        <Frame WidthRequest="36" HeightRequest="36"
                   CornerRadius="18" 
                   Padding="0"
                   IsClippedToBounds="True" 
                   HasShadow="False"
                   BackgroundColor="#1C1C25"
                   BorderColor="Transparent"
                   VerticalOptions="Center"
                   HorizontalOptions="Center">
                            <Image Source="{Binding ProfileImagePath}"
                       Aspect="AspectFill"
                       HeightRequest="36" 
                       WidthRequest="36" />
                        </Frame>
                    </Grid>

                    <!-- Text Content -->
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">

                        <!-- Row 1: Author Name + Verification Badge + Time (NO mood here) -->
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="{Binding AuthorDisplayName}"
               FontAttributes="Bold"
               FontSize="14"
               TextColor="#F0EDE8" />

                            <!-- Verification Badge -->
                            <Border BackgroundColor="Transparent"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="0"
                Margin="0"
                VerticalOptions="Center"
                IsVisible="{Binding IsAuthorVerified}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPostAuthorVerificationTapped"
                                      CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Path Data="m366-126-64-108-122-26 12-126-82-94 82-94-12-126 122-26 64-108 114 48 114-48 64 108 122 26-12 126 82 94-82 94 12 126-122 26-64 108-114-48-114 48Zm12-36 102-42 102 42 58-96 110-24-10-114 74-84-74-84 10-114-110-24-58-96-102 42-102-42-58 96-110 24 10 114-74 84 74 84-10 114 110 24 58 96Zm102-318Zm-42 106 190-190-20-20-170 170-86-86-20 20 106 106Z"
                  Fill="#00B5B5"
                  Stroke="#00B5B5"
                  StrokeThickness="1.5"
                  WidthRequest="16"
                  HeightRequest="16"
                  Aspect="Uniform"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
                            </Border>

                            <Label Text="·" FontSize="12" TextColor="#3A3A4A" />
                            <Label Text="{Binding CreatedAtRelative}" FontSize="11" TextColor="#00B5B5" />
                        </HorizontalStackLayout>

                        <!-- Row 2: MOOD TAG - directly under author name -->
                        <Border BackgroundColor="#2A1520" 
            StrokeThickness="1" 
            Stroke="#FF3B6F"
            StrokeShape="RoundRectangle 8" 
            Padding="7,2"
            HorizontalOptions="Start"
            IsVisible="{Binding AuthorMood, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                            <Label Text="{Binding AuthorMood}" 
               FontSize="10"
               FontAttributes="Bold" 
               TextColor="#FF3B6F" />
                        </Border>

                        <!-- Row 3: Phone + Match info -->
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label Text="{Binding AuthorPhone}" FontSize="11" TextColor="#008080" />

                            <Label Text="·" FontSize="11" TextColor="#3A3A4A"
               IsVisible="{Binding MatchPercent, Converter={StaticResource GreaterThanZeroConverter}}" />

                            <Label FontSize="11" FontAttributes="Bold" TextColor="#22C55E"
               IsVisible="{Binding MatchPercent, Converter={StaticResource GreaterThanZeroConverter}}">
                                <Label.Text>
                                    <Binding Path="MatchPercent" StringFormat="{}{0}% match" />
                                </Label.Text>
                            </Label>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <!-- FLOATING ADD STORY BUTTON (Top-Right) - Now clearly visible -->
                    <Grid Grid.Column="2"
              WidthRequest="32" 
              HeightRequest="32"
              HorizontalOptions="End"
              VerticalOptions="Center"
              Margin="4,0,0,0">

                       
                    </Grid>

                </Grid>
            </DataTemplate>
            
            
