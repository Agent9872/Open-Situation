<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             xmlns:local="clr-namespace:Lock.Pages.Post"
             xmlns:conv="clr-namespace:Lock.Converter.Post"
             x:Class="Lock.Pages.Post.SearchPage"
             BackgroundColor="#0E0E12"
             Padding="0"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <local:ImagePathConverter x:Key="ImagePathConverter" />
        <local:DefaultImageConverter x:Key="DefaultImageConverter" />
        <conv:BoolToRedConverter x:Key="BoolToRedConverter" />
        <conv:BoolToTealConverter x:Key="BoolToTealConverter" />
        <conv:DrinkColorConverter x:Key="DrinkColorConverter" />
        <conv:StringTruncateConverter x:Key="StringTruncateConverter" />
        <conv:JoinListToStringConverter x:Key="JoinListToStringConverter" />
        <conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*" RowSpacing="0">

        <!-- ══ ROW 0 · HEADER ══ -->
        <Grid Grid.Row="0"
              Padding="16,52,16,12"
              BackgroundColor="#0E0E12"
              ColumnDefinitions="*,Auto">

            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                <Label Text="Discover"
                       FontSize="28" FontAttributes="Bold"
                       TextColor="#F0EDE8" />
                <HorizontalStackLayout Spacing="6">
                    <Path Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"
                          Fill="#5A5A6A"
                          HeightRequest="10" WidthRequest="10"
                          VerticalOptions="Center" Aspect="Uniform" />
                    <Label Text="Find your connection"
                           FontSize="12" TextColor="#5A5A6A"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Match button top right -->
            <Border Grid.Column="1"
        BackgroundColor="#2A1520"
        StrokeThickness="1"
        Stroke="#FF3B6F"
        StrokeShape="RoundRectangle 8"
        Padding="12,6"
        VerticalOptions="Center">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnMatchHeaderTapped" />
                    <!-- Changed from OnMatchTabClicked -->
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="5">
                    <Label Text="✦" FontSize="11" TextColor="#FF3B6F" VerticalOptions="Center" />
                    <Label Text="Match" FontSize="12" FontAttributes="Bold"
               TextColor="#FF3B6F" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ══ ROW 1 · SEARCH BAR ══ -->
        <Border Grid.Row="1"
                BackgroundColor="#16161C"
                StrokeThickness="1"
                Stroke="#2A2A38"
                StrokeShape="RoundRectangle 16"
                Margin="16,0,16,10"
                Padding="10,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                <Path Grid.Column="0"
                      Data="m775.5-168.5-247.77-248Q498-390.5 459-376.75T383.16-363q-91.13 0-153.9-62.98-62.76-62.97-62.76-153.5 0-90.52 62.7-153.52 62.71-63 153.5-63 90.8 0 153.8 63.01 63 63 63 153.57 0 40.42-15 79.42T546-434.29L794-187l-18.5 18.5Z"
                      Fill="#5A5A6A"
                      HeightRequest="16" WidthRequest="16"
                      VerticalOptions="Center" Aspect="Uniform" />
                <SearchBar Grid.Column="1"
                           x:Name="SearchBar"
                           Placeholder="Name, mood, location..."
                           PlaceholderColor="#3A3A4A"
                           TextColor="#F0EDE8"
                           BackgroundColor="Transparent"
                           CancelButtonColor="#FF3B6F"
                           FontSize="14"
                           HeightRequest="48"
                           SearchButtonPressed="OnSearch"
                           TextChanged="OnTextChanged" />
            </Grid>
        </Border>

        <!-- ══ ROW 2 · TAB CHIPS ══ -->
        <ScrollView Grid.Row="2"
                    x:Name="TabScrollView"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never"
                    HeightRequest="40"
                    Margin="0,0,0,8">
            <HorizontalStackLayout Spacing="8" Padding="16,0,16,0" VerticalOptions="Center">

                <Border x:Name="AllTabFrame"
                        BackgroundColor="#00B5B5"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Button x:Name="AllTab" Text="All" Clicked="TabClicked"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontAttributes="Bold" FontSize="12"
                            Padding="16,6" />
                </Border>

                <Border x:Name="NameTabFrame"
                        BackgroundColor="#16161C"
                        StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Button x:Name="NameTab" Text="Name" Clicked="TabClicked"
                            BackgroundColor="Transparent"
                            TextColor="#7A7A8C"
                            FontSize="12" Padding="16,6" />
                </Border>

                <Border x:Name="PhoneTabFrame"
                        BackgroundColor="#16161C"
                        StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Button x:Name="PhoneTab" Text="Phone" Clicked="TabClicked"
                            BackgroundColor="Transparent"
                            TextColor="#7A7A8C"
                            FontSize="12" Padding="16,6" />
                </Border>

                <Border x:Name="MoodTabFrame"
                        BackgroundColor="#16161C"
                        StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Button x:Name="MoodTab" Text="Mood" Clicked="TabClicked"
                            BackgroundColor="Transparent"
                            TextColor="#7A7A8C"
                            FontSize="12" Padding="16,6" />
                </Border>

                <Border x:Name="LocationTabFrame"
                        BackgroundColor="#16161C"
                        StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Button x:Name="LocationTab" Text="Location" Clicked="TabClicked"
                            BackgroundColor="Transparent"
                            TextColor="#7A7A8C"
                            FontSize="12" Padding="16,6" />
                </Border>

                <Border x:Name="AgeRangeTabFrame"
                        BackgroundColor="#16161C"
                        StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 8"
                        Padding="0">
                    <Button x:Name="AgeRangeTab" Text="Age" Clicked="TabClicked"
                            BackgroundColor="Transparent"
                            TextColor="#7A7A8C"
                            FontSize="12" Padding="16,6" />
                </Border>

            </HorizontalStackLayout>
        </ScrollView>

        <!-- ══ ROW 3 · ACTIVE FILTER CHIPS ══ -->
        <ScrollView Grid.Row="3"
                    x:Name="ActiveFiltersScrollView"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    IsVisible="False"
                    HeightRequest="44"
                    Margin="16,0,16,4">
            <HorizontalStackLayout x:Name="ActiveFiltersLayout"
                                   Spacing="8"
                                   VerticalOptions="Center" />
        </ScrollView>

        <!-- ══ ROW 4 · MOOD PICKER ══ -->
        <Border Grid.Row="4"
                x:Name="MoodDropdownFrame"
                BackgroundColor="#16161C"
                StrokeThickness="1" Stroke="#2A2A38"
                StrokeShape="RoundRectangle 14"
                Margin="16,0,16,8"
                Padding="12,0"
                IsVisible="False">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Path Grid.Column="0"
                      Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"
                      Fill="#FF3B6F"
                      HeightRequest="14" WidthRequest="14"
                      VerticalOptions="Center" Aspect="Uniform" />
                <Picker Grid.Column="1"
                        x:Name="MoodPicker"
                        Title="Filter by mood..."
                        TitleColor="#5A5A6A"
                        TextColor="#F0EDE8"
                        BackgroundColor="Transparent"
                        FontSize="13"
                        HeightRequest="48"
                        SelectedIndexChanged="OnMoodSelected">
                    <Picker.Items>
                        <x:String>All moods</x:String>
                        <x:String>Serious relationship</x:String>
                        <x:String>Long-term potential</x:String>
                        <x:String>Just vibes / casual fun</x:String>
                        <x:String>Something casual</x:String>
                        <x:String>Hook-up / FWB</x:String>
                        <x:String>ENM / Open to non-monogamy</x:String>
                        <x:String>Deep talks and connection</x:String>
                        <x:String>Let's see where it goes</x:String>
                        <x:String>Networking / collabs / friends first</x:String>
                        <x:String>OS(open situationship)</x:String>
                        <x:String>Chalance(all-in effort)</x:String>
                    </Picker.Items>
                </Picker>
            </Grid>
        </Border>

        <!-- ══ ROW 5 · LOCATION PICKER ══ -->
        <Border Grid.Row="5"
                x:Name="LocationDropdownFrame"
                BackgroundColor="#16161C"
                StrokeThickness="1" Stroke="#2A2A38"
                StrokeShape="RoundRectangle 14"
                Margin="16,0,16,8"
                Padding="12,0"
                IsVisible="False">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Path Grid.Column="0"
                      Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"
                      Fill="#00B5B5"
                      HeightRequest="14" WidthRequest="14"
                      VerticalOptions="Center" Aspect="Uniform" />
                <Picker Grid.Column="1"
                        x:Name="LocationPicker"
                        Title="Filter by location..."
                        TitleColor="#5A5A6A"
                        TextColor="#F0EDE8"
                        BackgroundColor="Transparent"
                        FontSize="13"
                        HeightRequest="48"
                        SelectedIndexChanged="OnLocationSelected" />
            </Grid>
        </Border>

        <!-- ══ ROW 6 · AGE RANGE ══ -->
        <Border Grid.Row="6"
                x:Name="AgeRangeFrame"
                BackgroundColor="#16161C"
                StrokeThickness="1" Stroke="#2A2A38"
                StrokeShape="RoundRectangle 14"
                Margin="16,0,16,8"
                Padding="14,10"
                IsVisible="False">
            <Grid ColumnDefinitions="*,Auto,*,Auto" ColumnSpacing="8">

                <Border Grid.Column="0"
                        BackgroundColor="#1C1C25"
                        StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="40" Padding="8,0">
                    <Entry x:Name="MinAgeEntry"
                           Placeholder="Min age"
                           PlaceholderColor="#3A3A4A"
                           TextColor="#F0EDE8"
                           BackgroundColor="Transparent"
                           Keyboard="Numeric" FontSize="13"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           TextChanged="OnAgeEntryChanged" />
                </Border>

                <Label Grid.Column="1" Text="→"
                       TextColor="#5A5A6A" FontSize="14"
                       VerticalOptions="Center" HorizontalOptions="Center" />

                <Border Grid.Column="2"
                        BackgroundColor="#1C1C25"
                        StrokeThickness="1" Stroke="#2A2A38"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="40" Padding="8,0">
                    <Entry x:Name="MaxAgeEntry"
                           Placeholder="Max age"
                           PlaceholderColor="#3A3A4A"
                           TextColor="#F0EDE8"
                           BackgroundColor="Transparent"
                           Keyboard="Numeric" FontSize="13"
                           HorizontalTextAlignment="Center"
                           VerticalOptions="Center"
                           TextChanged="OnAgeEntryChanged" />
                </Border>

                <Border Grid.Column="3"
                        x:Name="ApplyAgeButton"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="40" Padding="14,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF3B6F" Offset="0" />
                            <GradientStop Color="#CC2F59" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ApplyAgeFilter_Clicked" />
                    </Border.GestureRecognizers>
                    <Label Text="Apply" TextColor="White"
                           FontSize="12" FontAttributes="Bold"
                           VerticalOptions="Center" HorizontalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- ══ ROW 7 · MAIN CONTENT ══ -->
        <ScrollView Grid.Row="7"
                    HorizontalScrollBarVisibility="Never"
                    VerticalScrollBarVisibility="Never"
                    BackgroundColor="#0E0E12">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

                <!-- ── SEARCH RESULTS (User cards vertical) ── -->
                <VerticalStackLayout x:Name="SearchResultsSection"
                                     Spacing="0"
                                     IsVisible="False"
                                     Padding="16,8,16,0">

                    <Label Text="RESULTS"
                           FontSize="10" FontAttributes="Bold"
                           TextColor="#5A5A6A" CharacterSpacing="2"
                           Margin="4,0,0,10" />

                    <CollectionView x:Name="SearchResultsCollectionView"
                                    ItemsSource="{Binding SearchResults}"
                                    SelectionMode="None"
                                    VerticalScrollBarVisibility="Never">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#16161C"
                                        StrokeThickness="1" Stroke="#2A2A38"
                                        StrokeShape="RoundRectangle 16"
                                        Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnUserCardTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <!-- Avatar -->
                                        <Grid Grid.Column="0" WidthRequest="52" HeightRequest="52">
                                            <Ellipse WidthRequest="52" HeightRequest="52"
                                                     StrokeThickness="2">
                                                <Ellipse.Stroke>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#FF3B6F" Offset="0" />
                                                        <GradientStop Color="#00B5B5" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Ellipse.Stroke>
                                            </Ellipse>
                                            <Frame WidthRequest="44" HeightRequest="44"
                                                   CornerRadius="22" Padding="0"
                                                   IsClippedToBounds="True" HasShadow="False"
                                                   BackgroundColor="#1C1C25" BorderColor="Transparent"
                                                   HorizontalOptions="Center" VerticalOptions="Center">
                                                <Image Aspect="AspectFill"
                                                       HeightRequest="44" WidthRequest="44">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource ImagePathConverter}">
                                                            <Binding Path="ProfileImagePath" />
                                                            <Binding Path="." Converter="{StaticResource DefaultImageConverter}" />
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                            </Frame>
                                        </Grid>

                                        <!-- Info -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="{Binding Name, FallbackValue='Unknown'}"
           FontAttributes="Bold" FontSize="15"
           TextColor="#F0EDE8"
           MaxLines="1" LineBreakMode="TailTruncation" />

                                                <!-- Verified Badge (X/Twitter style - clean blue check) -->
                                                <Path Data="m366-126-64-108-122-26 12-126-82-94 82-94-12-126 122-26 64-108 114 48 114-48 64 108 122 26-12 126 82 94-82 94 12 126-122 26-64 108-114-48-114 48Zm12-36 102-42 102 42 58-96 110-24-10-114 74-84-74-84 10-114-110-24-58-96-102 42-102-42-58 96-110 24 10 114-74 84 74 84-10 114 110 24 58 96Zm102-318Zm-42 106 190-190-20-20-170 170-86-86-20 20 106 106Z"
      Fill="#00B5B5"
      Stroke="#00B5B5"
      StrokeThickness="8"
      WidthRequest="16"
      HeightRequest="16"
      VerticalOptions="Center"
      Aspect="Uniform"
      IsVisible="{Binding IsVerified}" />
                                                <Border BackgroundColor="#0D1F1F"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            Padding="6,2"
            IsVisible="{Binding HasAge}">
                                                    <Label Text="{Binding Age}"
               FontSize="10" FontAttributes="Bold"
               TextColor="#00B5B5" />
                                                </Border>
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasMood}">
                                                <Path Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"
                                                      Fill="#FF3B6F"
                                                      HeightRequest="10" WidthRequest="10"
                                                      VerticalOptions="Center" Aspect="Uniform" />
                                                <Label Text="{Binding Mood}"
                                                       FontSize="12" TextColor="#FF3B6F"
                                                       FontAttributes="Bold"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>

                                            <HorizontalStackLayout Spacing="5" IsVisible="{Binding HasLocation}">
                                                <Path Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM480-80Q319-217 239.5-334.5T160-552q0-150 96.5-239T480-880q127 0 223.5 89T800-552q0 100-79.5 217.5T480-80Z"
                                                      Fill="#5A5A6A"
                                                      HeightRequest="10" WidthRequest="10"
                                                      VerticalOptions="Center" Aspect="Uniform" />
                                                <Label Text="{Binding Location}"
                                                       FontSize="11" TextColor="#5A5A6A"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <!-- Arrow -->
                                        <Path Grid.Column="2"
                                              Data="M504-480 320-664l56-56 240 240-240 240-56-56 184-184Z"
                                              Fill="#3A3A4A"
                                              HeightRequest="14" WidthRequest="14"
                                              VerticalOptions="Center" Aspect="Uniform" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ── POST RESULTS ── -->
                <ScrollView x:Name="PostResultsSection"
            IsVisible="False"
            Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="POSTS"
               FontSize="10" FontAttributes="Bold"
               TextColor="#5A5A6A" CharacterSpacing="2"
               Margin="20,12,16,10" />

                        <CollectionView x:Name="PostResultsCollectionView"
                        ItemsSource="{Binding PostSearchResults}"
                        SelectionMode="None"
                        Margin="16,0">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="#16161C"
                            StrokeThickness="1" Stroke="#2A2A38"
                            StrokeShape="RoundRectangle 14"
                            Padding="12,10"
                            Margin="0,0,0,2">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPostResultTapped"
                                                  CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <!-- Author avatar -->
                                            <Frame Grid.Column="0"
                                   HeightRequest="42" WidthRequest="42"
                                   CornerRadius="21" Padding="0"
                                   IsClippedToBounds="True"
                                   BackgroundColor="#1C1C25"
                                   HasShadow="False">
                                                <Image Source="{Binding AuthorProfileImagePath}"
                                       Aspect="AspectFill"
                                       HeightRequest="42" WidthRequest="42" />
                                            </Frame>

                                            <!-- Content -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding AuthorName}"
                                           FontSize="13" FontAttributes="Bold"
                                           TextColor="#F0EDE8" />
                                                    <Label Text="{Binding CreatedAtRelative}"
                                           FontSize="10" TextColor="#5A5A6A"
                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>

                                                <!-- Use FormattedString for highlighted content -->
                                                <Label FormattedText="{Binding HighlightedContent}"
                                       FontSize="12" TextColor="#A0A0B0"
                                       MaxLines="3" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <!-- Thumbnail -->
                                            <Frame Grid.Column="2"
                                   HeightRequest="48" WidthRequest="48"
                                   CornerRadius="10" Padding="0"
                                   IsClippedToBounds="True"
                                   BackgroundColor="#1C1C25"
                                   HasShadow="False"
                                   IsVisible="{Binding HasImages}">
                                                <Image Source="{Binding FirstImagePath}"
                                       HeightRequest="48" WidthRequest="48"
                                       Aspect="AspectFill" />
                                            </Frame>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>
                
                
                <!-- ── ALL USERS — HORIZONTAL PROFILE CARDS ── -->
                <VerticalStackLayout x:Name="AllUsersSection" Spacing="0" IsVisible="True">

                    <!-- Section header -->
                    <Grid ColumnDefinitions="*,Auto" Padding="20,8,16,10">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Path Data="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"
                  Fill="#F0EDE8"
                  HeightRequest="12" WidthRequest="12"
                  VerticalOptions="Center" Aspect="Uniform" />
                            <Label Text="People Near You"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="#F0EDE8" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Horizontal scrolling profile cards -->
                    <ScrollView Orientation="Horizontal"
                HorizontalScrollBarVisibility="Never"
                VerticalScrollBarVisibility="Never">
                        <HorizontalStackLayout x:Name="AllUsersStackLayout"
                               Spacing="12"
                               Padding="16,4,16,16"
                               VerticalOptions="Start" />
                    </ScrollView>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ── EMPTY STATE ── -->
        <VerticalStackLayout x:Name="EmptyContainer"
                             Grid.Row="7"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="14"
                             Padding="40,0"
                             IsVisible="False">
            <Path Data="m775.5-168.5-247.77-248Q498-390.5 459-376.75T383.16-363q-91.13 0-153.9-62.98-62.76-62.97-62.76-153.5 0-90.52 62.7-153.52 62.71-63 153.5-63 90.8 0 153.8 63.01 63 63 63 153.57 0 40.42-15 79.42T546-434.29L794-187l-18.5 18.5Z"
                  Fill="#2A2A38"
                  HeightRequest="56" WidthRequest="56"
                  HorizontalOptions="Center"
                  Aspect="Uniform" />
            <Label x:Name="EmptyLabel"
                   Text="Discover someone new"
                   FontAttributes="Bold" FontSize="18"
                   TextColor="#F0EDE8"
                   HorizontalOptions="Center" />
            <Label x:Name="EmptySubLabel"
                   Text="Search by name, mood, location or age"
                   FontSize="13" TextColor="#5A5A6A"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>