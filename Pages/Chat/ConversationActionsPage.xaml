<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lock.Pages.Chat.ConversationActionsPage"
             BackgroundColor="Transparent"
             Title="Conversation actions">
    <Grid>
        <BoxView Color="#CC000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped" NumberOfTapsRequired="1" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="0"
                BackgroundColor="#121212"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                WidthRequest="340">

            <Border.Stroke>
                <LinearGradientBrush EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0.1" />
                    <GradientStop Color="#00FFFFFF" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Stroke>

            <VerticalStackLayout Spacing="0">

                <VerticalStackLayout Padding="20,24,20,16" Spacing="8">
                    <Label x:Name="PreviewLabel"
                           FontAttributes="Bold"
                           LineBreakMode="TailTruncation"
                           MaxLines="2"
                           HorizontalTextAlignment="Center"
                           TextColor="White"
                           FontSize="18"
                           CharacterSpacing="0.5" />

                    <BoxView HeightRequest="3" 
                             WidthRequest="40"
                             Margin="0,8,0,0"
                             HorizontalOptions="Center"
                             BackgroundColor="#C05050" />
                </VerticalStackLayout>

                <Label Text="Quick Actions" 
                       FontSize="12" 
                       FontAttributes="Bold"
                       TextColor="#666666"
                       Margin="24,10,0,10"
                       CharacterSpacing="1" />

                <CollectionView x:Name="ActionsCollectionView" 
                                SelectionMode="None" 
                                Margin="0,0,0,10"
                                HeightRequest="350">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Padding="0">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ActionButton_Clicked"
                                                          NumberOfTapsRequired="1"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#252525" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <VerticalStackLayout Spacing="0">
                                    <Grid Padding="24,16,24,16" 
                                          ColumnDefinitions="32,*" 
                                          ColumnSpacing="16">

                                        <Grid Grid.Column="0" VerticalOptions="Center">

                                            <Path IsVisible="False" Data="M20,6h-8l-2-2H4C2.9,4 2,4.9 2,6v12c0,1.1 0.9,2 2,2h16c1.1,0 2-0.9 2-2V8C22,6.9 21.1,6 20,6z M20,18H4V6h5.17l2,2H20V18z"
                                                  Fill="#00F2FF" HeightRequest="22" WidthRequest="22" Aspect="Uniform">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Archive chat">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Unarchive chat">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <Path IsVisible="False" Data="M12,22 C13.1,22 14,21.1 14,20 L10,20 C10,21.1 10.9,22 12,22 Z M18,16 L18,11 C18,7.93 16.37,5.36 13.5,4.68 L13.5,4 C13.5,3.17 12.83,2.5 12,2.5 C11.17,2.5 10.5,3.17 10.5,4 L10.5,4.68 C7.64,5.36 6,7.92 6,11 L6,16 L4,18 L4,19 L20,19 L20,18 L18,16 Z"
                                                  Fill="#00F2FF" HeightRequest="22" WidthRequest="22" Aspect="Uniform">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Mute notifications">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Unmute notifications">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <Path IsVisible="False" Data="M16,12V4h1V2H7v2h1v8l-2,2v2h5v6h2v-6h5v-2L16,12z"
                                                  Fill="#00F2FF" HeightRequest="22" WidthRequest="22" Aspect="Uniform">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Pin chat">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Unpin chat">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <Path IsVisible="False" Data="M20,4H4C2.9,4 2,4.9 2,6v12c0,1.1 0.9,2 2,2h16c1.1,0 2-0.9 2-2V6C22,4.9 21.1,4 20,4z M20,8l-8,5L4,8V6l8,5l8-5V8z"
                                                  Fill="#00F2FF" HeightRequest="22" WidthRequest="22" Aspect="Uniform">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Mark as unread">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <Path IsVisible="False" Data="M12,17.27L18.18,21l-1.64-7.03L22,9.24l-7.19-0.61L12,2L9.19,8.63L2,9.24l5.46,4.73L5.82,21L12,17.27z"
                                                  Fill="#FFD700" HeightRequest="22" WidthRequest="22" Aspect="Uniform">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Add to favorites">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Remove from favorites">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <Path IsVisible="False" Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z"
                                                  Fill="#00F2FF" HeightRequest="22" WidthRequest="22" Aspect="Uniform">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Add to list">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <Path IsVisible="False" Data="M6,19c0,1.1 0.9,2 2,2h8c1.1,0 2-0.9 2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z"
                                                  Fill="#FF4B4B" HeightRequest="22" WidthRequest="22" Aspect="Uniform">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Delete chat">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>

                                            <Path IsVisible="False" Data="M12,2C6.48,2 2,6.48 2,12s4.48,10 10,10 10-4.48 10-10S17.52,2 12,2z M4,12c0-4.42 3.58-8 8-8 1.85,0 3.55,0.63 4.9,1.69L5.69,16.9C4.63,15.55 4,13.85 4,12z"
                                                  Fill="#FF4B4B" HeightRequest="22" WidthRequest="22" Aspect="Uniform">
                                                <Path.Triggers>
                                                    <DataTrigger TargetType="Path" Binding="{Binding .}" Value="Block">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Path.Triggers>
                                            </Path>
                                        </Grid>

                                        <Label Grid.Column="1"
                                               Text="{Binding .}"
                                               VerticalOptions="Center"
                                               TextColor="#EEEEEE"
                                               FontSize="16"
                                               FontFamily="Sans-Serif" />
                                    </Grid>

                                    <BoxView HeightRequest="0.5" 
                                             BackgroundColor="#22FFFFFF" 
                                             Margin="72,0,0,0" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>