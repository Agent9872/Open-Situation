<?xml version="1.0" encoding="utf-8" ?>
<views:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
             xmlns:conv="clr-namespace:Lock.Converter.Chat"
             x:Class="Lock.Pages.Chat.VoicePreviewPopup"
             x:Name="VoicePreviewPopupControl"
             Size="360, 320"
             CanBeDismissedByTappingOutsideOfPopup="True">

    <views:Popup.Resources>
        <conv:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
    </views:Popup.Resources>

    <Border StrokeThickness="1"
            Stroke="#3A2A4A"
            BackgroundColor="#1A1225"
            StrokeShape="RoundRectangle 24"
            Padding="20,20,20,20">

        <VerticalStackLayout Spacing="14">

            <!-- Header -->
            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                <Label Text="Voice Message"
                       FontAttributes="Bold"
                       FontSize="17"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Preview before sending"
                       FontSize="11"
                       TextColor="#8A7A9A"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Duration display -->
            <Grid ColumnDefinitions="*,Auto,*" Margin="0,2,0,2">
                <BoxView Grid.Column="0"
                         HeightRequest="1"
                         BackgroundColor="#3A2A4A"
                         VerticalOptions="Center"
                         Margin="0,0,12,0"/>
                <Label x:Name="DurationLabel"
                       Grid.Column="1"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="#C05090"
                       HorizontalOptions="Center"/>
                <BoxView Grid.Column="2"
                         HeightRequest="1"
                         BackgroundColor="#3A2A4A"
                         VerticalOptions="Center"
                         Margin="12,0,0,0"/>
            </Grid>

            <!-- Progress bar with time labels -->
            <VerticalStackLayout Spacing="4">
                <Grid HeightRequest="3">
                    <BoxView BackgroundColor="#3A2A4A"
                             HorizontalOptions="Fill"
                             HeightRequest="3"
                             CornerRadius="2"/>
                    <BoxView x:Name="ProgressBar"
                             BackgroundColor="#C05090"
                             HorizontalOptions="Start"
                             WidthRequest="0"
                             HeightRequest="3"
                             CornerRadius="2"/>
                </Grid>
                <Grid ColumnDefinitions="*,*">
                    <Label x:Name="StartTimeLabel"
                           Grid.Column="0"
                           Text="0:00"
                           FontSize="10"
                           TextColor="#6A5A7A"/>
                    <Label x:Name="EndTimeLabel"
                           Grid.Column="1"
                           Text="{Binding Source={x:Reference VoicePreviewPopupControl}, Path=_durationSeconds, Converter={StaticResource SecondsToTimeConverter}}"
                           FontSize="10"
                           TextColor="#6A5A7A"
                           HorizontalOptions="End"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Control buttons — all same height, no negative margin -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="12"
                  HeightRequest="56"
                  Margin="0,8,0,0">

                <!-- Cancel button -->
                <Border Grid.Column="0"
                        BackgroundColor="#2A1A2A"
                        StrokeThickness="1"
                        Stroke="#FF5252"
                        StrokeShape="RoundRectangle 22"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelClicked"/>
                    </Border.GestureRecognizers>
                    <Path Fill="#FF5252"
                          WidthRequest="22"
                          HeightRequest="22"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Data="M6,6 L18,18 M18,6 L6,18"
                          Stroke="#FF5252"
                          StrokeThickness="2.5"
                          StrokeLineCap="Round"/>
                </Border>

                <!-- Play/Pause button -->
                <Border Grid.Column="1"
                        BackgroundColor="#C05090"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPlayPauseClicked"/>
                    </Border.GestureRecognizers>
                    <Grid HorizontalOptions="Center"
                          VerticalOptions="Center">
                        <Path x:Name="PlayIcon"
                              Fill="#FFFFFF"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.2"
                              WidthRequest="26"
                              HeightRequest="26"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform"
                              IsVisible="True"
                              Data="M407.5-351 609-480 407.5-609v258Zm72.74 214q-71.15 0-133.87-27.02-62.72-27.03-109.12-73.35-46.4-46.33-73.32-108.83Q137-408.7 137-479.76q0-71.15 27.02-133.87 27.03-62.72 73.35-109.12 46.33-46.4 108.83-73.32Q408.7-823 479.76-823q71.15 0 133.87 27.02 62.72 27.03 109.12 73.35 46.4 46.33 73.32 108.83Q823-551.3 823-480.24q0 71.15-27.02 133.87-27.03 62.72-73.35 109.12-46.33 46.4-108.83 73.32Q551.3-137 480.24-137Zm-.27-25.5q132.53 0 225.03-92.47 92.5-92.46 92.5-225 0-132.53-92.47-225.03-92.46-92.5-225-92.5-132.53 0-225.03 92.47-92.5 92.46-92.5 225 0 132.53 92.47 225.03 92.46 92.5 225 92.5ZM480-480Z"/>
                        <Path x:Name="PauseIcon"
                              Fill="#FFFFFF"
                              Stroke="#FFFFFF"
                              StrokeThickness="1.2"
                              WidthRequest="26"
                              HeightRequest="26"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform"
                              IsVisible="False"
                              Data="M404.5-348H430v-264h-25.5v264Zm126 0H556v-264h-25.5v264Zm-50.26 211q-71.15 0-133.87-27.02-62.72-27.03-109.12-73.35-46.4-46.33-73.32-108.83Q137-408.7 137-479.76q0-71.15 27.02-133.87 27.03-62.72 73.35-109.12 46.33-46.4 108.83-73.32Q408.7-823 479.76-823q71.15 0 133.87 27.02 62.72 27.03 109.12 73.35 46.4 46.33 73.32 108.83Q823-551.3 823-480.24q0 71.15-27.02 133.87-27.03 62.72-73.35 109.12-46.33 46.4-108.83 73.32Q551.3-137 480.24-137Zm-.27-25.5q132.53 0 225.03-92.47 92.5-92.46 92.5-225 0-132.53-92.47-225.03-92.46-92.5-225-92.5-132.53 0-225.03 92.47-92.5 92.46-92.5 225 0 132.53 92.47 225.03 92.46 92.5 225 92.5ZM480-480Z"/>
                    </Grid>
                </Border>

                <!-- Send button -->
                <Border Grid.Column="2"
                        BackgroundColor="#2A1A2A"
                        StrokeThickness="1"
                        Stroke="#C05090"
                        StrokeShape="RoundRectangle 22"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSendClicked"/>
                    </Border.GestureRecognizers>
                    <Path Fill="#C05090"
                          Stroke="#C05090"
                          StrokeThickness="1.2"
                          WidthRequest="24"
                          HeightRequest="24"
                          HorizontalOptions="Center"
                          VerticalOptions="Center"
                          Aspect="Uniform"
                          Data="M467.5-353.5H494v-207l91 91.5 17.5-17.5-121.5-121-122 121 17 17.5 91.5-91.5v207ZM480.24-137q-71.15 0-133.87-27.02-62.72-27.03-109.12-73.35-46.4-46.33-73.32-108.83Q137-408.7 137-479.76q0-71.15 27.02-133.87 27.03-62.72 73.35-109.12 46.33-46.4 108.83-73.32Q408.7-823 479.76-823q71.15 0 133.87 27.02 62.72 27.03 109.12 73.35 46.4 46.33 73.32 108.83Q823-551.3 823-480.24q0 71.15-27.02 133.87-27.03 62.72-73.35 109.12-46.33 46.4-108.83 73.32Q551.3-137 480.24-137Zm-.27-25.5q132.53 0 225.03-92.47 92.5-92.46 92.5-225 0-132.53-92.47-225.03-92.46-92.5-225-92.5-132.53 0-225.03 92.47-92.5 92.46-92.5 225 0 132.53 92.47 225.03 92.46 92.5 225 92.5ZM480-480Z"/>
                </Border>
            </Grid>

            <!-- Button labels -->
            <Grid ColumnDefinitions="*,*,*" Margin="0,2,0,0">
                <Label Grid.Column="0"
                       Text="Discard"
                       FontSize="10"
                       TextColor="#FF5252"
                       HorizontalOptions="Center"/>
                <Label Grid.Column="1"
                       x:Name="PlayPauseLabel"
                       Text="Play"
                       FontSize="10"
                       TextColor="#C05090"
                       HorizontalOptions="Center"/>
                <Label Grid.Column="2"
                       Text="Send"
                       FontSize="10"
                       TextColor="#C05090"
                       HorizontalOptions="Center"/>
            </Grid>

        </VerticalStackLayout>
    </Border>
</views:Popup>