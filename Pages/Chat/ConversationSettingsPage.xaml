<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Lock.Pages.Chat.ConversationSettingsPage"
             Title="Chat Settings"
             BackgroundColor="Transparent">

    <Grid>
        <BoxView Color="#CC0E0E12">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnBackgroundTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border HorizontalOptions="Center"
                VerticalOptions="Center"
                Padding="0"
                BackgroundColor="#16161C"
                StrokeThickness="1"
                Stroke="#2A2A38"
                StrokeShape="RoundRectangle 24"
                WidthRequest="360"
                MaximumWidthRequest="390">

            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="30" Opacity="0.6" />
            </Border.Shadow>

            <ScrollView Orientation="Vertical" MaximumHeightRequest="650">
                <VerticalStackLayout Spacing="0" Padding="0,0,0,24">

                    <Grid Padding="24,20,16,16" ColumnDefinitions="*,Auto" VerticalOptions="Start">
                        <Label Grid.Column="0" 
           Text="CHAT SETTINGS" 
           FontSize="14" 
           CharacterSpacing="1"
           TextColor="#F0EDE8" 
           FontAttributes="Bold"
           VerticalOptions="Center" />

                        <Border Grid.Column="1" 
            BackgroundColor="#2A2A38" 
            StrokeThickness="0"
            StrokeShape="RoundRectangle 18"
            HeightRequest="36" 
            WidthRequest="36"
            VerticalOptions="Center"
            HorizontalOptions="End"
            Margin="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseTapped" />
                            </Border.GestureRecognizers>
                            <Path Data="M480-444.5 270.5-235l-17-17L463-461.5 253.5-671l17-17L480-478l209.5-209.5 17 17L497-461.5l209.5 209.5-17 17L480-444.5Z"
              Fill="#7A7A8C"
              HeightRequest="14" 
              WidthRequest="14"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Aspect="Uniform" />
                        </Border>
                    </Grid>
                    <BoxView HeightRequest="1" BackgroundColor="#2A2A38" Margin="0,0,0,10" />

                    <Label Text="{Binding _matchName, StringFormat='Conversation with {0}'}"
                           FontSize="12"
                           TextColor="#00B5B5"
                           Padding="24,10,24,5" />

                    <Label Text="PREFERENCES"
                           FontSize="11"
                           TextColor="#555566"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           Padding="24,15,16,10" />

                    <Grid Padding="24,14" ColumnDefinitions="Auto, *">
                        <Path Grid.Column="0" Data="M796-121 533-384q-30 26-69 40.5t-84 14.5q-99 0-169.5-70.5T140-570q0-99 70.5-169.5T380-810q99 0 169.5 70.5T620-570q0 45-14.5 84T565-417l263 264-32 32ZM380-400q71 0 120.5-49.5T550-570q0-71-49.5-120.5T380-740q-71 0-120.5 49.5T210-570q0 71 49.5 120.5T380-400Z"
                              Fill="#FF3B6F" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Search in conversation" Margin="15,0"
                               FontSize="15" TextColor="#F0EDE8" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSearchTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#1C1C25" Margin="24,4" />

                    <Grid Padding="24,14" ColumnDefinitions="Auto, *">
                        <Path Grid.Column="0" Data="M261-160q-24.75 0-42.37-17.63Q201-195.25 201-220v-470h140v-50h278v50h140v470q0 24.75-17.63 42.37Q723.75-160 699-160H261Zm0-30h438q12.75 0 21.38-8.62Q729-207.25 729-220v-410H231v410q0 12.75 8.62 21.38Q248.25-190 261-190Zm0 0V-715v525Z"
                              Fill="#00B5B5" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Mark all as read" Margin="15,0"
                               FontSize="15" TextColor="#F0EDE8" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnReadAllTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#1C1C25" Margin="24,4" />

                    <Grid Padding="24,14" ColumnDefinitions="Auto, *">
                        <Path Grid.Column="0" Data="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z"
                              Fill="#7A7A8C" Aspect="Uniform" HeightRequest="20" WidthRequest="20" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="Create Group" Margin="15,0"
                               FontSize="15" TextColor="#F0EDE8" VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateGroupTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#1C1C25" Margin="24,4" />

                    <Grid Padding="24,14" ColumnDefinitions="Auto, *">
                        <Path Grid.Column="0" 
          Data="M480-80q-82 0-155-31.5t-127.5-86Q143-252 111.5-325T80-480q0-83 31.5-156t86-127Q252-817 325-848.5T480-880q83 0 156 31.5T763-763q54 54 85.5 127T880-480q0 82-31.5 155T763-197.5q-54 54.5-127 86T480-80Zm0-80q133 0 226.5-93.5T800-480q0-133-93.5-226.5T480-800q-133 0-226.5 93.5T160-480q0 133 93.5 226.5T480-160Zm0-160q-17 0-28.5-11.5T440-360q0-17 11.5-28.5T480-400q17 0 28.5 11.5T520-360q0 17-11.5 28.5T480-320Zm-40-160v-40q0-15 7-27.5t18-20.5q15-12 29.5-25t14.5-35q0-20-15-33.5T461-655q-25 0-45 12t-29 34q-8 17-25.5 24T340-582q-14-7-20.5-22.5T318-633q14-42 47-69.5t90-27.5q59 0 98 35t39 86q0 32-15.5 56T539-518q-23 18-31 30t-8 28v40h-60Z"
          Fill="#FFA500" 
          Aspect="Uniform" 
          HeightRequest="20" 
          WidthRequest="20" 
          VerticalOptions="Center" />
                        <Label Grid.Column="1" 
           Text="FAQ and Help" 
           Margin="15,0"
           FontSize="15" 
           TextColor="#F0EDE8" 
           VerticalOptions="Center" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFaqTapped" />
                        </Grid.GestureRecognizers>
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>