<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Lock.Converter.Chat"
             xmlns:local="clr-namespace:Lock.Pages.Chat"
             x:Class="Lock.Pages.Chat.ChatPage">

    <ContentPage.Resources>
        <!-- Your existing converters -->
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
        <conv:IsNotEmptyConverter x:Key="IsNotEmptyConverter" />
        <conv:IsGreaterThanOneConverter x:Key="IsGreaterThanOneConverter" />
        <conv:SubtractTwoConverter x:Key="SubtractTwoConverter" />
        <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter" />
        <conv:BoolToPlayPauseConverter x:Key="BoolToPlayPauseConverter" />
        <conv:JsonToByteArrayConverter x:Key="JsonToByteArrayConverter" />
        <conv:AmplitudeToHeightConverter x:Key="AmplitudeToHeightConverter" />
        <conv:ProgressToWidthConverter x:Key="ProgressToWidthConverter" />
        <conv:DurationToProgressConverter x:Key="DurationToProgressConverter" />
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        <conv:IsEqualToConverter x:Key="IsEqualToConverter" />
        <conv:IsNotEqualToConverter x:Key="IsNotEqualToConverter" />
        <conv:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
        <conv:ScreenToImageWidthConverter x:Key="ScreenToImageWidthConverter" />
        <conv:ScreenToImageHeightConverter x:Key="ScreenToImageHeightConverter" />
        <conv:MaxBubbleWidthConverter x:Key="MaxBubbleWidthConverter" />

        <!-- Bubble Style -->
        <Style x:Key="BubbleStyle" TargetType="Border">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ADD THIS HERE — moved from inside ActionsOverlay -->
        <Style x:Key="ActionLabelStyle" TargetType="Label">
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
    </ContentPage.Resources>

    <!-- UPDATED: Main Grid with RowSpacing="0" to eliminate gaps -->
    <Grid x:Name="ChatRootGrid"
      RowDefinitions="Auto,Auto,Auto,*,Auto" 
      Padding="0,0,4,4"
      RowSpacing="0">

        <!-- Background Image Layer -->
        <Image x:Name="ChatBackgroundImage"
               Source="{Binding ChatBackgroundPath, FallbackValue=''}"
               Aspect="AspectFill"
               Opacity="{Binding BackgroundBrightness}"
               IsVisible="{Binding ChatBackgroundPath, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
               Grid.RowSpan="5"
               ZIndex="-1" />

        <Grid Grid.Row="0" 
      ColumnDefinitions="*,Auto,Auto,Auto,Auto" 
      Padding="12,0,12,0"
      HeightRequest="74"
      BackgroundColor="#0E0E12">
            <BoxView Grid.ColumnSpan="5" 
             HeightRequest="0.5" 
             BackgroundColor="#2A2A38" 
             VerticalOptions="End" />

            <HorizontalStackLayout Grid.Column="0" 
                           Spacing="12" 
                           VerticalOptions="Center">
                <Border Padding="0" 
                StrokeThickness="0" 
                HeightRequest="44" 
                WidthRequest="44" 
                StrokeShape="RoundRectangle 22">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OtherProfileImage_Tapped" />
                    </Border.GestureRecognizers>
                    <Image x:Name="OtherProfileImage" 
                   HeightRequest="44" 
                   WidthRequest="44" 
                   Aspect="AspectFill">
                        <Image.Clip>
                            <EllipseGeometry Center="22,22" RadiusX="22" RadiusY="22" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Label x:Name="OtherNameLabel" 
               Text="" 
               FontAttributes="Bold" 
               FontSize="16"
               VerticalOptions="Center" 
               TextColor="#F0EDE8"/>
            </HorizontalStackLayout>

            <ContentView Grid.Column="1" 
                 WidthRequest="44" 
                 HeightRequest="44" 
                 VerticalOptions="Center" 
                 HorizontalOptions="Center">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="PhoneCallIcon_Tapped" />
                    </Grid.GestureRecognizers>
                    <Path Data="M745-172q-94 0-195.5-49.5T359.5-360q-88.5-89-138-190T172-745q0-18.43 12-30.71Q196-788 214-788h80q17 0 29.5 10.5T341-750l18 82q3 17-1 30t-14 21l-85 77q26 47 56.5 86.5T380-379q36 36 78 67t93 59l83-85q10-11 21.5-14t26.5-1l68 14q17 4 27.5 17t10.5 30v78q0 18-12.29 30-12.28 12-30.71 12ZM246-566l80-72q5-4 6.5-11t-.5-13l-18-82q-2-8-7-12t-13-4h-80q-6 0-10 4t-4 10q0 41 12.5 87t33.5 93Zm332 326q41 21 88.5 30.5T746-200q6 0 10-4t4-10v-78q0-8-4-13t-12-7l-68-14q-6-2-10.5-.5T656-320l-78 80ZM246-566Zm332 326Z"
                  Fill="#00B5B5" 
                  HeightRequest="20"
                  WidthRequest="20"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Aspect="Uniform" />
                </Grid>
            </ContentView>

            <ContentView Grid.Column="2" 
                 WidthRequest="44" 
                 HeightRequest="44" 
                 VerticalOptions="Center" 
                 HorizontalOptions="Center">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="VideoCallIcon_Tapped" />
                    </Grid.GestureRecognizers>
                    <Path Data="M411-346h28v-120h120v-28H439v-120h-28v120H291v28h120v120ZM217-212q-26 0-43-17t-17-43v-416q0-26 17-43t43-17h416q26 0 43 17t17 43v188l110-110v260L693-460v188q0 26-17 43t-43 17H217Zm0-28h416q14 0 23-9t9-23v-416q0-14-9-23t-23-9H217q-14 0-23 9t-9 23v416q0 14 9 23t23 9Zm-32 0v-480 480Z"
                  Fill="#00B5B5" 
                  HeightRequest="20"
                  WidthRequest="20"
                  HorizontalOptions="Center"
                  VerticalOptions="Center"
                  Aspect="Uniform" />
                </Grid>
            </ContentView>

            <!-- Search Button -->
            <ContentView Grid.Column="3" 
                 WidthRequest="44" 
                 HeightRequest="44" 
                 VerticalOptions="Center" 
                 HorizontalOptions="Center">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchTapped" />
                    </Grid.GestureRecognizers>
                    <Path Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                  Fill="#7A7A8C" 
                  HeightRequest="18"
                  WidthRequest="18"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
                </Grid>
            </ContentView>

            <!-- Menu Button -->
            <ContentView Grid.Column="4" 
                 WidthRequest="44" 
                 HeightRequest="44" 
                 VerticalOptions="Center" 
                 HorizontalOptions="End">
                <Grid>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="HeaderMenu_Tapped" />
                    </Grid.GestureRecognizers>
                    <Path Data="M12,8c1.1,0 2,-0.9 2,-2s-0.9,-2 -2,-2 -2,0.9 -2,2 0.9,2 2,2Zm0,2c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2Zm0,6c-1.1,0 -2,0.9 -2,2s0.9,2 2,2 2,-0.9 2,-2 -0.9,-2 -2,-2Z"
                  Fill="#7A7A8C" 
                  HeightRequest="18"
                  WidthRequest="18"
                  HorizontalOptions="Center"
                  VerticalOptions="Center" />
                </Grid>
            </ContentView>
        </Grid>
        <!-- Pinned messages strip -->
        <Grid Grid.Row="2"
      x:Name="PinnedStrip"
      IsVisible="False"
      ColumnDefinitions="Auto,*,Auto"
      ColumnSpacing="2"
      Padding="8,4,8,4"
      VerticalOptions="Start"
      HeightRequest="40">

            <HorizontalStackLayout Grid.Column="0" 
                           Spacing="4" 
                           VerticalOptions="Center">
                <ContentView WidthRequest="20" 
                     HeightRequest="20" 
                     HorizontalOptions="Start" 
                     VerticalOptions="Center">
                    <Grid>
                        <Path Data="M6,2 L10,2 L10,6 L12,8 L10,10 L10,14 L6,14 L6,10 L4,8 L6,6 L6,2 Z"
                      Stroke="#008080" 
                      StrokeThickness="1.2" 
                      Fill="Transparent"
                      StrokeLineJoin="Round" 
                      StrokeLineCap="Round" />
                    </Grid>
                </ContentView>
                <Label x:Name="PinnedCountLabel" 
               Text="0" 
               TextColor="#008080" 
               FontSize="12" 
               VerticalOptions="Center" />
            </HorizontalStackLayout>

            <CollectionView x:Name="PinnedMessagesCollectionView"
                    Grid.Column="1"
                    SelectionMode="None"
                    BackgroundColor="Transparent"
                    HeightRequest="36">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="2" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6"
                        Margin="0,0,6,0"
                        BackgroundColor="#2F3337"
                        Stroke="Transparent" 
                        StrokeThickness="0" 
                        StrokeShape="RoundRectangle 8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="PinnedPreview_Tapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="2">
                                <ContentView WidthRequest="16" 
                                     HeightRequest="16"
                                     VerticalOptions="Center">
                                    <Grid>
                                        <Path Data="M6,2 L10,2 L10,6 L12,8 L10,10 L10,14 L6,14 L6,10 L4,8 L6,6 L6,2 Z"
                                      Stroke="#008080" 
                                      StrokeThickness="1.2" 
                                      Fill="Transparent" />
                                    </Grid>
                                </ContentView>
                                <Label Text="{Binding Content}"
                               TextColor="White"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               FontSize="12" 
                               VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Grid.Column="2" Text="" />
        </Grid>

        <!-- UPDATED: Messages list - Fixed version -->
      <CollectionView x:Name="MessagesCollectionView"
                Grid.Row="3"
                ItemsSource="{Binding Messages}"
                Margin="0,0,0,0"
                SelectionMode="None"
                VerticalOptions="Fill"
                VerticalScrollBarVisibility="Never"
                BackgroundColor="Transparent">

            <!-- UPDATED: Encryption Notice Header - More compact -->
            <CollectionView.Header>
                <Grid Padding="8,2,8,4">
                    <Border BackgroundColor="#2F3337" 
                    StrokeShape="RoundRectangle 8"
                    Padding="8,4" 
                    Margin="0,2,0,2"
                    HorizontalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="EncryptionNotice_Tapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="6" 
                                       VerticalOptions="Center"
                                       HorizontalOptions="Center">
                            <ContentView WidthRequest="18" HeightRequest="18" VerticalOptions="Center">
                                <Path Data="M445-386h70l-22-122q17-5 28.5-19.5T533-560q0-22-15.5-37.5T480-613q-22 0-37.5 15.5T427-560q0 18 11.5 32.5T467-508l-22 122Zm35 252q-115-36-191.5-142T212-516v-208l268-100 268 100v208q0 134-76.5 240T480-134Zm0-30q104-33 172-132t68-220v-189l-240-89-240 89v189q0 121 68 220t172 132Zm0-315Z"
                              Fill="#e3e3e3"
                              Stroke="#e3e3e3"
                              StrokeThickness="1.2"
                              HeightRequest="18"
                              WidthRequest="18"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform" />
                            </ContentView>
                            <Label Text="End-to-end encrypted" 
                           TextColor="#A8A8A8" 
                           FontSize="10" 
                           VerticalOptions="Center" />
                            <Label Text="ℹ️" 
                           FontSize="9" 
                           VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </CollectionView.Header>

            <!-- UPDATED: Empty view for when there are no messages -->
            <CollectionView.EmptyView>
                <Grid VerticalOptions="Center" 
              HorizontalOptions="Center" 
              HeightRequest="100">
                    <Label Text="No messages yet" 
                   TextColor="Gray" 
                   FontSize="14"
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
                </Grid>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="1" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,2">
                        <!-- ==================== INCOMING MESSAGE ==================== -->
                        <Grid IsVisible="{Binding IsLocalOutgoing, Converter={StaticResource InverseBoolConverter}}"
                  HorizontalOptions="Start" Margin="4,1,12,1">
                            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="2">
                                <!-- Bubble -->
                                <Border Grid.Column="0"
                            BackgroundColor="#2F3337"
                            StrokeShape="RoundRectangle 16"
                            HorizontalOptions="Start"
                            MaximumWidthRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=Width, Converter={StaticResource MaxBubbleWidthConverter}}"
                            Padding="0">
                                    <VerticalStackLayout Spacing="0">

                                        <!-- CONTACT CARD - INCOMING -->
                                        <Grid IsVisible="{Binding MessageType, Converter={StaticResource IsEqualToConverter}, ConverterParameter='contact'}"
                                  ColumnDefinitions="Auto,*" Padding="8"
                                  BackgroundColor="#2F3337" Margin="0">
                                            <Border Grid.Column="0"
                                        HeightRequest="40" WidthRequest="40"
                                        BackgroundColor="#3A3A3C" StrokeThickness="1" Stroke="#FF3B6F"
                                        StrokeShape="RoundRectangle 20" Padding="1" Margin="0,0,8,0">
                                                <Image Source="{Binding ContactProfileImage, FallbackValue='default_profile.png'}"
                                           Aspect="AspectFill" HeightRequest="36" WidthRequest="36">
                                                    <Image.Clip>
                                                        <EllipseGeometry RadiusX="18" RadiusY="18" Center="18,18"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                                <Label Text="SHARED CONTACT" FontSize="8" TextColor="#FF3B6F" FontAttributes="Bold"/>
                                                <Label Text="{Binding ContactName}" FontSize="14" FontAttributes="Bold" TextColor="#FFFFFF"/>
                                                <Label Text="{Binding ContactPhone}" FontSize="12" TextColor="#8E8E93"/>
                                                <Border BackgroundColor="#FF3B6F" Padding="8,4" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6" Margin="0,4,0,0" HorizontalOptions="Start">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnSaveContactTapped" CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>
                                                    <Label Text="Save" TextColor="#FFFFFF" FontSize="10" FontAttributes="Bold"/>
                                                </Border>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- POST CARD - INCOMING (with author name) -->
                                        <Grid IsVisible="{Binding MessageType, Converter={StaticResource IsEqualToConverter}, ConverterParameter='post'}"
      ColumnDefinitions="Auto,*" Padding="8" BackgroundColor="#2F3337" Margin="0">
                                            <Border Grid.Column="0" HeightRequest="40" WidthRequest="40"
            BackgroundColor="#3A3A3C" StrokeThickness="1" Stroke="#FF3B6F"
            StrokeShape="RoundRectangle 20" Padding="1" Margin="0,0,8,0">
                                                <!-- Optional: Post icon -->
                                                <Path Data="M480-480ZM233.76-176.5q-24.2 0-40.73-16.53-16.53-16.53-16.53-40.73v-492.48q0-24.2 16.53-40.73 16.53-16.53 40.73-16.53h267.5v25.5H234q-14 0-23 9t-9 23v492q0 14 9 23t23 9h492q14 0 23-9t9-23v-267.5h25.5V-234q0 24.44-16.53 40.97-16.53 16.53-40.73 16.53H233.76Zm50.24-137h392.5L556-474 437-326.5l-76-87-77 100ZM678.5-599v-79.5H599V-704h79.5v-79.5H704v79.5h79.5v25.5H704v79.5h-25.5Z"
              Fill="#FF3B6F"
              HeightRequest="24" WidthRequest="24"
              HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <!-- AUTHOR NAME - ADD THIS -->
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="📱" FontSize="10" TextColor="#FF3B6F"/>
                                                    <Label Text="{Binding PostAuthor}" 
                   FontSize="12" 
                   FontAttributes="Bold"
                   TextColor="#FF3B6F"
                   VerticalOptions="Center"/>
                                                    <Label Text="shared a post" 
                   FontSize="11" 
                   TextColor="#8E8E93"
                   VerticalOptions="Center"/>
                                                </HorizontalStackLayout>

                                                <!-- Post Preview -->
                                                <Label Text="{Binding PostPreview}" 
               FontSize="13" 
               TextColor="#FFFFFF"
               LineBreakMode="TailTruncation" 
               MaxLines="2"/>

                                                <!-- Image count if any -->
                                                <Label IsVisible="{Binding MediaItems.Count, Converter={StaticResource IsGreaterThanOneConverter}}"
               Text="{Binding MediaItems.Count, StringFormat='📷 {0} image(s)'}"
               FontSize="10" TextColor="#AAAAAA" Margin="0,2,0,0"/>

                                                <!-- Action Buttons -->
                                                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                                    <Border BackgroundColor="#54738f" Padding="8,4" StrokeThickness="0"
                    StrokeShape="RoundRectangle 6" HorizontalOptions="Start">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnViewPostTapped" CommandParameter="{Binding .}"/>
                                                        </Border.GestureRecognizers>
                                                        <Label Text="View" TextColor="#FFFFFF" FontSize="10"/>
                                                    </Border>
                                                    <Border BackgroundColor="#FF3B6F" Padding="8,4" StrokeThickness="0"
                    StrokeShape="RoundRectangle 6" HorizontalOptions="Start">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnSharePostFromMessageTapped" CommandParameter="{Binding .}"/>
                                                        </Border.GestureRecognizers>
                                                        <HorizontalStackLayout Spacing="4">
                                                            <Path Data="M657.35-153q-36.35 0-61.1-24.85Q571.5-202.71 571.5-239q0-10 7.5-32L302.5-424q-12 14-28.94 22t-36.3 8q-35.11 0-59.68-25.27Q153-444.54 153-479.77q0-35.23 24.65-60.73Q202.29-566 237.5-566q19.23 0 36 7.87 16.78 7.86 28.5 21.63l245-152.08q-3.5-7.42-5.5-15.73t-2-17.19q0-35.63 24.9-60.56 24.89-24.94 61-24.94 36.1 0 60.85 25.04T711-721.15q0 35.98-24.96 60.82-24.96 24.83-60.62 24.83-19.69 0-35.8-8.25-16.11-8.25-28.12-22.75L317-513.5q3 8 5.25 16.63 2.25 8.62 2.25 16.95 0 8.32-2 16.58-2 8.27-5 16.28L561.5-294q11.79-14 28.06-22.5t35.86-8.5q35.66 0 60.62 25.25T711-239q0 36.5-24.98 61.25T657.35-153Zm-.1-17.5q29.36 0 48.81-19.44 19.44-19.45 19.44-48.81 0-29.15-19.55-48.95-19.55-19.8-48.45-19.8-29.61 0-49.06 19.91Q557-267.69 557-239q0 29.4 19.44 48.95 19.45 19.55 48.81 19.55Zm-387.75-241q29.33 0 49.41-20 20.09-20 20.09-48.25t-19.98-48.5q-19.98-20.25-49.52-20.25-28.47 0-47.74 20.25Q170.5-508 170.5-480t19.26 48.25q19.27 20.25 47.74 20.25Zm436-261.05q20-19.55 20-48.7 0-29.15-19.55-48.7-19.55-19.55-48.45-19.55-29.61 0-49.06 19.55Q557-750.4 557-721.5q0 29.4 20 48.95Q597-653 625.25-653t48.25-19.55ZM625.5-239ZM239-480Zm386.5-241.5Z"
                          Fill="#FFFFFF" 
                          Stroke="#FFFFFF"
                          StrokeThickness="1.2"
                          HeightRequest="12" WidthRequest="12" Aspect="Uniform"/>
                                                            <Label Text="Share" TextColor="#FFFFFF" FontSize="10"/>
                                                        </HorizontalStackLayout>
                                                    </Border>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- ENDORSEMENT REQUEST CARD - INCOMING -->
                                        <Grid IsVisible="{Binding MessageType, Converter={StaticResource IsEqualToConverter}, ConverterParameter='endorsement_request'}"
      ColumnDefinitions="*,Auto" Padding="8" BackgroundColor="#2F3337" Margin="0">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnEndorsementRequestTapped" CommandParameter="{Binding .}"/>
                                            </Grid.GestureRecognizers>
                                            <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="📝" FontSize="14" TextColor="#FF3B6F"/>
                                                    <Label Text="ENDORSEMENT REQUEST" 
                   FontSize="10" 
                   FontAttributes="Bold"
                   TextColor="#FF3B6F"/>
                                                    <!-- Status indicator -->
                                                    <Label IsVisible="{Binding EndorsementStatus, Converter={StaticResource IsEqualToConverter}, ConverterParameter='accepted'}"
                   Text="✓ Accepted" 
                   FontSize="9" 
                   FontAttributes="Bold"
                   TextColor="#10B981"/>
                                                    <Label IsVisible="{Binding EndorsementStatus, Converter={StaticResource IsEqualToConverter}, ConverterParameter='declined'}"
                   Text="✗ Declined" 
                   FontSize="9" 
                   FontAttributes="Bold"
                   TextColor="#FF4444"/>
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding EndorsementRequestorName, StringFormat='{0} is asking for an endorsement'}"
               FontSize="14" 
               FontAttributes="Bold"
               TextColor="#FFFFFF"/>
                                                <Label Text="{Binding EndorsementTestimonial}"
               FontSize="12" 
               TextColor="#AAAAAA"
               LineBreakMode="WordWrap"
               MaxLines="2"/>
                                                <Label Text="{Binding EndorsementRating}"
               FontSize="11" 
               TextColor="#FFD700"/>
                                                <!-- Only show "Tap to respond" if still pending -->
                                                <Label IsVisible="{Binding EndorsementStatus, Converter={StaticResource IsEqualToConverter}, ConverterParameter='pending'}" 
               Text="Tap to respond" 
               FontSize="10" 
               TextColor="#008080"
               Margin="0,4,0,0"/>
                                                <Label IsVisible="{Binding EndorsementStatus, Converter={StaticResource IsEqualToConverter}, ConverterParameter='accepted'}" 
               Text="You accepted this endorsement" 
               FontSize="10" 
               TextColor="#10B981"
               Margin="0,4,0,0"/>
                                                <Label IsVisible="{Binding EndorsementStatus, Converter={StaticResource IsEqualToConverter}, ConverterParameter='declined'}" 
               Text="You declined this endorsement" 
               FontSize="10" 
               TextColor="#FF4444"
               Margin="0,4,0,0"/>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" HeightRequest="40" WidthRequest="40"
            BackgroundColor="#FF3B6F20" StrokeThickness="1" Stroke="#FF3B6F"
            StrokeShape="RoundRectangle 20" Padding="1" Margin="8,0,0,0">
                                                <Label Text="📝" FontSize="20" TextColor="#FF3B6F"
               HorizontalOptions="Center" VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>
                                        <!-- SOS ALERT - INCOMING -->
                                        <VerticalStackLayout 
                                IsVisible="{Binding MessageType, Converter={StaticResource IsEqualToConverter}, ConverterParameter='sos_alert'}"
                                Spacing="4"
                                Padding="10,8">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="🚨" FontSize="15" VerticalOptions="Center"/>
                                                <Label Text="SOS ALERT" 
                                           FontSize="12" 
                                           FontAttributes="Bold"
                                           TextColor="White"
                                           VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding Content}"
                                       FontSize="13"
                                       TextColor="White"
                                       LineBreakMode="WordWrap"/>
                                        </VerticalStackLayout>

                                        <!-- GIFT CARD - INCOMING -->
                                        <VerticalStackLayout
    IsVisible="{Binding MessageType, Converter={StaticResource IsEqualToConverter}, ConverterParameter='gift'}"
    Spacing="4"
