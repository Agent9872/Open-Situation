                                        <!-- Bin body -->
                                        <Path Data="M15,7 L15,15 A1.5,1.5 0 0 1 13.5,16.5 L6.5,16.5 A1.5,1.5 0 0 1 5,15 L5,7
                         M8,7 L8,5.5 A1.5,1.5 0 0 1 9.5,4 L10.5,4 A1.5,1.5 0 0 1 12,5.5 L12,7"
                  Stroke="#FF3B6F"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  StrokeLineJoin="Round"
                  Fill="Transparent"/>

                                        <!-- Lines inside -->
                                        <Line X1="7" Y1="10" X2="13" Y2="10"
                  Stroke="#FF3B6F"
                  StrokeThickness="1.2"
                  StrokeLineCap="Round"/>

                                        <Line X1="7" Y1="13" X2="13" Y2="13"
                  Stroke="#FF3B6F"
                  StrokeThickness="1.2"
                  StrokeLineCap="Round"/>
                                    </Grid>
                                </ContentView>

                                <Label Grid.Column="1"
           Text="Delete"
           Style="{StaticResource ActionLabelStyle}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#39393B" />

                            <!-- REPORT -->
                            <Grid Padding="10,8" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OverlayAction_Clicked"
                                          CommandParameter="Report" />
                                </Grid.GestureRecognizers>

                                <ContentView Grid.Column="0" WidthRequest="18" HeightRequest="20">
                                    <Grid>
                                        <Line X1="4" Y1="4" X2="4" Y2="18" Stroke="#008080"/>
                                        <Path Data="M4,5 L14,5 L11,9 L14,13 L4,13 Z"
                              Stroke="#008080"/>
                                    </Grid>
                                </ContentView>

                                <Label Grid.Column="1" Text="Report"
                       Style="{StaticResource ActionLabelStyle}" />
                            </Grid>

                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- ── Loading Overlay ── -->
        <Grid x:Name="LoadingOverlay"
Grid.Row="0"
Grid.RowSpan="5"
BackgroundColor="#0B0B10"
ZIndex="9999"
IsVisible="True">

            <Ellipse WidthRequest="260" HeightRequest="260"
       HorizontalOptions="Center" VerticalOptions="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" Radius="0.5">
                        <GradientStop Color="#1AFF3B6F" Offset="0.0"/>
                        <GradientStop Color="#00FF3B6F" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="0">

                <Grid WidthRequest="80" HeightRequest="80"
        HorizontalOptions="Center" Margin="0,0,0,24">

                    <Ellipse x:Name="ChatSpinRing"
               WidthRequest="80" HeightRequest="80"
               Stroke="#33FF3B6F" StrokeThickness="1.5"
               HorizontalOptions="Center" VerticalOptions="Center"/>

                    <Ellipse x:Name="ChatRingDot"
               WidthRequest="7" HeightRequest="7"
               Fill="#FF3B6F"
               HorizontalOptions="Center" VerticalOptions="Start"/>

                    <Image x:Name="ChatHeartIcon"
             Source="heart_solid.png"
             WidthRequest="28" HeightRequest="28"
             HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Label Text="OS"
         FontFamily="CormorantGaramond-Light"
         FontSize="32" TextColor="#F5F0FF"
         CharacterSpacing="2"
         HorizontalOptions="Center"
         Margin="0,0,0,4"/>

                <Label Text="FIND YOUR PERSON"
         FontFamily="DMSans-Regular"
         FontSize="10" TextColor="#5A5A72"
         CharacterSpacing="4"
         HorizontalOptions="Center"
         Margin="0,0,0,44"/>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Ellipse x:Name="ChatDot1" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                    <Ellipse x:Name="ChatDot2" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                    <Ellipse x:Name="ChatDot3" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                    <Ellipse x:Name="ChatDot4" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                    <Ellipse x:Name="ChatDot5" WidthRequest="6" HeightRequest="6" Fill="#3A3A4C"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="Loading messages"
     FontFamily="DMSans-Regular"
     FontSize="10" TextColor="#3A3A4C"
     CharacterSpacing="3"
     HorizontalOptions="Center"
     VerticalOptions="End"
     Margin="0,0,0,52"/>
        </Grid>

        <!-- Full Screen Image Viewer Overlay -->
        <Grid x:Name="FullScreenImageOverlay"
IsVisible="False"
BackgroundColor="#000000"
Grid.RowSpan="5"
ZIndex="1000">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="FullScreenOverlay_Tapped" />
            </Grid.GestureRecognizers>

            <!-- Top bar -->
            <Grid HorizontalOptions="Fill"
    VerticalOptions="Start"
    HeightRequest="56"
    Padding="12,0"
    ZIndex="1001">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
          Text="✕"
          FontSize="16"
          TextColor="White"
          BackgroundColor="#60000000"
          WidthRequest="36"
          HeightRequest="36"
          CornerRadius="18"
          HorizontalOptions="Start"
          VerticalOptions="Center"
          Clicked="CloseFullScreenImage_Clicked"
          Padding="0" />

                <Label x:Name="ImageCounterLabel"
         Grid.Column="1"
         Text="1 / 5"
         FontSize="12"
         TextColor="White"
         HorizontalOptions="Center"
         VerticalOptions="Center" />

                <Button Grid.Column="2"
          Text="⬇"
          FontSize="16"
          TextColor="White"
          BackgroundColor="#60000000"
          WidthRequest="36"
          HeightRequest="36"
          CornerRadius="18"
          HorizontalOptions="End"
          VerticalOptions="Center"
          Clicked="DownloadImage_Clicked"
          Padding="0" />
            </Grid>

            <!-- Main Image CollectionView -->
            <CollectionView x:Name="FullScreenImageCollection"
              ItemsSource="{Binding FullScreenImages}"
              SelectedItem="{Binding SelectedFullScreenImage}"
              SelectionMode="Single"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              BackgroundColor="Black"
              Margin="0,56,0,72">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="0"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid BackgroundColor="Black"
                WidthRequest="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=Width}">
                            <Image Source="{Binding Path}"
                     Aspect="AspectFit"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Navigation buttons -->
            <HorizontalStackLayout HorizontalOptions="Center"
                     VerticalOptions="End"
                     Spacing="10"
                     Margin="0,0,0,16"
                     ZIndex="1001">
                <Button Text="◀"
          FontSize="14"
          TextColor="White"
          BackgroundColor="#50000000"
          WidthRequest="38"
          HeightRequest="38"
          CornerRadius="19"
          Clicked="PreviousImage_Clicked"
          Padding="0" />
                <Button Text="▶"
          FontSize="14"
          TextColor="White"
          BackgroundColor="#50000000"
          WidthRequest="38"
          HeightRequest="38"
          CornerRadius="19"
          Clicked="NextImage_Clicked"
          Padding="0" />
            </HorizontalStackLayout>
        </Grid>
        <!-- Top pulse animation -->
        <BoxView x:Name="ActionPulse"
           Grid.Row="0"
           HeightRequest="2"
           Color="#FF3B6F"
           HorizontalOptions="Fill"
           VerticalOptions="Start"
           IsVisible="False"
           Opacity="0"
           ZIndex="1000" />

       
    </Grid>
</ContentPage>