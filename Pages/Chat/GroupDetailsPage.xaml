<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Lock.Converter.Chat"
             x:Class="Lock.Pages.Chat.GroupDetailsPage"
             BackgroundColor="#121212"
             Title="Group Details">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Cover Image -->
            <Grid HeightRequest="200">
                <Image Source="{Binding Group.CoverImagePath}"
                       Aspect="AspectFill"
                       IsVisible="{Binding Group.HasCoverImage}">
                    <Image.Clip>
                        <RectangleGeometry />
                    </Image.Clip>
                </Image>
                <Border BackgroundColor="#80000000"
                        StrokeThickness="0"
                        IsVisible="{Binding Group.HasCoverImage, Converter={StaticResource InverseBool}}">
                    <Label Text="{Binding Group.GroupTypeIcon}"
                           FontSize="80"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>

                <!-- Back Button -->
                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        WidthRequest="40" HeightRequest="40"
                        Padding="8"
                        Margin="12,40,0,0"
                        HorizontalOptions="Start"
                        VerticalOptions="Start">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M15 18l-6-6 6-6"
                          Stroke="White"
                          StrokeThickness="2"
                          StrokeLineCap="Round"
                          StrokeLineJoin="Round"
                          WidthRequest="20" HeightRequest="20" />
                </Border>
            </Grid>

            <!-- Group Info -->
            <VerticalStackLayout Padding="20" Spacing="12">

                <!-- Name and Type -->
                <Label Text="{Binding Group.Name}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="White" />

                <HorizontalStackLayout Spacing="8">
                    <Border BackgroundColor="#1A3A3A"
                            Padding="8,4"
                            StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Group.GroupTypeDisplay}"
                               FontSize="12"
                               TextColor="#008080" />
                    </Border>

                    <Border BackgroundColor="#1A2A3A"
                            Padding="8,4"
                            StrokeThickness="0"
                            IsVisible="{Binding Group.MoodFilter, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Group.MoodFilter}"
                               FontSize="12"
                               TextColor="#6699CC" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Stats -->
                <Grid ColumnDefinitions="*,*,*" Padding="0,8" RowSpacing="8">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Group.MemberCount}"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Members"
                               FontSize="12"
                               TextColor="#888888"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Group.CreatedAt, StringFormat='{0:MMM d, yyyy}'}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Created"
                               FontSize="12"
                               TextColor="#888888"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Group.LastActiveRelative}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="White"
                               HorizontalOptions="Center" />
                        <Label Text="Active"
                               FontSize="12"
                               TextColor="#888888"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>

                <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,8" />

                <!-- Description -->
                <Label Text="Description"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#008080" />
                <Label Text="{Binding Group.Description}"
                       FontSize="14"
                       TextColor="#CCCCCC"
                       LineBreakMode="WordWrap" />

                <BoxView HeightRequest="1" Color="#2A2A2A" Margin="0,8" />

                <!-- Join Button -->
                <Button x:Name="JoinButton"
                        Text="{Binding JoinButtonText}"
                        BackgroundColor="#008080"
                        TextColor="White"
                        FontSize="16"
                        HeightRequest="50"
                        CornerRadius="25"
                        Clicked="OnJoinButtonClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>