<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Lock.Pages.Chat.ContactPickerPopup"
               Size="400,600"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <Border BackgroundColor="#1C1C1E"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 24"
            Padding="0"
            Margin="20"
            MaximumWidthRequest="420">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="0">

            <!-- Header -->
            <Border Grid.Row="0"
                    BackgroundColor="#2C2C2E"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24 24 0 0"
                    Padding="20,16">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="4">
                        <Label Text="Share Contact"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="#FFFFFF"/>
                        <Label Text="Select a contact to share with"
                               FontSize="13"
                               TextColor="#8E8E93"/>
                    </VerticalStackLayout>

                    <!-- Close button -->
                    <Border Grid.Column="1"
                            BackgroundColor="#3A3A3C"
                            Padding="8"
                            HeightRequest="36"
                            WidthRequest="36"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseTapped" />
                        </Border.GestureRecognizers>
                        <Path Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                              Fill="#8E8E93"
                              HeightRequest="16"
                              WidthRequest="16"
                              Aspect="Uniform"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Contact Card Preview -->
            <Border Grid.Row="1"
                    BackgroundColor="#2C2C2E"
                    StrokeThickness="1"
                    Stroke="#3A3A3C"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    Margin="20,16">
                <Grid RowDefinitions="Auto,Auto,Auto"
                      RowSpacing="12"
                      HorizontalOptions="Center">

                    <!-- Profile Image with subtle glow -->
                    <Border Grid.Row="0"
                            HeightRequest="80"
                            WidthRequest="80"
                            BackgroundColor="#3A3A3C"
                            StrokeThickness="2"
                            Stroke="#FF3B6F"
                            StrokeShape="RoundRectangle 40"
                            Padding="2">
                        <Image Source="{Binding SourceContactProfileImage, FallbackValue='default_profile.png'}"
                               Aspect="AspectFill"
                               HeightRequest="74"
                               WidthRequest="74">
                            <Image.Clip>
                                <EllipseGeometry RadiusX="37" RadiusY="37" Center="37,37" />
                            </Image.Clip>
                        </Image>
                    </Border>

                    <!-- Contact Name -->
                    <Label Grid.Row="1"
                           Text="{Binding SourceContactName}"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#FFFFFF"
                           HorizontalOptions="Center"/>

                    <!-- Phone Number with icon -->
                    <HorizontalStackLayout Grid.Row="2"
                                           Spacing="8"
                                           HorizontalOptions="Center">
                        <Path Data="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
                              Fill="#FF3B6F"
                              HeightRequest="18"
                              WidthRequest="18"
                              Aspect="Uniform"/>
                        <Label Text="{Binding SourceContactPhone}"
                               FontSize="15"
                               TextColor="#8E8E93"/>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <!-- Gray separator -->
            <BoxView Grid.Row="2"
                     HeightRequest="1"
                     BackgroundColor="#333333"
                     Margin="20,0"/>

            <!-- Search Bar -->
            <Border Grid.Row="2"
                    BackgroundColor="#2C2C2E"
                    StrokeThickness="0"
                    Padding="20,12">
                <Grid BackgroundColor="#3A3A3C"
                      Padding="12,8"
                      HeightRequest="44">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Source="search_icon.png"
                           WidthRequest="18"
                           HeightRequest="18"
                           Aspect="AspectFit"
                           Opacity="0.6"/>

                    <Entry Grid.Column="1"
                           x:Name="SearchEntry"
                           Placeholder="Search contacts..."
                           PlaceholderColor="#8E8E93"
                           BackgroundColor="Transparent"
                           TextColor="#FFFFFF"
                           FontSize="14"
                           Margin="8,0,0,0"
                           VerticalOptions="Center"
                           TextChanged="SearchEntry_TextChanged"/>
                </Grid>
            </Border>

            <!-- Contacts List -->
            <CollectionView Grid.Row="3"
                            x:Name="ContactsCollectionView"
                            ItemsSource="{Binding DisplayedContacts}"
                            SelectionMode="None"
                            BackgroundColor="#1C1C1E"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <!-- Contact Item with elegant design -->
                            <Grid Padding="16,12"
                                  BackgroundColor="#1C1C1E"
                                  ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnContactTapped"
                                                          CommandParameter="{Binding .}"
                                                          NumberOfTapsRequired="1" />
                                </Grid.GestureRecognizers>

                                <!-- Profile Image with subtle border -->
                                <Border Grid.Column="0"
                                        HeightRequest="48"
                                        WidthRequest="48"
                                        BackgroundColor="#3A3A3C"
                                        StrokeThickness="1"
                                        Stroke="#3A3A3C"
                                        StrokeShape="RoundRectangle 24"
                                        Padding="1">
                                    <Image Source="{Binding ProfileImagePath, FallbackValue='default_profile.png'}"
                                           Aspect="AspectFill"
                                           HeightRequest="44"
                                           WidthRequest="44">
                                        <Image.Clip>
                                            <EllipseGeometry RadiusX="22" RadiusY="22" Center="22,22" />
                                        </Image.Clip>
                                    </Image>
                                </Border>

                                <!-- Contact Info -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4"
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#FFFFFF"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding PhoneNumber}"
                                           FontSize="13"
                                           TextColor="#8E8E93"
                                           LineBreakMode="TailTruncation"/>
                                </VerticalStackLayout>

                                <!-- Share Button with tooltip -->
                                <Border Grid.Column="2"
                                        BackgroundColor="#2C2C2E"
                                        Padding="8"
                                        HeightRequest="36"
                                        WidthRequest="36"
                                        StrokeThickness="1"
                                        Stroke="#3A3A3C"
                                        StrokeShape="RoundRectangle 10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnShareIconTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Image Source="share_icon.png"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           Aspect="AspectFit">
                                        <Image.Resources>
                                            <Style TargetType="Image">
                                                <Setter Property="Opacity" Value="0.9"/>
                                            </Style>
                                        </Image.Resources>
                                    </Image>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="#333333"
                                     Margin="16,0,16,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Bottom Buttons -->
            <Border Grid.Row="4"
                    BackgroundColor="#2C2C2E"
                    StrokeThickness="1"
                    Stroke="#333333"
                    StrokeShape="RoundRectangle 0 0 24 24"
                    Padding="20,16">
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Border Grid.Column="0"
                            BackgroundColor="#3A3A3C"
                            Padding="16,12"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCancelTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Cancel"
                               TextColor="#8E8E93"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <Border Grid.Column="1"
                            BackgroundColor="#FF3B6F"
                            Padding="16,12"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShareAllTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="Share All"
                               TextColor="#FFFFFF"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</toolkit:Popup>