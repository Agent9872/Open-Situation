<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Lock.Converter.Chat"
             x:Class="Lock.Pages.Chat.ChatSearchPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#0E0E12">

    <ContentPage.Resources>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0">

        <VerticalStackLayout Grid.Row="0" Padding="16,12,16,16" Spacing="16" BackgroundColor="#0E0E12">

            <Grid ColumnDefinitions="40,*,40">
                <Grid HeightRequest="40" WidthRequest="40">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked" />
                    </Grid.GestureRecognizers>
                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                          Fill="#00B5B5" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Grid>

                <Label Grid.Column="1" Text="Search" HorizontalOptions="Center" 
                       VerticalOptions="Center" TextColor="#F0EDE8" FontSize="18" FontAttributes="Bold"/>

                <Label Grid.Column="2" Text="Clear" TextColor="#7A7A8C" FontSize="14" 
                       HorizontalOptions="End" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCancelClicked" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Border Stroke="#2A2A38" StrokeThickness="1" BackgroundColor="#1C1C25" 
                    StrokeShape="RoundRectangle 12" HeightRequest="50" Padding="12,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.29,20.41L13.01,15.14C11.91,15.7 10.74,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                          Fill="#555566" VerticalOptions="Center" WidthRequest="18" HeightRequest="18"/>

                    <Entry x:Name="SearchBar" Grid.Column="1" Placeholder="Search messages..."
                           PlaceholderColor="#555566" TextColor="#F0EDE8" FontSize="15"
                           Margin="8,0" BackgroundColor="Transparent" VerticalOptions="Center"
                           TextChanged="OnSearchTextChanged"/>

                    <ActivityIndicator Grid.Column="2" IsRunning="{Binding IsBusy}" 
                                       Color="#00B5B5" HeightRequest="20" WidthRequest="20" Scale="0.8"/>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <Border Grid.Row="1" BackgroundColor="#16161D" StrokeThickness="0" Padding="20,8">
            <Label x:Name="ResultsCountLabel" Text="Found 12 messages" 
                   TextColor="#7A7A8C" FontSize="12" IsVisible="True"/>
        </Border>

        <CollectionView x:Name="SearchResultsView" Grid.Row="2"
                        SelectionMode="Single" SelectionChanged="OnResultSelected"
                        ItemsSource="{Binding SearchResults}">

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="20" VerticalOptions="Center" Padding="40">
                    <Path Data="M15.5,12C18,12 20,14 20,16.5C20,17.38 19.75,18.21 19.31,18.9L22.39,22L21,23.39L17.88,20.32C17.46,20.75 16.88,21 16.25,21C14.13,21 12.41,19.28 12.41,17.16C12.41,15.04 14.13,13.32 16.25,13.32C18.37,13.32 20.09,15.04 20.09,17.16C20.09,17.6 20.01,18.04 19.85,18.44L18.56,17.15C18.41,16.03 17.44,15.16 16.25,15.16C15.15,15.16 14.25,16.06 14.25,17.16C14.25,18.26 15.15,19.16 16.25,19.16C16.67,19.16 17.06,19.03 17.39,18.81L18.68,20.1C18,20.67 17.13,21 16.16,21C13.66,21 11.66,19 11.66,16.5C11.66,14 13.66,12 16.16,12M15.5,2H5C3.89,2 3,2.89 3,4V20C3,21.11 3.89,22 5,22H11.03L9.03,20H5V4H15V9H20V10.53L22,12.53V8L16,2Z"
                          Fill="#1C1C25" HorizontalOptions="Center" HeightRequest="80" WidthRequest="80"/>
                    <Label Text="No conversations found" TextColor="#F0EDE8" 
                           FontSize="16" FontAttributes="Bold" HorizontalOptions="Center"/>
                    <Label Text="Refine your search to find specific chat details" 
                           TextColor="#555566" HorizontalTextAlignment="Center" FontSize="14"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="16,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">

                        <Grid Grid.Column="0" VerticalOptions="Start">
                            <Border HeightRequest="52" 
            WidthRequest="52" 
            StrokeShape="RoundRectangle 26" 
            StrokeThickness="0"
            Padding="0">
                                <Image Source="{Binding SenderProfileImage}" 
               Aspect="AspectFill"
               HorizontalOptions="Fill"
               VerticalOptions="Fill"
               IsVisible="{Binding HasProfileImage}"/>
                            </Border>

                            <Border HeightRequest="52" 
            WidthRequest="52" 
            StrokeShape="RoundRectangle 26" 
            BackgroundColor="#2A2A38" 
            StrokeThickness="0"
            IsVisible="{Binding HasProfileImage, Converter={StaticResource InverseBoolConverter}}">
                                <Label Text="{Binding SenderInitials}" 
               TextColor="#00B5B5" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               VerticalOptions="Center"/>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding SenderName}" TextColor="#F0EDE8" FontSize="15" 
                                       FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                <Label Grid.Column="1" Text="{Binding SentAt, StringFormat='{0:t}'}" 
                                       TextColor="#7A7A8C" FontSize="11" Margin="8,0,0,0"/>
                            </Grid>

                            <Label Text="{Binding HighlightedContent}" TextColor="#AAAAAA" FontSize="14"
                                   LineBreakMode="TailTruncation" MaxLines="2" CharacterSpacing="0.2"/>

                            <HorizontalStackLayout Spacing="6" Margin="0,4,0,0">
                                <Border IsVisible="{Binding IsVoiceMessage}" BackgroundColor="#1A00B5B5" 
                                        StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="6,2">
                                    <Label Text="🎤 VOICE" TextColor="#00B5B5" FontSize="9" FontAttributes="Bold"/>
                                </Border>
                                <Border IsVisible="{Binding HasMedia}" BackgroundColor="#1A4CAF50" 
                                        StrokeThickness="0" StrokeShape="RoundRectangle 4" Padding="6,2">
                                    <Label Text="{Binding MediaCount, StringFormat='📷 {0} MEDIA'}" 
                                           TextColor="#4CAF50" FontSize="9" FontAttributes="Bold"/>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <Path Grid.Column="2" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
                              Fill="#2A2A38" VerticalOptions="Center" HorizontalOptions="End"/>

                        <BoxView Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" HeightRequest="0.5" 
                                 BackgroundColor="#1C1C25" VerticalOptions="End" Margin="0,12,0,-12"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>