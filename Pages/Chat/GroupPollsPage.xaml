<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lock.Pages.Chat.GroupPollsPage"
             BackgroundColor="#0F0F0F"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="Auto,*">

        <!-- ══ HEADER ══ -->
        <Grid Grid.Row="0" Padding="16,8,16,8" BackgroundColor="#0F0F0F"
              ColumnDefinitions="Auto,*,Auto">

            <Grid Grid.Column="0" WidthRequest="40" HeightRequest="40" VerticalOptions="Center">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                </Grid.GestureRecognizers>
                <Label Text="←" FontSize="22" TextColor="#888888"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Grid>

            <VerticalStackLayout Grid.Column="1" Spacing="2" Margin="8,0">
                <Label Text="Group Polls" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF"/>
                <Label x:Name="PollCountLabel" Text="Loading…"
                       FontSize="12" TextColor="#666666"/>
            </VerticalStackLayout>

            <!-- Create Poll button (admin only) -->
            <Frame Grid.Column="2"
                   x:Name="CreatePollButton"
                   IsVisible="False"
                   Padding="0" CornerRadius="20"
                   BackgroundColor="#FF3B6F" HasShadow="False" BorderColor="Transparent"
                   VerticalOptions="Center">
                <Button Text="+ Poll"
                        BackgroundColor="Transparent" TextColor="White"
                        FontAttributes="Bold" FontSize="12" Padding="14,6"
                        Clicked="OnToggleCreatePoll"/>
            </Frame>
        </Grid>

        <!-- ══ BODY ══ -->
        <ScrollView Grid.Row="1" BackgroundColor="#0F0F0F"
                    VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Padding="16,4,16,40" Spacing="12">

                <!-- ══════════════════════════════════════════════ -->
                <!-- CREATE POLL CARD (Twitter-style compact form)  -->
                <!-- ══════════════════════════════════════════════ -->
                <Frame x:Name="CreatePollCard"
                       IsVisible="False"
                       CornerRadius="18" HasShadow="False"
                       BorderColor="#252525" BackgroundColor="#161616"
                       Padding="16">
                    <VerticalStackLayout Spacing="12">

                        <!-- Card header -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="1">
                                <Label Text="New Poll" FontSize="16" FontAttributes="Bold"
                                       TextColor="#FFFFFF"/>
                                <Label Text="Ask your group anything" FontSize="11"
                                       TextColor="#555555"/>
                            </VerticalStackLayout>
                            <Grid Grid.Column="1" WidthRequest="32" HeightRequest="32"
                                  VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCancelCreatePollTapped"/>
                                </Grid.GestureRecognizers>
                                <Label Text="✕" FontSize="14" TextColor="#555555"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#1E1E1E"/>

                        <!-- Question entry -->
                        <Frame CornerRadius="12" HasShadow="False"
                               BorderColor="#008080" BackgroundColor="#0D1A1A" Padding="14,10">
                            <Entry x:Name="PollQuestionEntry"
                                   Placeholder="What's your question?"
                                   PlaceholderColor="#3A6A6A"
                                   TextColor="#FFFFFF"
                                   FontSize="14" FontAttributes="Bold"
                                   BackgroundColor="Transparent"
                                   TextChanged="OnQuestionTextChanged"/>
                        </Frame>

                        <!-- Options (Twitter-style pill buttons) -->
                        <Label Text="OPTIONS" FontSize="9" FontAttributes="Bold"
                               TextColor="#444444" CharacterSpacing="1.5" Margin="2,0"/>

                        <!-- Option 1 -->
                        <Frame CornerRadius="12" HasShadow="False"
                               BorderColor="#2A2A2A" BackgroundColor="#1A1A1A" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="A" FontSize="12" FontAttributes="Bold"
                                       TextColor="#008080" WidthRequest="24"
                                       VerticalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="Option1Entry"
                                       Placeholder="Option 1"
                                       PlaceholderColor="#444444"
                                       TextColor="#FFFFFF" FontSize="13"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnOptionTextChanged"/>
                            </Grid>
                        </Frame>

                        <!-- Option 2 -->
                        <Frame CornerRadius="12" HasShadow="False"
                               BorderColor="#2A2A2A" BackgroundColor="#1A1A1A" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0" Text="B" FontSize="12" FontAttributes="Bold"
                                       TextColor="#008080" WidthRequest="24"
                                       VerticalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="Option2Entry"
                                       Placeholder="Option 2"
                                       PlaceholderColor="#444444"
                                       TextColor="#FFFFFF" FontSize="13"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnOptionTextChanged"/>
                            </Grid>
                        </Frame>

                        <!-- Option 3 (optional) -->
                        <Frame x:Name="Option3Frame" IsVisible="False"
                               CornerRadius="12" HasShadow="False"
                               BorderColor="#2A2A2A" BackgroundColor="#1A1A1A" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="C" FontSize="12" FontAttributes="Bold"
                                       TextColor="#FF3B6F" WidthRequest="24"
                                       VerticalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="Option3Entry"
                                       Placeholder="Option 3 (optional)"
                                       PlaceholderColor="#444444"
                                       TextColor="#FFFFFF" FontSize="13"
                                       BackgroundColor="Transparent"/>
                                <Grid Grid.Column="2" WidthRequest="28" HeightRequest="28"
                                      VerticalOptions="Center">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRemoveOption3Tapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="✕" FontSize="12" TextColor="#FF3B6F"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Grid>
                            </Grid>
                        </Frame>

                        <!-- Option 4 (optional) -->
                        <Frame x:Name="Option4Frame" IsVisible="False"
                               CornerRadius="12" HasShadow="False"
                               BorderColor="#2A2A2A" BackgroundColor="#1A1A1A" Padding="14,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="D" FontSize="12" FontAttributes="Bold"
                                       TextColor="#FF3B6F" WidthRequest="24"
                                       VerticalOptions="Center"/>
                                <Entry Grid.Column="1"
                                       x:Name="Option4Entry"
                                       Placeholder="Option 4 (optional)"
                                       PlaceholderColor="#444444"
                                       TextColor="#FFFFFF" FontSize="13"
                                       BackgroundColor="Transparent"/>
                                <Grid Grid.Column="2" WidthRequest="28" HeightRequest="28"
                                      VerticalOptions="Center">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRemoveOption4Tapped"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="✕" FontSize="12" TextColor="#FF3B6F"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Grid>
                            </Grid>
                        </Frame>

                        <!-- Add option link -->
                        <Label x:Name="AddOptionLabel"
                               Text="+ Add another option"
                               FontSize="12" TextColor="#008080"
                               FontAttributes="Bold" Margin="4,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddOptionTapped"/>
                            </Label.GestureRecognizers>
                        </Label>

                        <BoxView HeightRequest="1" Color="#1E1E1E"/>

                        <!-- Settings row: multi-vote + duration -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                            <!-- Multiple votes toggle -->
                            <Frame CornerRadius="12" HasShadow="False"
                                   BorderColor="#252525" BackgroundColor="#1A1A1A" Padding="12,10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1"
                                                         VerticalOptions="Center">
                                        <Label Text="Multi-vote" FontSize="12"
                                               FontAttributes="Bold" TextColor="#FFFFFF"/>
                                        <Label Text="Allow multiple" FontSize="10"
                                               TextColor="#555555"/>
                                    </VerticalStackLayout>
                                    <Switch x:Name="AllowMultipleSwitch" Grid.Column="1"
                                            ThumbColor="#008080" OnColor="#008080"
                                            Scale="0.8" VerticalOptions="Center"/>
                                </Grid>
                            </Frame>

                            <!-- Duration -->
                            <Frame CornerRadius="12" HasShadow="False"
                                   BorderColor="#252525" BackgroundColor="#1A1A1A" Padding="12,10">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDurationTapped"/>
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1"
                                                         VerticalOptions="Center">
                                        <Label Text="Duration" FontSize="12"
                                               FontAttributes="Bold" TextColor="#FFFFFF"/>
                                        <Label x:Name="DurationLabel" Text="7 days"
                                               FontSize="10" TextColor="#008080"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="⌄" FontSize="14"
                                           TextColor="#008080" VerticalOptions="Center"/>
                                </Grid>
                            </Frame>
                        </Grid>

                        <!-- Duration picker dropdown -->
                        <Frame x:Name="DurationOptions" IsVisible="False"
                               CornerRadius="12" HasShadow="False"
                               BorderColor="#252525" BackgroundColor="#1A1A1A" Padding="10">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="PICK DURATION" FontSize="9" FontAttributes="Bold"
                                       TextColor="#444444" CharacterSpacing="1.5"/>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Frame CornerRadius="8" HasShadow="False" Padding="0"
                                           BorderColor="#252525" BackgroundColor="#252525">
                                        <Button Text="1h" BackgroundColor="Transparent"
                                                TextColor="#008080" FontSize="12"
                                                HeightRequest="34"
                                                Clicked="OnDurationPreset" CommandParameter="1h"/>
                                    </Frame>
                                    <Frame CornerRadius="8" HasShadow="False" Padding="0"
                                           BorderColor="#252525" BackgroundColor="#252525">
                                        <Button Text="6h" BackgroundColor="Transparent"
                                                TextColor="#008080" FontSize="12"
                                                HeightRequest="34"
                                                Clicked="OnDurationPreset" CommandParameter="6h"/>
                                    </Frame>
                                    <Frame CornerRadius="8" HasShadow="False" Padding="0"
                                           BorderColor="#252525" BackgroundColor="#252525">
                                        <Button Text="12h" BackgroundColor="Transparent"
                                                TextColor="#008080" FontSize="12"
                                                HeightRequest="34"
                                                Clicked="OnDurationPreset" CommandParameter="12h"/>
                                    </Frame>
                                    <Frame CornerRadius="8" HasShadow="False" Padding="0"
                                           BorderColor="#252525" BackgroundColor="#252525">
                                        <Button Text="1d" BackgroundColor="Transparent"
                                                TextColor="#008080" FontSize="12"
                                                HeightRequest="34"
                                                Clicked="OnDurationPreset" CommandParameter="1d"/>
                                    </Frame>
                                </Grid>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                                    <Frame CornerRadius="8" HasShadow="False" Padding="0"
                                           BorderColor="#252525" BackgroundColor="#252525">
                                        <Button Text="3d" BackgroundColor="Transparent"
                                                TextColor="#008080" FontSize="12"
                                                HeightRequest="34"
                                                Clicked="OnDurationPreset" CommandParameter="3d"/>
                                    </Frame>
                                    <Frame CornerRadius="8" HasShadow="False" Padding="0"
                                           BorderColor="#252525" BackgroundColor="#252525">
                                        <Button Text="7d" BackgroundColor="Transparent"
                                                TextColor="#008080" FontSize="12"
                                                HeightRequest="34"
                                                Clicked="OnDurationPreset" CommandParameter="7d"/>
                                    </Frame>
                                    <Frame CornerRadius="8" HasShadow="False" Padding="0"
                                           BorderColor="#252525" BackgroundColor="#252525">
                                        <Button Text="14d" BackgroundColor="Transparent"
                                                TextColor="#008080" FontSize="12"
                                                HeightRequest="34"
                                                Clicked="OnDurationPreset" CommandParameter="14d"/>
                                    </Frame>
                                    <Frame CornerRadius="8" HasShadow="False" Padding="0"
                                           BorderColor="#252525" BackgroundColor="#252525">
                                        <Button Text="∞" BackgroundColor="Transparent"
                                                TextColor="#FF3B6F" FontSize="14"
                                                FontAttributes="Bold"
                                                HeightRequest="34"
                                                Clicked="OnDurationPreset" CommandParameter="0"/>
                                    </Frame>
                                </Grid>
                                <!-- Custom minutes -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2,0,0">
                                    <Frame CornerRadius="8" HasShadow="False" Padding="10,0"
                                           BorderColor="#2A2A2A" BackgroundColor="#252525">
                                        <Entry x:Name="CustomDurationEntry"
                                               Placeholder="Custom (minutes)"
                                               PlaceholderColor="#444444"
                                               TextColor="#FFFFFF" FontSize="12"
                                               Keyboard="Numeric"
                                               BackgroundColor="Transparent"
                                               HeightRequest="34"/>
                                    </Frame>
                                    <Frame Grid.Column="1" Padding="0" CornerRadius="8"
                                           HasShadow="False" BackgroundColor="#008080"
                                           BorderColor="Transparent">
                                        <Button Text="Set" BackgroundColor="Transparent"
                                                TextColor="White" FontSize="12"
                                                FontAttributes="Bold" Padding="14,0"
                                                HeightRequest="34"
                                                Clicked="OnSetCustomDuration"/>
                                    </Frame>
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- Submit row -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Frame CornerRadius="12" HasShadow="False" Padding="0"
                                   BorderColor="#252525" BackgroundColor="#1A1A1A">
                                <Button Text="Cancel"
                                        BackgroundColor="Transparent" TextColor="#666666"
                                        FontSize="13" HeightRequest="42"
                                        Clicked="OnCancelCreatePollClicked"/>
                            </Frame>
                            <Frame Grid.Column="1" Padding="0" CornerRadius="12"
                                   HasShadow="False" BackgroundColor="#008080"
                                   BorderColor="Transparent">
                                <Button x:Name="CreatePollSubmitButton"
                                        Text="Launch Poll 🚀"
                                        BackgroundColor="Transparent" TextColor="White"
                                        FontAttributes="Bold" FontSize="13" HeightRequest="42"
                                        IsEnabled="False"
                                        Clicked="OnCreatePollSubmit"/>
                            </Frame>
                        </Grid>

                    </VerticalStackLayout>
                </Frame>

                <!-- ══════════════════════════════════════════════ -->
                <!-- POLLS LIST                                     -->
                <!-- ══════════════════════════════════════════════ -->

                <!-- Skeleton loader -->
                <CollectionView x:Name="SkeletonView" IsVisible="True"
                                BackgroundColor="Transparent" SelectionMode="None">
                    <CollectionView.ItemsSource>
                        <x:Array Type="{x:Type x:Int32}">
                            <x:Int32>1</x:Int32>
                            <x:Int32>2</x:Int32>
                            <x:Int32>3</x:Int32>
                        </x:Array>
                    </CollectionView.ItemsSource>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,0,0,10">
                                <Frame CornerRadius="18" HasShadow="False"
                                       BorderColor="#252525" BackgroundColor="#161616" Padding="16">
                                    <VerticalStackLayout Spacing="10">
                                        <BoxView HeightRequest="14" WidthRequest="200"
                                                 BackgroundColor="#2A2A2A" CornerRadius="4"/>
                                        <BoxView HeightRequest="40" BackgroundColor="#1E1E1E"
                                                 CornerRadius="10"/>
                                        <BoxView HeightRequest="40" BackgroundColor="#1E1E1E"
                                                 CornerRadius="10"/>
                                        <BoxView HeightRequest="10" WidthRequest="80"
                                                 BackgroundColor="#2A2A2A" CornerRadius="4"
                                                 HorizontalOptions="Center"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Actual polls -->
                <CollectionView x:Name="PollsCollectionView"
                                IsVisible="False"
                                BackgroundColor="Transparent"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="0,0,0,10">

                                <!-- Poll Card — Twitter-style but dark & branded -->
                                <Frame CornerRadius="18" HasShadow="False"
                                       BorderColor="#252525" BackgroundColor="#161616"
                                       Padding="16">
                                    <VerticalStackLayout Spacing="12">

                                        <!-- ── Poll header: creator + status ── -->
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                                            <!-- Creator avatar -->
                                            <Frame Grid.Column="0"
                                                   WidthRequest="36" HeightRequest="36"
                                                   CornerRadius="18"
                                                   BackgroundColor="#0D2626"
                                                   HasShadow="False" Padding="0"
                                                   BorderColor="#008080">
                                                <Label Text="{Binding CreatorInitial}"
                                                       FontSize="14" FontAttributes="Bold"
                                                       TextColor="#008080"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"/>
                                            </Frame>

                                            <!-- Creator name + time -->
                                            <VerticalStackLayout Grid.Column="1"
                                                                  Spacing="1"
                                                                  VerticalOptions="Center">
                                                <Label Text="{Binding CreatorName}"
                                                       FontSize="13" FontAttributes="Bold"
                                                       TextColor="#FFFFFF"
                                                       MaxLines="1"
                                                       LineBreakMode="TailTruncation"/>
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="📊" FontSize="9"/>
                                                    <Label Text="{Binding CreatedRelative}"
                                                           FontSize="10" TextColor="#555555"/>
                                                    <Label Text="·" FontSize="10" TextColor="#333333"/>
                                                    <Label Text="{Binding ExpiryDisplay}"
                                                           FontSize="10" TextColor="#555555"/>
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>

                                            <!-- Status pill + menu -->
                                            <HorizontalStackLayout Grid.Column="2"
                                                                    Spacing="6"
                                                                    VerticalOptions="Center">
                                                <Border BackgroundColor="{Binding StatusBgColor}"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="7,3">
                                                    <Label Text="{Binding StatusText}"
                                                           FontSize="9" FontAttributes="Bold"
                                                           TextColor="{Binding StatusTextColor}"/>
                                                </Border>
                                                <Grid IsVisible="{Binding IsCreator}"
                                                      WidthRequest="30" HeightRequest="30">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnPollMenuTapped"
                                                                              CommandParameter="{Binding .}"/>
                                                    </Grid.GestureRecognizers>
                                                    <Label Text="⋮" FontSize="16" TextColor="#555555"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"/>
                                                </Grid>
                                            </HorizontalStackLayout>
                                        </Grid>

                                        <!-- ── Question ── -->
                                        <Label Text="{Binding Question}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="#FFFFFF"
                                               LineBreakMode="WordWrap"/>

                                        <!-- ── Options (Twitter-style pill progress bars) ── -->
                                        <CollectionView ItemsSource="{Binding Options}"
                                                        SelectionMode="None"
                                                        VerticalScrollBarVisibility="Never">
                                            <CollectionView.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Each option is a pill with fill bar -->
                                                    <Grid Padding="0,0,0,8">
                                                        <Grid.GestureRecognizers>
                                                            <TapGestureRecognizer
                                                                Tapped="OnOptionTapped"
                                                                CommandParameter="{Binding .}"/>
                                                        </Grid.GestureRecognizers>

                                                        <!-- Background track (full width, rounded) -->
                                                        <Frame CornerRadius="10" HasShadow="False"
                                                               BorderColor="{Binding OptionBorderColor}"
                                                               BackgroundColor="#1A1A1A"
                                                               Padding="0" HeightRequest="44"
                                                               IsClippedToBounds="True">

                                                            <!-- Fill bar (sits behind text) -->
                                                            <Grid>
                                                                <BoxView HeightRequest="44"
                                                                         CornerRadius="10"
                                                                         BackgroundColor="{Binding FillColor}"
                                                                         HorizontalOptions="Start"
                                                                         WidthRequest="{Binding FillWidthRequest}"
                                                                         VerticalOptions="Fill"/>

                                                                <!-- Option content -->
                                                                <Grid ColumnDefinitions="Auto,*,Auto"
                                                                      Padding="12,0">
                                                                    <!-- Letter badge -->
                                                                    <Label Grid.Column="0"
                                                                           Text="{Binding OptionLetter}"
                                                                           FontSize="12" FontAttributes="Bold"
                                                                           TextColor="{Binding LetterColor}"
                                                                           VerticalOptions="Center"
                                                                           WidthRequest="20"/>
                                                                    <!-- Option text -->
                                                                    <Label Grid.Column="1"
                                                                           Text="{Binding Text}"
                                                                           FontSize="13" FontAttributes="Bold"
                                                                           TextColor="#FFFFFF"
                                                                           VerticalOptions="Center"
                                                                           LineBreakMode="TailTruncation"
                                                                           MaxLines="1"/>
                                                                    <!-- Percentage -->
                                                                    <Label Grid.Column="2"
                                                                           Text="{Binding VotePercentage}"
                                                                           FontSize="13" FontAttributes="Bold"
                                                                           TextColor="{Binding PercentColor}"
                                                                           VerticalOptions="Center"
                                                                           IsVisible="{Binding ShowPercent}"/>
                                                                    <!-- Voted checkmark -->
                                                                    <Label Grid.Column="2"
                                                                           Text="✓"
                                                                           FontSize="14" FontAttributes="Bold"
                                                                           TextColor="#008080"
                                                                           VerticalOptions="Center"
                                                                           IsVisible="{Binding UserVotedThis}"/>
                                                                </Grid>
                                                            </Grid>
                                                        </Frame>
                                                    </Grid>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <!-- ── Footer: votes + expiry + vote/change button ── -->
                                        <Grid ColumnDefinitions="*,Auto">

                                            <!-- Left: vote count + multi-vote badge -->
                                            <HorizontalStackLayout Grid.Column="0"
                                                                    Spacing="8"
                                                                    VerticalOptions="Center">
                                                <Label Text="{Binding TotalVotesDisplay}"
                                                       FontSize="12" TextColor="#666666"
                                                       VerticalOptions="Center"/>
                                                <Border IsVisible="{Binding AllowMultipleVotes}"
                                                        BackgroundColor="#0D2626"
                                                        StrokeThickness="0.5" Stroke="#008080"
                                                        StrokeShape="RoundRectangle 6"
                                                        Padding="6,2">
                                                    <Label Text="multi-vote"
                                                           FontSize="9" TextColor="#008080"/>
                                                </Border>
                                            </HorizontalStackLayout>

                                            <!-- Right: vote button or "you voted" pill -->
                                            <Frame Grid.Column="1" Padding="0" CornerRadius="20"
                                                   HasShadow="False"
                                                   BackgroundColor="{Binding VoteButtonBgColor}"
                                                   BorderColor="Transparent"
                                                   IsVisible="{Binding ShowVoteButton}">
                                                <Button Text="{Binding VoteButtonText}"
                                                        BackgroundColor="Transparent"
                                                        TextColor="White"
                                                        FontSize="12" FontAttributes="Bold"
                                                        Padding="14,4"
                                                        Clicked="OnVoteButtonClicked"
                                                        CommandParameter="{Binding .}"/>
                                            </Frame>

                                            <!-- "Voted" badge when already voted + poll closed/open -->
                                            <Border Grid.Column="1"
                                                    IsVisible="{Binding ShowVotedBadge}"
                                                    BackgroundColor="#0D2626"
                                                    StrokeThickness="0.5" Stroke="#008080"
                                                    StrokeShape="RoundRectangle 12"
                                                    Padding="10,4">
                                                <Label Text="✓ Voted"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="#008080"
                                                       VerticalOptions="Center"/>
                                            </Border>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Frame>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Empty state -->
                <VerticalStackLayout x:Name="EmptyState"
                                     IsVisible="False"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center"
                                     Spacing="12"
                                     Margin="0,60">
                    <Label Text="📊" FontSize="52" TextColor="#333333"
                           HorizontalOptions="Center"/>
                    <Label Text="No polls yet"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="#FFFFFF" HorizontalOptions="Center"/>
                    <Label Text="Ask your group anything — create the first poll"
                           FontSize="13" TextColor="#555555"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           Margin="32,0"/>
                </VerticalStackLayout>

                <CollectionView.Footer>
                    <BoxView HeightRequest="100" BackgroundColor="Transparent"/>
                </CollectionView.Footer>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
