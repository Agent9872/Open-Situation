                                <Label Grid.Column="1"
           Text="Background image"
           TextColor="#E6E6E6"
           FontSize="14"
           VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="16,0,16,0" />

                            <!-- Block/Unblock user -->
                            <Grid Padding="16,10,16,10"
      ColumnDefinitions="28,*,Auto"
      ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnActionTapped"
