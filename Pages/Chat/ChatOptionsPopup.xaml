                                      HeightRequest="20"
                                      WidthRequest="20"
                                      Aspect="Uniform" />
                                <Label Grid.Column="1"
                                       Text="Telegram"
                                       TextColor="#E6E6E6"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Facebook -->
                            <Grid Padding="16,10,16,10"
                                  ColumnDefinitions="28,*,Auto"
                                  ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShareActionTapped"
                                                          CommandParameter="Facebook" />
                                </Grid.GestureRecognizers>
                                <Path Grid.Column="0"
                                      Data="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.8c4.56-.93 8-4.96 8-9.8z"
                                      Fill="#4267B2"
                                      HeightRequest="20"
                                      WidthRequest="20"
                                      Aspect="Uniform" />
                                <Label Grid.Column="1"
                                       Text="Facebook"
                                       TextColor="#E6E6E6"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Twitter/X -->
                            <Grid Padding="16,10,16,10"
                                  ColumnDefinitions="28,*,Auto"
                                  ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShareActionTapped"
                                                          CommandParameter="Twitter" />
                                </Grid.GestureRecognizers>
                                <Path Grid.Column="0"
                                      Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                      Fill="#1DA1F2"
                                      HeightRequest="20"
                                      WidthRequest="20"
                                      Aspect="Uniform" />
                                <Label Grid.Column="1"
                                       Text="Twitter / X"
                                       TextColor="#E6E6E6"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Copy Link -->
                            <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="16,8,16,0" />

                            <Grid Padding="16,10,16,10"
                                  ColumnDefinitions="28,*,Auto"
                                  ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShareActionTapped"
                                                          CommandParameter="Copy link" />
                                </Grid.GestureRecognizers>
                                <Path Grid.Column="0"
                                      Data="M16 6l-3-3H6C4.9 3 4 3.9 4 5v10c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V6zm-1.5 8.5h-7V13h7v1.5zm0-3h-7V10h7v1.5zm0-3h-7V7h7v1.5zM20 8v10c0 1.1-.9 2-2 2H8v-1.5h10V8h1.5z"
                                      Fill="#008080"
                                      HeightRequest="20"
                                      WidthRequest="20"
                                      Aspect="Uniform" />
                                <Label Grid.Column="1"
                                       Text="Copy link"
                                       TextColor="#E6E6E6"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- More options -->
                            <Grid Padding="16,10,16,10"
                                  ColumnDefinitions="28,*,Auto"
                                  ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShareActionTapped"
                                                          CommandParameter="More" />
                                </Grid.GestureRecognizers>
                                <Path Grid.Column="0"
                                      Data="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                                      Fill="#008080"
                                      HeightRequest="20"
                                      WidthRequest="20"
                                      Aspect="Uniform" />
                                <Label Grid.Column="1"
                                       Text="More options"
                                       TextColor="#E6E6E6"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Separator before existing options -->
                            <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="16,8,16,0" />

                            <!-- Existing options (Disappearing messages, Background image, etc.) -->
                            <!-- Disappearing messages -->
                            <Grid Padding="16,10,16,10"
      ColumnDefinitions="28,*,Auto"
      ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnActionTapped"
                              CommandParameter="Disappearing messages"
                              NumberOfTapsRequired="1" />
                                </Grid.GestureRecognizers>
