<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:conv="clr-namespace:Lock.Converter.Chat"
               x:Class="Lock.Pages.Chat.ChatOptionsPopup"
               Color="Transparent"
               CanBeDismissedByTappingOutsideOfPopup="True">

    <toolkit:Popup.Resources>
        <conv:BoolToColorConverter x:Key="BoolToColorConverter" />
        <conv:BoolToFontAttributeConverter x:Key="BoolToFontAttributeConverter" />
    </toolkit:Popup.Resources>

    <Border BackgroundColor="#1E1E1E"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            Padding="0"
            Margin="20"
            MaximumWidthRequest="420"
            MaximumHeightRequest="620">

        <ScrollView Orientation="Vertical">
            <VerticalStackLayout Spacing="0">

                <!-- Close icon -->
                <Grid ColumnDefinitions="*,Auto"
                      Padding="0,10,10,0">
                    <ContentView Grid.Column="1"
                                 WidthRequest="28"
                                 HeightRequest="28"
                                 HorizontalOptions="End"
                                 VerticalOptions="Start">
                        <Path Data="M19,6.41L17.59,5 12,10.59 6.41,5 5,6.41 10.59,12 5,17.59 6.41,19 12,13.41 17.59,19 19,17.59 13.41,12z"
                              Fill="#E6E6E6"
                              HeightRequest="20"
                              WidthRequest="20"
                              HorizontalOptions="Center"
                              VerticalOptions="Center"
                              Aspect="Uniform">
                            <Path.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseTapped" />
                            </Path.GestureRecognizers>
                        </Path>
                    </ContentView>
                </Grid>

                <!-- Header -->
                <HorizontalStackLayout Padding="16,4,16,8" Spacing="12" VerticalOptions="Center">
                    <Image Source="{Binding ProfileImagePath, FallbackValue='default_profile.png'}"
                           WidthRequest="48"
                           HeightRequest="48"
                           Aspect="AspectFill">
                        <Image.Clip>
                            <EllipseGeometry Center="24,24" RadiusX="24" RadiusY="24" />
                        </Image.Clip>
                    </Image>
                    <Label Text="{Binding ContactName}"
                           FontAttributes="Bold"
                           TextColor="White"
                           FontSize="16"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Red separator -->
                <BoxView HeightRequest="1" BackgroundColor="#C05050" />

                <!-- Tab buttons -->
                <HorizontalStackLayout Padding="16,8,16,6" 
                                       Spacing="12" 
                                       BackgroundColor="#25292D"
                                       HorizontalOptions="Center">

                    <!-- Media Tab Button -->
                    <Border StrokeThickness="1.5"
                            Stroke="{Binding IsMediaTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter='active'}"
                            BackgroundColor="Transparent"
                            Padding="20,8"
                            HeightRequest="36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SwitchToMedia" />
                        </Border.GestureRecognizers>
                        <Label Text="Media"
                               TextColor="{Binding IsMediaTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter='text'}"
                               FontSize="13"
                               FontAttributes="{Binding IsMediaTab, Converter={StaticResource BoolToFontAttributeConverter}}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>

                    <!-- Info Tab Button -->
                    <Border StrokeThickness="1.5"
                            Stroke="{Binding IsInfoTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter='active'}"
                            BackgroundColor="Transparent"
                            Padding="20,8"
                            HeightRequest="36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="SwitchToInfo" />
                        </Border.GestureRecognizers>
                        <Label Text="Info"
                               TextColor="{Binding IsInfoTab, Converter={StaticResource BoolToColorConverter}, ConverterParameter='text'}"
                               FontSize="13"
                               FontAttributes="{Binding IsInfoTab, Converter={StaticResource BoolToFontAttributeConverter}}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>

                <!-- Media Tab -->
                <ContentView IsVisible="{Binding IsMediaTab}">
                    <ScrollView>
                        <Grid Padding="16,8,16,16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Date Filter Dropdown -->
                            <Border Grid.Row="0"
                    BackgroundColor="#2A2A2A"
                    StrokeThickness="0"
                    Padding="12,8"
                    Margin="0,0,0,12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <!-- Calendar icon -->
                                    <Path Grid.Column="0"
                          Data="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 3L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
                          Fill="#AAAAAA"
                          HeightRequest="16"
                          WidthRequest="16"
                          Aspect="Uniform" />

                                    <!-- Selected filter label -->
                                    <Label Grid.Column="1"
                           Text="{Binding SelectedDateFilter}"
                           TextColor="#E6E6E6"
                           FontSize="13"
                           VerticalOptions="Center" />

                                    <!-- Dropdown arrow -->
                                    <Path Grid.Column="2"
                          Data="M7 10l5 5 5-5z"
                          Fill="#AAAAAA"
                          HeightRequest="16"
                          WidthRequest="16"
                          Aspect="Uniform">
                                        <Path.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnDateFilterTapped" />
                                        </Path.GestureRecognizers>
                                    </Path>
                                </Grid>
                            </Border>

                            <!-- CollectionView for media -->
                            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding FilteredMediaItems}"
                            SelectionMode="None"
                            EmptyView="No media found for selected period"
                            VerticalScrollBarVisibility="Never">
                                <CollectionView.ItemsLayout>
                                    <GridItemsLayout Orientation="Vertical"
                                     Span="3"
                                     HorizontalItemSpacing="10"
                                     VerticalItemSpacing="12" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="4">
                                            <Frame CornerRadius="14"
                                   Padding="0"
                                   HasShadow="True"
                                   BorderColor="#333"
                                   BackgroundColor="Transparent"
                                   HeightRequest="110"
                                   WidthRequest="110">
                                                <Image Source="{Binding Path, FallbackValue='placeholder.png'}"
                                       Aspect="AspectFill"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnMediaTapped"
                                                              CommandParameter="{Binding .}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Frame>

                                            <HorizontalStackLayout Spacing="4"
                                                   HorizontalOptions="Center">
                                                <Path Data="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 3L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z"
                                      Fill="#AAAAAA"
                                      HeightRequest="14"
                                      WidthRequest="14"
                                      VerticalOptions="Center"
                                      Aspect="Uniform" />
                                                <Label Text="{Binding SentAt, StringFormat='{0:MMM d, yyyy}'}"
                                       TextColor="#AAAAAA"
                                       FontSize="11"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </Grid>
                    </ScrollView>
                </ContentView>
                <!-- Info Tab -->
                <ContentView IsVisible="{Binding IsInfoTab}">
                    <ScrollView>
                        <VerticalStackLayout Spacing="0">

                            <!-- ===== CHAT OPTIONS SECTION ===== -->
                            <Label Text="Chat options"
                                   FontSize="13"
                                   TextColor="#BBBBBB"
                                   Padding="16,10,16,6" />
                            <!-- View contact -->
                            <Grid Padding="16,10,16,10"
      ColumnDefinitions="28,*,Auto"
      ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnActionTapped"
                              CommandParameter="View contact"
                              NumberOfTapsRequired="1" />
                                </Grid.GestureRecognizers>
                                <Path Grid.Column="0"
          Data="M172-224v-28h616v28H172Zm0-484v-28h616v28H172Zm60 336q-26 0-43-17t-17-43v-96q0-26 17-43t43-17h496q26 0 43 17t17 43v96q0 26-17 43t-43 17H232Zm0-28h496q12 0 22-10t10-22v-96q0-12-10-22t-22-10H232q-12 0-22 10t-10 22v96q0 12 10 22t22 10Zm-32-160v160-160Z"
          Fill="#008080"
          Stroke="#008080"
          StrokeThickness="1.5"
          HeightRequest="20"
          WidthRequest="20"
          HorizontalOptions="Center"
          VerticalOptions="Center"
          Aspect="Uniform" />
                                <Label Grid.Column="1"
           Text="View contact"
           TextColor="#E6E6E6"
           FontSize="14"
           VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="16,0,16,0" />

                            
                            <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="16,0,16,0" />

                            <!-- ===== SHARE POST SECTION (NEW) ===== -->
                            <Label Text="Share options"
                                   FontSize="13"
                                   TextColor="#BBBBBB"
                                   Padding="16,16,16,6" />

                            <!-- Share with app contact -->
                            <Grid Padding="16,10,16,10"
      ColumnDefinitions="28,*,Auto"
      ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShareActionTapped"
                              CommandParameter="Share with app contact" />
                                </Grid.GestureRecognizers>
                                <Path Grid.Column="0"
          Data="M657.35-137q-36.35 0-61.1-24.85Q571.5-202.71 571.5-239q0-10 7.5-32L302.5-424q-12 14-28.94 22t-36.3 8q-35.11 0-59.68-25.27Q153-444.54 153-479.77q0-35.23 24.65-60.73Q202.29-566 237.5-566q19.23 0 36 7.87 16.78 7.86 28.5 21.63l245-152.08q-3.5-7.42-5.5-15.73t-2-17.19q0-35.63 24.9-60.56 24.89-24.94 61-24.94 36.1 0 60.85 25.04T711-721.15q0 35.98-24.96 60.82-24.96 24.83-60.62 24.83-19.69 0-35.8-8.25-16.11-8.25-28.12-22.75L317-513.5q3 8 5.25 16.63 2.25 8.62 2.25 16.95 0 8.32-2 16.58-2 8.27-5 16.28L561.5-294q11.79-14 28.06-22.5t35.86-8.5q35.66 0 60.62 25.25T711-239q0 36.5-24.98 61.25T657.35-137Z"
          Fill="#008080"
          Stroke="#008080"
          StrokeThickness="1.5"
          HeightRequest="20"
          WidthRequest="20"
          HorizontalOptions="Center"
          VerticalOptions="Center"
          Aspect="Uniform" />
                                <Label Grid.Column="1"
           Text="Share with app contact"
           TextColor="#E6E6E6"
           FontSize="14"
           VerticalOptions="Center" />
                            </Grid>
                            <BoxView HeightRequest="1" BackgroundColor="#333333" Margin="16,0,16,0" />

                            <!-- Social Media Section -->
                            <Label Text="Share via social media"
                                   FontSize="13"
                                   TextColor="#BBBBBB"
                                   Padding="16,16,16,6" />

                            <!-- WhatsApp -->
                            <Grid Padding="16,10,16,10"
                                  ColumnDefinitions="28,*,Auto"
                                  ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShareActionTapped"
                                                          CommandParameter="WhatsApp" />
                                </Grid.GestureRecognizers>
                                <Path Grid.Column="0"
                                      Data="M12.04 2.07C6.62 2.07 2.15 6.54 2.15 11.96c0 2.13.6 4.12 1.64 5.83L2.2 21.89l4.3-1.47c1.65.94 3.56 1.49 5.54 1.49 5.42 0 9.89-4.47 9.89-9.89 0-5.42-4.47-9.85-9.89-9.85zM9.86 7.82c.21 0 .44.03.63.03.24 0 .55-.03.8.54.26.57.92 1.99 1.01 2.14.09.15.12.33.03.53-.09.2-.18.27-.33.44-.15.17-.3.3-.44.49-.15.18-.27.33-.12.63.15.3.67 1.1 1.44 1.79.99.88 1.82 1.15 2.08 1.28.26.13.41.11.56-.03.15-.14.66-.76.84-1.03.18-.27.36-.23.6-.14.24.09 1.54.73 1.81.86.27.13.45.2.52.3.09.15.09.87-.21 1.72-.3.85-1.5 1.63-2.06 1.7-.56.07-1.13.13-2.3-.45-1.56-.77-2.58-1.89-3.55-3.43-.75-1.19-1.26-2.33-1.41-2.72-.15-.39-.01-.6.11-.79.11-.17.24-.21.36-.33.12-.12.15-.18.23-.3.08-.12.04-.21-.01-.3-.06-.09-.5-1.2-.68-1.64-.18-.44-.36-.38-.5-.39-.13-.01-.28-.01-.43-.01-.15 0-.39.06-.6.27-.21.21-.81.79-.81 1.93 0 1.14.84 2.24.95 2.4.11.15 1.64 2.45 3.98 3.45 1.42.6 1.98.64 2.7.54.53-.07 1.64-.64 1.87-1.26.23-.62.23-1.15.16-1.26-.07-.11-.26-.15-.56-.26-.3-.11-1.76-.83-2.03-.93-.27-.1-.48-.06-.65.09-.17.15-.66.72-.81.86-.15.15-.3.17-.56.06-.26-.11-1.12-.41-2.13-1.31-.79-.7-1.33-1.57-1.48-1.84-.15-.27-.02-.41.11-.55.11-.12.24-.3.36-.45.12-.15.15-.26.23-.42.08-.17.04-.33-.01-.45-.05-.12-.51-1.22-.7-1.67-.19-.45-.39-.42-.53-.43z"
                                      Fill="#008080"
                                      HeightRequest="20"
                                      WidthRequest="20"
                                      Aspect="Uniform" />
                                <Label Grid.Column="1"
                                       Text="WhatsApp"
                                       TextColor="#E6E6E6"
                                       FontSize="14"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- Telegram -->
                            <Grid Padding="16,10,16,10"
                                  ColumnDefinitions="28,*,Auto"
                                  ColumnSpacing="14">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnShareActionTapped"
                                                          CommandParameter="Telegram" />
                                </Grid.GestureRecognizers>
                                <Path Grid.Column="0"
