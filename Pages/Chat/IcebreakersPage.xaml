<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:Lock.Converter.Chat;assembly=Lock"
             x:Class="Lock.Pages.Chat.IcebreakersPage"
             Title="Icebreakers"
             BackgroundColor="#0D0D0D"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter" />
            <!-- Copy Icon Template -->
            <ControlTemplate x:Key="CopyIconTemplate">
                <Grid>
                    <Path Data="M16,1H4C2.9,1 2,1.9 2,3v14h2V3h12V1z M19,5H8C6.9,5 6,5.9 6,7v12c0,1.1 0.9,2 2,2h11c1.1,0 2-0.9 2-2V7C21,5.9 20.1,5 19,5z M19,19H8V7h11V19z"
                          Fill="#C05050"
                          HeightRequest="16"
                          WidthRequest="16"
                          HorizontalOptions="End"
                          VerticalOptions="Center" />
                </Grid>
            </ControlTemplate>
            <!-- Expand/Collapse Icon Template -->
            <ControlTemplate x:Key="ExpandIconTemplate">
                <Grid>
                    <Path x:Name="ExpandPath"
                          Fill="#C05050"
                          HeightRequest="20"
                          WidthRequest="20"
                          HorizontalOptions="End"
                          VerticalOptions="Center" />
                </Grid>
            </ControlTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>
    <!-- Main Grid -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0" RowSpacing="0">
        <!-- Header -->
        <Border Grid.Row="0"
                BackgroundColor="#1A1A1A"
                StrokeThickness="0"
                Padding="16,16,16,12"
                Margin="0,0,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,20,20" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Back Button -->
                <ContentView Grid.Column="0"
                             WidthRequest="40"
                             HeightRequest="40"
                             HorizontalOptions="Start"
                             VerticalOptions="Center">
                    <Grid>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackTapped" />
                        </Grid.GestureRecognizers>
                        <Path Data="M20,11H7.83l5.59-5.59L12,4l-8,8 8,8 1.41-1.41L7.83,13H20v-2z"
                              Fill="#C05050"
                              HeightRequest="22"
                              WidthRequest="22"
                              HorizontalOptions="Center"
                              VerticalOptions="Center" />
                    </Grid>
                </ContentView>
                <!-- Title -->
                <VerticalStackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     Spacing="2">
                    <Label Text="Conversation Starters"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Choose a vibe that matches your connection"
                           FontSize="11"
                           TextColor="#AAAAAA"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
                <!-- Empty space for balance -->
                <BoxView Grid.Column="2" WidthRequest="40" />
            </Grid>
        </Border>
        <!-- Search Bar -->
        <Border Grid.Row="1"
                BackgroundColor="#1A1A1A"
                StrokeThickness="0"
                Padding="12,10"
                Margin="0,1,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="Auto,*">
                <Path Grid.Column="0"
                      Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57L14,14.79V15.5l5,5l1.5-1.5L15.5,14z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z"
                      Fill="#888888"
                      HeightRequest="18"
                      WidthRequest="18"
                      Margin="0,0,8,0"
                      VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       x:Name="SearchEntry"
                       Placeholder="Search icebreakers..."
                       PlaceholderColor="#666666"
                       BackgroundColor="Transparent"
                       TextColor="White"
                       FontSize="14"
                       HeightRequest="36"
                       ReturnType="Search"
                       TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>
        <!-- Categories and Icebreakers -->
        <ScrollView Grid.Row="2"
                    Margin="0,4,0,0">
            <VerticalStackLayout x:Name="CategoriesLayout"
                                 Spacing="12"
                                 Padding="16,0,16,16">
                <!-- Categories will be added dynamically in code-behind -->
            </VerticalStackLayout>
        </ScrollView>
        <!-- Quick Actions Bar -->
        <Border Grid.Row="3"
                BackgroundColor="#1A1A1A"
                StrokeThickness="0"
                Padding="16,10"
                Margin="0,1,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                <Label Grid.Column="0"
                       Text="Tap any icebreaker to copy"
                       TextColor="#888888"
                       FontSize="12"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Random"
                        BackgroundColor="#2A2A2A"
                        TextColor="White"
                        FontSize="12"
                        CornerRadius="16"
                        Padding="12,6"
                        HeightRequest="32"
                        Clicked="OnRandomIcebreakerClicked" />
                <Button Grid.Column="2"
                        Text="Favorites"
                        BackgroundColor="#2A2A2A"
                        TextColor="White"
                        FontSize="12"
                        CornerRadius="16"
                        Padding="12,6"
                        HeightRequest="32"
                        Clicked="OnFavoritesClicked" />
            </Grid>
        </Border>
        <!-- Success Toast Message (Hidden by default) -->
        <Border x:Name="ToastMessage"
                Grid.Row="2"
                BackgroundColor="#C05050"
                Padding="14,10"
                Margin="20,0,20,60"
                VerticalOptions="End"
                HorizontalOptions="Center"
                IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20" />
            </Border.StrokeShape>
            <Label x:Name="ToastLabel"
                   Text="✓ Copied to clipboard!"
                   TextColor="White"
                   FontSize="13"
                   FontAttributes="Bold" />
        </Border>
    </Grid>
</ContentPage>