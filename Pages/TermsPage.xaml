<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lock.Pages.TermsPage"
             Title="Terms and Conditions"
             BackgroundColor="#0A0A0F"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Resources>
        <Color x:Key="PrimaryColor">#FF3B6F</Color>
        <Color x:Key="PrimaryDark">#E62E5C</Color>
        <Color x:Key="BackgroundDark">#0A0A0F</Color>
        <Color x:Key="SurfaceDark">#1A1A24</Color>
        <Color x:Key="SurfaceLight">#22222E</Color>
        <Color x:Key="TextPrimary">#FFFFFF</Color>
        <Color x:Key="TextSecondary">#A0A0B0</Color>
        <Color x:Key="TextTertiary">#6E6E7E</Color>
        <Color x:Key="SuccessGreen">#008080</Color>
        <Color x:Key="BorderColor">#2C2C38</Color>

        <Style TargetType="Label">
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="FontFamily" Value="-apple-system" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="SubSectionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="BodyTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
            <Setter Property="LineHeight" Value="1.4" />
        </Style>
        <Style x:Key="ListItemStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
            <Setter Property="Margin" Value="8,2,0,2" />
        </Style>
        <Style x:Key="DateStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
            <Setter Property="FontAttributes" Value="Italic" />
        </Style>
        <Style x:Key="CardFrame" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceDark}" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20,16" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="HasShadow" Value="False" />
            <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
            <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Margin" Value="0,8" />
        </Style>
        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
            <Setter Property="BorderColor" Value="{StaticResource BorderColor}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <BoxView Grid.RowSpan="3" BackgroundColor="{StaticResource BackgroundDark}" />

        <!-- Header -->
        <Grid Grid.Row="0"
      BackgroundColor="{StaticResource SurfaceDark}"
      Padding="20,12,20,12"   
            ColumnDefinitions="Auto,*"
      HeightRequest="70">
            <!-- Optional: constrain height -->


            <VerticalStackLayout Grid.Column="1" 
                         HorizontalOptions="Center" 
                         VerticalOptions="Center"
                         Spacing="2">
                <Label Text="Terms of Service"
               FontSize="20"           
                    FontAttributes="Bold"
               HorizontalOptions="Center" />
                    <Label Text="Effective: May 17, 2026"
               Style="{StaticResource DateStyle}"
               HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Scrollable Content -->
        <ScrollView Grid.Row="1" 
            Padding="20,16"
            VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="12">

                <!-- Quick Summary -->
                <Frame Style="{StaticResource CardFrame}"
                       BackgroundColor="{StaticResource PrimaryColor}"
                       Margin="0,0,0,8">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="📋 Quick Summary"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="• Cancel your subscription at any time prior to midnight of the third business day after subscribing (AZ, CA, CO, CT, IL, IA, MN, NY, NC, OH, RI, WI residents)."
                               FontSize="13" TextColor="#FFE0E8" LineHeight="1.3" />
                        <Label Text="• Apple ID subscriptions must be cancelled through Apple, not through Lock. Apple also handles Apple ID refunds."
                               FontSize="13" TextColor="#FFE0E8" LineHeight="1.3" />
                        <Label Text="• Google Play subscriptions must be cancelled through Google Play."
                               FontSize="13" TextColor="#FFE0E8" LineHeight="1.3" />
                        <Label Text="• Lock does NOT conduct criminal background checks. You are solely responsible for your interactions — on and off the app."
                               FontSize="13" TextColor="#FFE0E8" LineHeight="1.3" />
                        <Label Text="NOTE: Brief summaries appear at the top of key sections for ease of reading. They form part of — but do not replace — the full text of each section. Please read each section in its entirety."
                               FontSize="12" TextColor="#FFD0DC" LineHeight="1.3" FontAttributes="Italic" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 1. Introduction -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="1. Introduction" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="By accessing or using Lock, you agree to be bound by this Terms of Service Agreement ('Terms' or 'Agreement'), including our Privacy Policy, Cookie Policy, Community Guidelines, and Safety Tips. Read this Agreement and these policies carefully before you create an account."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="DISPUTE RESOLUTION NOTICE:" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="Please carefully review Section 15 (Dispute Resolution). It governs how disputes between you and Lock will be resolved. Section 15 requires, with limited exceptions, that all disputes shall be resolved by binding individual arbitration. It includes a mandatory informal dispute resolution process, small claims court election, class action and jury trial waivers, and mass arbitration procedures. In arbitration, there is typically less discovery and appellate review than in court."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource PrimaryColor}" />
                        <Label Text="Contracting Entity:" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="Depending on where you live, your agreement is with:&#10;&#10;• European Economic Area, UK, or Switzerland: Lock Technology Services Limited, 10 Match Street, Dublin 2, Ireland&#10;• Japan: Lock Japan Services GK, Tokyo&#10;• All other users: Lock LLC, 123 Dating Lane, Suite 400, Wilmington, DE 19801, USA"
                               Style="{StaticResource ListItemStyle}" />
                        <Label Text="We may update these Terms from time to time. Notice of material changes will be posted with an updated effective date. Continued access or use after the effective date constitutes your consent. If you do not accept a change, stop using Lock immediately."
                               Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0" />
                        <Label Text="Mandatory Features: We reserve the right to introduce mandatory features at any time to enhance functionality, security, or user experience. If you do not wish to engage with a mandatory feature, you may lose access to your account."
                               Style="{StaticResource BodyTextStyle}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 2. Account Eligibility & Responsibilities -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="2. Account Eligibility &amp; Your Responsibilities" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Before creating an account, make sure you are eligible. This section details what you can and cannot do, and the rights you grant Lock."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource TextSecondary}" FontAttributes="Italic" />

                        <Label Text="2a. Eligibility" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="You are not authorized to create an account or use Lock unless all of the following are true:"
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="• You are an individual (not a body corporate, partnership, or other business entity) at least 18 years old&#10;• You are legally qualified to enter a binding contract with Lock&#10;• You are not located in a country subject to a U.S. Government embargo or designated as 'terrorist supporting'&#10;• You are not on any list of prohibited individuals (e.g., U.S. Treasury Specially Designated Nationals list)&#10;• You are not prohibited by law from using our Services&#10;• You have not committed, been convicted of, or pled no contest to any crime involving violence, the threat of violence, or sexual misconduct&#10;• You are not required to register as a sex offender with any state, federal, or local registry&#10;• You do not have any other active accounts on Lock&#10;• You have not previously been removed from Lock or its affiliates' services, unless you have our express written permission to create a new account"
                               Style="{StaticResource ListItemStyle}" />
                        <Label Text="If at any time you cease to meet these requirements, your authorization to access Lock is automatically revoked. You must immediately delete your account, and we retain the right to remove it without warning. We reserve the right to verify your age and identity, including through government-issued ID checks and third-party verification services, at any time."
                               Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0" />

                        <Label Text="2b. Your Responsibilities" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="You agree to:&#10;&#10;1. Comply with these Terms and check for updates regularly&#10;2. Comply with all applicable laws, including privacy, intellectual property, and anti-spam laws&#10;3. Use the latest version of the Lock app&#10;4. Treat other users courteously and respectfully, both on and off the Service&#10;5. Be respectful when communicating with Lock customer care staff&#10;6. Review our Safety Tips&#10;7. Review and comply with our Community Guidelines&#10;8. Take reasonable measures to protect your account login credentials"
                               Style="{StaticResource ListItemStyle}" />

                        <Label Text="2c. Prohibited Conduct" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="You agree that you will NOT:&#10;&#10;1. Misrepresent your identity, age, employment, qualifications, or affiliations&#10;2. Use the Service in a way that damages or prevents its use by other users&#10;3. Interfere with, disrupt, or negatively affect the platform, servers, or networks&#10;4. Use the Service for any harmful, illegal, or nefarious purpose, including money laundering or financial crimes&#10;5. Harass, bully, stalk, intimidate, assault, defame, harm, or mistreat any person&#10;6. Post or share Prohibited Content (see Section 2d)&#10;7. Solicit passwords or personal identifying information from other users for commercial or unlawful purposes&#10;8. Solicit money, gifts, loans, or items of value from another user in any form&#10;9. Use another user's account or share your account with another person&#10;10. Use the Service for fraud, pyramid schemes, or similar practices&#10;11. Use the Service in relation to political campaign financing or to influence any election (other than sharing your own personal political opinions)&#10;12. Violate the terms of the license granted to you by Lock (see Section 6)&#10;13. Disclose private or proprietary information you do not have the right to disclose&#10;14. Copy, modify, transmit, or create derivative works from any Member Content or Our Content without Lock's prior written consent&#10;15. Express or imply that any statements you make are endorsed by Lock&#10;16. Use any bot, crawler, scraper, or automated process to access, retrieve, or data-mine the Service&#10;17. Upload viruses, malware, or other malicious code&#10;18. Forge headers or manipulate identifiers to disguise the origin of any transmitted information&#10;19. Frame or mirror any part of the Service without Lock's prior written authorization&#10;20. Modify, adapt, sublicense, translate, sell, reverse engineer, decompile, or disassemble any portion of the Service&#10;21. Use or develop any third-party applications that interact with Lock or Member Content without our written consent, including AI or machine learning systems&#10;22. Probe, scan, or test the vulnerability of the Service or any of our systems&#10;23. Encourage or promote any activity that violates these Terms&#10;24. Create a new account after we suspend or terminate your account without our express permission&#10;25. Submit false, misleading, or manifestly unfounded reports, or abuse our reporting or appeals systems"
                               Style="{StaticResource ListItemStyle}" />
                        <Label Text="Your authorization to access the Service is automatically revoked if you engage in any of the above."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource PrimaryColor}" Margin="0,8,0,0" />

                        <Label Text="2d. Prohibited Content" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="Lock prohibits uploading or sharing content that:&#10;&#10;1. Could reasonably be deemed offensive, harassing, upsetting, embarrassing, or alarming to any person&#10;2. Is obscene, pornographic, violent, or may otherwise offend human dignity, or contains nudity&#10;3. Is abusive, insulting, threatening, discriminatory, or promotes or encourages racism, sexism, hatred, or bigotry&#10;4. Is illegal or encourages illegal activity, including terrorism, human trafficking, money muling, child abuse and exploitation, or incitement of violence or hatred&#10;5. Encourages or facilitates any activity that may result in harm, including promotion of self-harm, eating disorders, dangerous challenges, violent extremism, or harmful misinformation&#10;6. Is defamatory, libelous, or untrue&#10;7. Relates to commercial activities: sales, competitions, employment or investment opportunities, promotions, advertising, solicitation for services, sex work, 'sugar daddy' or 'sugar baby' arrangements, links to other websites, or premium-rate phone numbers&#10;8. Involves or facilitates the transmission of junk mail or spam&#10;9. Contains spyware, adware, viruses, corrupt files, worm programs, or other malicious code&#10;10. Infringes any third-party rights, including intellectual property or privacy rights&#10;11. Includes the image or likeness of another person without that person's consent (or, for a minor, the minor's parent or guardian)&#10;12. Includes an image of a minor who is unaccompanied, not fully clothed, or that depicts or implies a minor engaged in sexual activity&#10;13. Is inconsistent with the intended use of the Service&#10;14. May harm the reputation of Lock or its affiliates"
                               Style="{StaticResource ListItemStyle}" />
                        <Label Text="Uploading or sharing Prohibited Content may result in the immediate suspension or termination of your account."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource PrimaryColor}" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 3. Content -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="3. Content" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="It is important that you understand your rights and responsibilities with regard to content on the Service. You are expressly prohibited from posting inappropriate content."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource TextSecondary}" FontAttributes="Italic" />
                        <Label Text="While using the Service, you may have access to: (i) content that you upload or provide ('Your Content'); (ii) content that other users upload or provide ('Member Content'); and (iii) content that Lock provides on and through the Service ('Our Content'). 'Content' includes all text, images, video, audio, profile information, direct messages, and any material generated by AI Technology."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="Lock may use or offer AI-powered technology ('AI Technology') as part of the Service. You are solely responsible for any content generated by such AI Technology that you create, upload, or share."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="3a. Your Content" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="You are solely responsible and liable for Your Content and agree to indemnify, defend, release, and hold us harmless from any claims made in connection with Your Content."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="You represent and warrant that the information you provide is accurate and that you will update it to ensure its accuracy. Content on your profile should be relevant to the intended use of the Service."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="You may not display any personal contact, banking, or peer-to-peer payment information on your public profile — including home addresses, phone numbers, email addresses, URLs, credit/debit card details, or peer-to-peer payment usernames. If you choose to share personal information with other users, you do so at your own risk."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="Your profile will be visible to people around the world. You acknowledge that other users may share Your Content with third parties. By uploading Your Content, you represent and warrant that you have all necessary rights and licenses."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="You understand and agree that we may analyze, access, store, and use Your Content — including messages and communications — to monitor, develop, personalize, and improve our Services, including through machine learning and automated technologies, in accordance with applicable law."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="We have the right to remove, delete, edit, limit, or block access to any of Your Content at any time at our sole discretion. We have no obligation to display or review Your Content."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="3b. Member Content" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="Member Content belongs to the user who posted it. Lock expressly disclaims any responsibility for Member Content. You may not copy Member Content or use it for commercial purposes, to spam, to harass, or to make unlawful threats."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="3c. Our Content" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="All text, graphics, user interfaces, trademarks, logos, sounds, artwork, images, and other intellectual property appearing on the Service is owned, controlled, or licensed by Lock and protected by copyright, trademark, and other intellectual property laws. All rights, title, and interest in Our Content remain with us at all times."
                               Style="{StaticResource BodyTextStyle}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 4. Inappropriate Content, Misconduct & Reporting -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="4. Inappropriate Content, Misconduct &amp; Reporting" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Lock does not tolerate inappropriate content or behavior on our Services."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource TextSecondary}" FontAttributes="Italic" />
                        <Label Text="We are committed to maintaining a positive and respectful community. We do not tolerate any inappropriate content or misconduct, whether on or off the Service. You can report a user directly through the 'Report User' link on any user's profile or in the messaging experience."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="We may share data between our affiliates for the safety and security of our users, and may take necessary actions if we believe you have violated these Terms — including banning you from the Service and affiliated services (such as other dating apps operated by our group), and preventing you from creating new accounts."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="We use a combination of automated tools and human reviewers to enforce our content rules, including technology that proactively detects and removes certain types of prohibited material. Violations may result in consequences ranging from a warning to a permanent account ban. Manifestly unfounded reports may result in enforcement actions against the reporter. Repeated submission of manifestly unfounded reports will result in a ban."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="If you believe Your Content was removed in error, you may submit an appeal by emailing appeals@lockapp.com."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="Encrypted Messaging:" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="All private messages on Lock are end-to-end encrypted (E2EE). Lock cannot access, read, or view the content of your private conversations, and cannot provide message content to any third party because we do not possess it. When you report a conversation, recent message content is shared with our trust and safety team — this is the only circumstance in which message content leaves the encrypted channel. Because chats are encrypted, you are entirely responsible for what you send."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="Live / Real-Time Features:" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="Live video, audio, and real-time streaming features are transmitted directly between participants and are not recorded, stored, or viewable by Lock. You are solely responsible for your conduct during any live session."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="Human Trafficking &amp; CSAM — Zero Tolerance:" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="Lock has a zero-tolerance policy for human trafficking, sexual exploitation, and child sexual abuse material (CSAM). We maintain established protocols to report suspected activity to the National Center for Missing and Exploited Children (NCMEC) and law enforcement immediately upon detection, in compliance with 18 U.S.C. § 2258A. There are no exceptions to this policy."
                               Style="{StaticResource BodyTextStyle}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 5. Privacy -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="5. Privacy" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Privacy is important to us. We have a separate Privacy Policy that you agree to read."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource TextSecondary}" FontAttributes="Italic" />
                        <Label Text="For information about how Lock and its affiliates collect, use, and share your personal data, please read our Privacy Policy at lockapp.com/privacy. By using our Services, you agree that we may use your personal data in accordance with our Privacy Policy. Our Privacy Policy covers how we collect and process your personal information, location data, cookies and device identifiers, sharing with third-party service providers, industry-standard security measures, and compliance with GDPR, CCPA, LGPD, POPIA, and other applicable privacy laws."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="Under applicable law, you may request deletion of your personal data at any time through Settings > Privacy > Delete My Data. Under New York law, we will return or destroy your personal information upon contract termination."
                               Style="{StaticResource BodyTextStyle}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 6. Rights Lock Grants You -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="6. Rights Lock Grants You" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="Lock grants you the right to use and enjoy our Services, subject to these Terms."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource TextSecondary}" FontAttributes="Italic" />
                        <Label Text="For as long as you comply with these Terms, Lock grants you a personal, worldwide, royalty-free, non-assignable, non-exclusive, revocable, and non-sublicensable license to access and use our Services for purposes as intended by Lock and permitted by these Terms and applicable laws. This license is automatically revoked if you fail to comply with these Terms."
                               Style="{StaticResource BodyTextStyle}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 7. Rights You Grant Lock -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="7. Rights You Grant Lock" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="You own all of the content you provide to Lock, but you also grant us the right to use Your Content as provided in this Agreement."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource TextSecondary}" FontAttributes="Italic" />
                        <Label Text="By creating an account, you grant to Lock a worldwide, perpetual, transferable, sub-licensable, royalty-free right and license to host, store, use, copy, display, reproduce, adapt, edit, publish, translate, modify, reformat, incorporate into other works, advertise, distribute, and otherwise make available to the general public Your Content, in whole or in part, in any way and in any format or medium currently known or developed in the future."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="You further grant to Lock a worldwide, perpetual, transferable, sub-licensable, royalty-free license to: (a) collect and use Your Content to perform its obligations under this Agreement; and (b) train, develop, adapt, modify, enhance, or improve the Services and other products or services, including through the use of AI Technology. You acknowledge that Lock's Services may 'learn' and improve based on information received and generated (including Your Content) and cannot thereafter 'unlearn'."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="You agree that Lock may access, preserve, and disclose your account information, including Your Content, if required to do so by law or upon a good faith belief that such access is reasonably necessary to: (i) comply with legal process; (ii) enforce these Terms; (iii) respond to claims that any content violates third-party rights; (iv) respond to your requests for customer service; (v) protect the rights, property, or personal safety of Lock or any other person; (vi) investigate, prevent, or take other action regarding illegal activity or suspected fraud; or (vii) comply with the data rights requests of other users."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="By submitting suggestions or feedback to Lock, you agree that Lock may use and share such feedback for any purpose without compensating you, and you waive all rights in or to such suggestions or feedback."
                               Style="{StaticResource BodyTextStyle}" />
                    </VerticalStackLayout>
                </Frame>

                <!-- 8. Purchases, Subscriptions & Refunds -->
                <Frame Style="{StaticResource CardFrame}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="8. Purchases, Subscriptions &amp; Refunds" Style="{StaticResource SectionTitleStyle}" />
                        <Label Text="If you purchase a subscription, it will automatically renew — and you will be charged — until you cancel."
                               Style="{StaticResource BodyTextStyle}" TextColor="{StaticResource TextSecondary}" FontAttributes="Italic" />

                        <Label Text="8a. External Service Purchases (Apple / Google Play):" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="When you make a purchase through Apple ID or Google Play ('External Service'), your External Service Account will be charged at the time of purchase in accordance with the terms disclosed to you at that time. If your purchase includes an automatically renewing subscription, your External Service Account will continue to be periodically charged until you cancel."
                               Style="{StaticResource BodyTextStyle}" />
                        <Label Text="To cancel an Apple ID subscription: go to Settings > [Your Name] > Subscriptions on your iOS device, or visit Apple Support at https://getsupport.apple.com.&#10;To cancel a Google Play subscription: open the Google Play app on your device, go to Settings > Subscriptions."
                               Style="{StaticResource ListItemStyle}" />
                        <Label Text="If you initiate a chargeback or payment reversal on an External Service purchase, Lock may terminate your account immediately. If the chargeback is overturned, please contact support@lockapp.com. Lock will retain all funds charged to your External Service Account until you cancel your subscription through your External Service Account."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="8b. Internal Purchases:" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="If you make a purchase directly within the Lock app ('Internal Purchase'), you agree to pay the displayed prices and any applicable taxes. You authorize Lock to charge your payment method. If your Internal Purchase includes an automatically renewing subscription, your payment method will continue to be periodically charged until you cancel. To cancel, log in to the Lock app and go to Account > Settings. If a payment is not successfully processed, you remain responsible for any uncollected amounts."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="8c. Virtual Items:" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="From time to time, you may purchase a limited, personal, non-transferable, revocable license to access special features including Boosts, Super Likes, Live Credits, or Gifts ('Virtual Items'). ALL PURCHASES AND REDEMPTIONS OF VIRTUAL ITEMS ARE FINAL AND NON-REFUNDABLE. The license granted in Virtual Items will terminate when your account is closed or terminated. Virtual Items may only be redeemed through our Services and may not be sold or transferred."
                               Style="{StaticResource BodyTextStyle}" />

                        <Label Text="8d. Refunds:" Style="{StaticResource SubSectionStyle}" />
                        <Label Text="Generally, all purchases are nonrefundable. However, special terms apply in the following jurisdictions:&#10;&#10;• EU, EEA, UK &amp; Switzerland: Full refund available within 14 days after the subscription begins.&#10;• Germany: You may terminate your subscription after renewal with one month's notice.&#10;• Republic of Korea: Full refund available within 7 days of purchase.&#10;• Arizona, California, Colorado, Connecticut, Illinois, Iowa, Minnesota, New York, North Carolina, Ohio, Rhode Island, and Wisconsin: You may cancel your subscription, without penalty or obligation, at any time prior to midnight of the third business day following the date you subscribed.&#10;• Death during subscription: Your estate shall be entitled to a refund for the period after your death.&#10;• Disability during subscription: If you become disabled before the end of your subscription period, you are entitled to a refund for the remaining period."
