<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- UPDATE: Changed from #512BD4 to your app's red accent color -->
    <Color x:Key="Primary">#C05050</Color>
    <Color x:Key="PrimaryDark">#A04040</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>

    <!-- UPDATE: Changed Secondary to match your dark theme -->
    <Color x:Key="Secondary">#2A2A2A</Color>
    <Color x:Key="SecondaryDarkText">#C05050</Color>
    <Color x:Key="Tertiary">#1F1F1F</Color>

    <Color x:Key="DarkBackground">#121212</Color>
    <Color x:Key="LightOnDarkBackground">#F5F2E9</Color>
    <Color x:Key="LightBackground">#FAFAF8</Color>
    <Color x:Key="DarkOnLightBackground">#1A1A1A</Color>

    <Color x:Key="LightSecondaryBackground">#E8E4DE</Color>
    <Color x:Key="DarkSecondaryBackground">#1E1C1A</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Add these for consistent app styling -->
    <Color x:Key="AppBackground">#121212</Color>
    <Color x:Key="CardBackground">#1F1F21</Color>
    <Color x:Key="Accent">#C05050</Color>
    <Color x:Key="Muted">#888888</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- Add these brushes for app styling -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackground}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>

    <!-- Default page style to remove any blue background -->
    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor" Value="{StaticResource AppBackground}" />
    </Style>

    <!-- Default shell style to match your theme -->
    <Style TargetType="Shell">
        <Setter Property="Shell.BackgroundColor" Value="{StaticResource AppBackground}" />
        <Setter Property="Shell.TitleColor" Value="{StaticResource LightOnDarkBackground}" />
        <Setter Property="Shell.DisabledColor" Value="{StaticResource Gray500}" />
        <Setter Property="Shell.UnselectedColor" Value="{StaticResource Gray400}" />
        <Setter Property="Shell.ForegroundColor" Value="{StaticResource LightOnDarkBackground}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource AppBackground}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Accent}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray500}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource LightOnDarkBackground}" />
    </Style>
</ResourceDictionary>