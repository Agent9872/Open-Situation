<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>Lock</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>$(NoWarn);XC0103;NU1605</NoWarn>
		<WarningsNotAsErrors>$(WarningsNotAsErrors);NU1605</WarningsNotAsErrors>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

		<!-- Display name -->
		<ApplicationTitle>Lock</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.lock</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>MSIX</WindowsPackageType>
		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<!-- Disable AOT to fix the compilation errors -->
		<AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
		<RunAOTCompilation>false</RunAOTCompilation>

		<!-- Also disable LLVM which can cause similar issues -->
		<EnableLLVM>false</EnableLLVM>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- ANDROID-SPECIFIC BUILD PROPERTIES -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<AndroidEnableMultiDex>true</AndroidEnableMultiDex>
		<AndroidDexTool>d8</AndroidDexTool>
		<AndroidLinkTool>r8</AndroidLinkTool>
		<AndroidEnableDesugar>true</AndroidEnableDesugar>
		<AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
		<AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
		<!-- Force consistent versions -->
		<AndroidUseIntermediateDesignerFile>true</AndroidUseIntermediateDesignerFile>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#17171a" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#17171a" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*.png" />
		<MauiImage Include="Resources\Images\*.jpg" />
		<MauiImage Include="Resources\Images\*.jpeg" />
		<MauiImage Include="Resources\Images\*.gif" />
		<MauiImage Include="Resources\Images\*.svg" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
	  <AndroidResource Remove="Platforms\Android\Resources\Drawable\launch_background.xml" />
	  <AndroidResource Remove="Platforms\Android\Resources\values\styles.xml" />
	</ItemGroup>

	<!-- CORE PACKAGES -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="4.0.0" />
		<PackageReference Include="CommunityToolkit.Maui" Version="11.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="FFImageLoading.Maui" Version="1.3.2" />
		<PackageReference Include="HtmlAgilityPack" Version="1.12.4" />

		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.14" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.IdentityModel.Tokens" Version="8.0.1" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.9" />

		<PackageReference Include="NAudio" Version="2.3.0" />

		<PackageReference Include="Plugin.Fingerprint" Version="2.1.5" />
		<PackageReference Include="Plugin.LocalNotification" Version="11.1.4" />
		<PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
		<PackageReference Include="Plugin.Maui.OCR" Version="1.1.1" />

		<!-- SQLite -->
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_green" Version="2.1.8" />
		<PackageReference Include="SQLitePCLRaw.core" Version="2.1.8" />

		<PackageReference Include="Syncfusion.Maui.Toolkit" Version="1.0.6" />
	</ItemGroup>

	<!-- ANDROID-SPECIFIC PACKAGES - ALL VERSIONS ALIGNED -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-android'">
		<!-- Core AndroidX - Use exact versions -->
		<PackageReference Include="Xamarin.AndroidX.Core" Version="1.12.0.8" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.6.1.13" />
		<PackageReference Include="Xamarin.AndroidX.DocumentFile" Version="1.0.1.18" />
		
		<!-- ML Kit Document Scanner -->
		<PackageReference Include="Xamarin.GooglePlayServices.MLKit.DocumentScanner" Version="116.0.0.2" />
		
		<!-- Lifecycle - Version 2.6.1.2 works consistently -->
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.6.1.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.6.1.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.6.1.2" />
		<PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.6.1.2" />
		
		<!-- SavedState - Use the same version for both to avoid duplicates -->
		<PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.2.1.10" />
		
		<!-- DO NOT include SavedState.Ktx separately as it causes duplicates -->
		<!-- <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.2.1.10" /> -->
		
		<!-- Other AndroidX packages -->
		<PackageReference Include="Xamarin.AndroidX.Activity" Version="1.7.0.4" />
		<PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.6.1.2" />
		<PackageReference Include="Xamarin.AndroidX.CursorAdapter" Version="1.0.0.18" />
		
		<!-- Concurrent Futures -->
		<PackageReference Include="Xamarin.AndroidX.Concurrent.Futures" Version="1.1.0.17" />
	</ItemGroup>

	<!-- IOS-SPECIFIC PACKAGES -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-ios'">
		<!-- Add iOS-specific packages here if needed -->
	</ItemGroup>

	<!-- MACCATALYST-SPECIFIC PACKAGES -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0-maccatalyst'">
		<None Include="libSQLitePCLRaw.dylib">
			<Link>libSQLitePCLRaw.dylib</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<!-- CODE-BEHIND FILES -->
	<ItemGroup>
